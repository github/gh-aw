---
/**
 * Site header (overrides Starlight's Header). One layout for landing and docs:
 * [logo] Docs  Workflow examples  Blog ............ [Search ⌘K] (GitHub) (theme) [Get started]
 * Search, SiteTitle and ThemeSelect come from Starlight's virtual modules so
 * their overrides and the Pagefind dialog keep working.
 */
import octicons from '@primer/octicons';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL;
const { id } = Astro.locals.starlightRoute;
const section =
	id === '' ? 'home'
	: id === 'blog' || id.startsWith('blog/') ? 'blog'
	: id === 'gallery' || id.startsWith('gallery/') ? 'gallery'
	: 'docs';

const links = [
	{ href: `${base}introduction/overview/`, label: 'Docs', section: 'docs' },
	{ href: `${base}gallery/`, label: 'Workflow examples', section: 'gallery' },
	{ href: `${base}blog/`, label: 'Blog', section: 'blog' },
];

const githubIcon = octicons['mark-github'].toSVG({ width: 18, height: 18, 'aria-hidden': 'true' });
---

<div class="site-header">
	<div class="site-header-start">
		<SiteTitle />
		<nav class="site-header-nav" aria-label="Main">
			{
				links.map((link) => (
					<a href={link.href} aria-current={link.section === section ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="site-header-end print:hidden">
		<Search />
		<a class="site-header-icon" href="https://github.com/github/gh-aw" aria-label="GitHub repository">
			<Fragment set:html={githubIcon} />
		</a>
		<ThemeSelect />
		<a class="site-header-cta" href={`${base}setup/quick-start/`}>Get started</a>
	</div>
</div>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
	}

	.site-header-start,
	.site-header-end {
		display: flex;
		align-items: center;
		min-width: 0;
	}

	.site-header-start {
		gap: 2rem;
	}

	.site-header-end {
		gap: 0.25rem;
		flex-shrink: 0;
	}

	/* Logo: keep the wordmark from wrapping */
	.site-header-start :global(.site-title) {
		flex-shrink: 0;
		white-space: nowrap;
	}

	.site-header-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.site-header-nav a {
		padding: 0.375rem 0.625rem;
		border-radius: 0.375rem;
		font-size: var(--aw-step--1);
		font-weight: 500;
		color: var(--aw-color-text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	.site-header-nav a:hover,
	.site-header-nav a[aria-current='page'] {
		color: var(--aw-color-text-strong);
	}

	/* Search: restyle Starlight's trigger as a quiet pill */
	.site-header-end :global(button[data-open-modal]) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 14rem;
		max-width: none;
		height: 2.25rem;
		margin-inline-end: 0.5rem;
		padding-inline: 0.75rem 0.375rem;
		border: 1px solid var(--aw-color-border-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--aw-color-text-muted);
		font-size: var(--aw-step--1);
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.site-header-end :global(button[data-open-modal]:hover) {
		border-color: var(--aw-color-text-muted);
		color: var(--aw-color-text);
	}

	.site-header-end :global(button[data-open-modal] svg) {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
	}

	.site-header-end :global(button[data-open-modal] > span) {
		display: block;
	}

	.site-header-end :global(button[data-open-modal] > kbd) {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin-inline-start: auto;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		background: var(--aw-color-bg-subtle);
		color: var(--aw-color-text-muted);
		font-size: var(--aw-step--1);
		line-height: 1.4;
	}

	.site-header-end :global(button[data-open-modal] > kbd kbd) {
		padding: 0;
		background: none;
		font-size: inherit;
	}

	.site-header-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.375rem;
		color: var(--aw-color-text-muted);
		transition: color 0.15s ease;
	}

	.site-header-icon:hover {
		color: var(--aw-color-text-strong);
	}

	.site-header-icon :global(svg) {
		fill: currentColor;
	}

	.site-header-cta {
		display: inline-flex;
		align-items: center;
		height: 2.25rem;
		margin-inline-start: 0.5rem;
		padding-inline: 1rem;
		border-radius: 999px;
		background: var(--aw-color-button-bg);
		color: var(--aw-color-button-text);
		font-size: var(--aw-step--1);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.15s ease;
	}

	.site-header-cta:hover {
		background: var(--aw-color-button-bg-hover);
		color: var(--aw-color-button-text);
	}

	.site-header a:focus-visible,
	.site-header-end :global(button[data-open-modal]:focus-visible) {
		outline: 2px solid var(--aw-color-accent);
		outline-offset: 2px;
	}

	/* Tablet: drop the wordmark, collapse search to an icon button */
	@media (max-width: 63.99rem) {
		.site-header-start {
			gap: 1rem;
		}

		.site-header-start :global(.site-title span) {
			display: none;
		}

		.site-header-end :global(button[data-open-modal]) {
			justify-content: center;
			width: 2.25rem;
			padding: 0;
			margin-inline-end: 0;
			border-color: transparent;
			border-radius: 0.375rem;
		}

		.site-header-end :global(button[data-open-modal] > span),
		.site-header-end :global(button[data-open-modal] > kbd) {
			display: none;
		}
	}

	/* Mobile: logo, search, GitHub, theme. Full mobile menu comes later. */
	@media (max-width: 47.99rem) {
		.site-header-nav,
		.site-header-cta {
			display: none;
		}

		.site-header-end {
			gap: 0;
		}

		.site-header-end :global(button[data-open-modal]),
		.site-header-icon {
			width: 44px;
			height: 44px;
			margin: 0;
		}
	}
</style>
