---
/**
 * Footer override. Docs and blog pages keep Starlight's own footer in the
 * content column (edit link, last updated, prev/next). The site-wide footer
 * is rendered outside the page content by PageFrame.astro (SiteFooter.astro).
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const isLanding = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

{!isLanding && <Default {...Astro.props} />}
