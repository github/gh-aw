---
import Octicon from '../Octicon.astro';
import LandingSection from './LandingSection.astro';
import LandingPoints from './LandingPoints.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const points = [
  {
    title: 'Your own runners',
    text: 'Run on Linux self-hosted runners, including Actions Runner Controller with Docker-in-Docker.',
    href: `${base}/reference/self-hosted-runners/`,
    label: 'Self-hosted runners',
  },
  {
    title: 'Every repository',
    text: 'Roll workflows out across an organization or enterprise and manage them centrally.',
    href: `${base}/guides/using-at-scale/`,
    label: 'Using at scale',
  },
];

// The first nine repos are the ones shown on narrow screens (3 × 3).
const names = [
  'api', 'web', 'docs', 'infra', 'mobile', 'billing', 'auth', 'search', 'cli',
  'payments', 'analytics', 'sdk-js', 'ios', 'android', 'platform', 'support',
];
const running = new Set(['search', 'android']);
const COLS = 4;
// Ripple outwards diagonally from the top-left, as the run fans out.
const repos = names.map((name, i) => ({
  name,
  state: running.has(name) ? 'running' : 'success',
  delay: (Math.floor(i / COLS) + (i % COLS)) * 240,
  extra: i >= 9,
}));
const runners = ['arc-linux-01', 'arc-linux-02', 'arc-linux-03'];

// Fan-out connectors from the workflow chip to the top edge of the org panel.
const fan = [8, 29, 50, 71, 92];
---

<LandingSection id="organizations" title="Ready for organizations" lede="Run on your own infrastructure, across every repository.">
  <div class="aw-org">
    <div
      class="aw-fan"
      role="img"
      aria-label="One workflow file, triage.md, rolls out to sixteen repositories in the acme organization and runs on three self-hosted runners."
      data-fan
    >
      <div class="aw-source aw-card" aria-hidden="true">
        <Octicon name="file" class="aw-muted-ico" />.github/workflows/triage.md
      </div>

      <svg class="aw-wires" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
        {fan.map((x) => (
          <path d={`M50 0 C50 22 ${x} 18 ${x} 40`} vector-effect="non-scaling-stroke" />
        ))}
      </svg>

      <div class="aw-orgbox" aria-hidden="true">
        <div class="aw-orghead">
          <Octicon name="organization" class="aw-muted-ico" />
          <span class="aw-mono">org/acme</span>
          <span class="aw-count">{repos.length} repositories</span>
        </div>

        <ul class="aw-repos">
          {repos.map((r) => (
            <li class:list={['aw-repo', `is-${r.state}`, r.extra && 'is-extra']} style={`--d: ${r.delay}ms`}>
              <Octicon name="repo" class="aw-muted-ico aw-repo-ico" />
              <span class="aw-repo-name">{r.name}</span>
              <span class="aw-status">
                <span class="st st-pending" />
                <span class="st st-running" />
                <Octicon name="check-circle-fill" size={14} class="st st-success" />
              </span>
            </li>
          ))}
        </ul>

        <div class="aw-runners">
          <span class="aw-runners-label">Self-hosted runners</span>
          <ul>
            {runners.map((r) => (
              <li><Octicon name="server" class="aw-muted-ico" /><span class="aw-mono">{r}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <LandingPoints points={points} layout="stack" />
  </div>
</LandingSection>

<script>
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  if (fan && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    fan.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          fan.classList.add('is-playing');
          io.disconnect();
        }
      },
      { threshold: 0.45 },
    );
    io.observe(fan);
  }
</script>

<style>
  .aw-org {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 60rem) {
    .aw-org {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      column-gap: 4.5rem;
      align-items: center;
    }
  }

  .aw-muted-ico {
    color: var(--aw-color-text-muted);
  }
  .aw-mono {
    font-family: var(--aw-font-mono);
  }

  /* ---------- Diagram ---------- */
  .aw-fan {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .aw-source {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    padding: 0.5rem 0.875rem;
    border-radius: 10px;
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text);
    white-space: nowrap;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .aw-wires {
    display: block;
    width: 100%;
    height: 3.5rem;
    overflow: visible;
  }
  .aw-wires path {
    fill: none;
    stroke: var(--aw-color-accent);
    stroke-opacity: 0.6;
    stroke-width: 1;
  }

  .aw-orgbox {
    width: 100%;
    border: 1px solid var(--aw-color-border-strong);
    border-radius: 14px;
    background: var(--aw-color-bg);
  }
  .aw-orghead {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: var(--aw-step--1);
    color: var(--aw-color-text-secondary);
  }
  .aw-count {
    margin-left: auto;
    color: var(--aw-color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .aw-repos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0 1rem 1rem;
    list-style: none;
  }
  @media (min-width: 30rem) {
    .aw-repos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 29.99rem) {
    .aw-repo.is-extra,
    .aw-repo-ico {
      display: none;
    }
  }
  .aw-repo {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    margin: 0;
    padding: 0.4375rem 0.5rem 0.4375rem 0.625rem;
    background: var(--aw-color-surface);
    border: 1px solid var(--aw-color-border);
    border-radius: var(--aw-radius-md);
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text);
    transition: border-color 400ms ease;
  }
  .aw-repo-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .aw-repo.is-running {
    border-color: color-mix(in oklab, var(--aw-color-accent) 40%, var(--aw-color-border));
  }

  /* Status slot: pending ring, running spinner, success tick, stacked in one cell. */
  .aw-status {
    display: grid;
    place-items: center;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .st {
    grid-area: 1 / 1;
    display: inline-flex;
    opacity: 0;
  }
  .st-pending,
  .st-running {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .st-pending {
    border: 1.5px solid var(--aw-color-border-strong);
  }
  .st-running {
    border: 1.5px solid var(--aw-color-accent);
    border-top-color: transparent;
  }
  .st-success {
    color: var(--aw-color-success);
  }

  /* Resting state (no JS, reduced motion, or after the ripple). */
  .is-success .st-success,
  .is-running .st-running {
    opacity: 1;
  }

  /* Armed: everything waits as pending until the section scrolls into view. */
  .aw-fan:global(.is-armed) .st {
    opacity: 0;
  }
  .aw-fan:global(.is-armed) .st-pending {
    opacity: 1;
  }
  .aw-fan:global(.is-armed) .aw-repo.is-running {
    border-color: var(--aw-color-border);
  }
  .aw-fan:global(.is-armed) .aw-wires {
    opacity: 0.35;
    transition: opacity 600ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-running .st-running {
      animation: aw-spin 1.1s linear infinite;
    }

    .aw-fan:global(.is-playing) .aw-wires {
      opacity: 1;
    }
    .aw-fan:global(.is-playing) .st-pending {
      animation: aw-out 160ms ease var(--d) both;
    }
    .aw-fan:global(.is-playing) .is-success .st-running {
      animation:
        aw-blip 760ms ease calc(var(--d) + 80ms) both,
        aw-spin 1.1s linear infinite;
    }
    .aw-fan:global(.is-playing) .is-running .st-running {
      animation:
        aw-in 200ms ease calc(var(--d) + 80ms) both,
        aw-spin 1.1s linear infinite;
    }
    .aw-fan:global(.is-playing) .is-success .st-success {
      animation: aw-pop 320ms cubic-bezier(0.2, 0.9, 0.3, 1.2) calc(var(--d) + 760ms) both;
    }
    .aw-fan:global(.is-playing) .aw-repo.is-running {
      border-color: color-mix(in oklab, var(--aw-color-accent) 40%, var(--aw-color-border));
      transition-delay: var(--d);
    }
  }

  @keyframes aw-spin {
    to { rotate: 1turn; }
  }
  @keyframes aw-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes aw-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes aw-blip {
    0% { opacity: 0; }
    15%, 85% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes aw-pop {
    from { opacity: 0; scale: 0.5; }
    to { opacity: 1; scale: 1; }
  }

  /* Runners footer */
  .aw-runners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border-top: 1px dashed var(--aw-color-border-strong);
    font-size: var(--aw-step--1);
  }
  .aw-runners-label {
    color: var(--aw-color-text-muted);
  }
  .aw-runners ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aw-runners li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--aw-color-border);
    border-radius: var(--aw-radius-sm);
    background: var(--aw-color-bg-subtle);
    color: var(--aw-color-text-secondary);
  }
</style>
