---
import LandingSection from './LandingSection.astro';

const points = [
  {
    title: 'Your own runners',
    text: 'Run on Linux self-hosted runners, including Actions Runner Controller with Docker-in-Docker.',
    href: '/gh-aw/reference/self-hosted-runners/',
    label: 'Self-hosted runners',
  },
  {
    title: 'Every repository',
    text: 'Roll workflows out across an organization or enterprise and manage them centrally.',
    href: '/gh-aw/guides/using-at-scale/',
    label: 'Using at scale',
  },
];
---

<LandingSection id="organizations" title="Ready for organizations" lede="Run on your own infrastructure, across every repository.">
  <ul class="aw-org">
    {points.map((p) => (
      <li>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
        <a href={p.href}>{p.label}<span aria-hidden="true"> →</span></a>
      </li>
    ))}
  </ul>
</LandingSection>

<style>
  .aw-org {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .aw-org li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--aw-color-border);
  }
  @media (min-width: 48rem) {
    .aw-org {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 4rem;
    }
  }
  h3 {
    margin: 0;
    font-size: var(--aw-step-1);
    font-weight: 520;
    letter-spacing: -0.015em;
    color: var(--aw-color-text);
    border: 0;
  }
  p {
    margin: 0.375rem 0 0.5rem;
    max-width: 44ch;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  a {
    font-size: var(--aw-step--1);
    color: var(--aw-color-accent-text);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
