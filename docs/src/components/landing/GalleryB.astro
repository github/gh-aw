---
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';
import { workflows } from './GalleryData';

const icon = (n: keyof typeof octicons, size = 16) => octicons[n].toSVG({ width: size, height: size });
const ids = ['triage', 'review', 'ci', 'docs', 'report', 'security'];
const featured = ids.map((id) => workflows.find((w) => w.id === id)!);
const rest = workflows.filter((w) => !ids.includes(w.id));
const crumbs: Record<string, string> = {
  triage: 'acme/app · Issues',
  review: 'acme/app · Pull requests',
  ci: 'acme/app · Issues',
  docs: 'acme/app · Pull requests',
  report: 'acme/app · Issues',
  security: 'acme/app · Security',
};
---

<LandingSection titleId="gallery-b-title" title="What teams automate" lede="Start from a proven workflow and adapt it to your repository.">
  <div class="gb" data-gb>
    <div class="gb-tabs" role="tablist" aria-label="Featured workflows" aria-orientation="vertical">
      {featured.map((f, i) => (
        <button type="button" role="tab" class="gb-tab" id={`gb-tab-${f.id}`} aria-controls={`gb-panel-${f.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="gb-tab-t">{f.title}</span>
          <span class="gb-tab-d">{f.text}</span>
        </button>
      ))}
    </div>

    <div class="gb-panels">
      {featured.map((f, i) => (
        <div class="gb-panel" role="tabpanel" id={`gb-panel-${f.id}`} aria-labelledby={`gb-tab-${f.id}`} tabindex="0" hidden={i !== 0 ? true : undefined} data-first={i === 0 ? '' : undefined}>
          <div class="gb-win" aria-hidden="true">
            <div class="gb-bar"><span class="gb-bar-t">{crumbs[f.id]}</span><span class="gb-bar-m">github-actions</span></div>

            {f.id === 'triage' && (
              <div class="gb-body">
                <div class="gb-h"><span class="gb-ico gb-ok" set:html={icon('issue-opened', 20)} /><span class="gb-h-t">Crash when saving an empty file <span class="gb-num">#482</span></span></div>
                <p class="gb-p">Saving a new, empty buffer throws <code>TypeError: Cannot read properties of undefined</code>. Happens on 2.3.0 only.</p>
                <div class="gb-chips"><span class="gb-chip">bug</span><span class="gb-chip">area: editor</span><span class="gb-chip gb-chip-new">needs repro</span></div>
                <div class="gb-note">
                  <div class="gb-note-h"><span class="gb-ico" set:html={icon('comment-discussion', 14)} /><b>github-actions</b> commented</div>
                  <p>Thanks for the report. This looks related to <b>#431</b>. Could you share the steps and your OS version so we can reproduce it?</p>
                </div>
              </div>
            )}

            {f.id === 'review' && (
              <div class="gb-body">
                <div class="gb-h"><span class="gb-ico gb-pr" set:html={icon('git-pull-request', 20)} /><span class="gb-h-t">Batch saves for large workspaces <span class="gb-num">#305</span></span></div>
                <div class="gb-code">
                  <div class="gb-ln"><span>40</span><span>  const items = await collect(root);</span></div>
                  <div class="gb-ln gb-del"><span>41</span><span>- for (const i of items) await save(i);</span></div>
                  <div class="gb-ln gb-add"><span>42</span><span>+ items.forEach(save);</span></div>
                  <div class="gb-ln"><span>43</span><span>  return items.length;</span></div>
                </div>
                <div class="gb-note">
                  <div class="gb-note-h"><span class="gb-ico" set:html={icon('comment-discussion', 14)} /><b>github-actions</b> reviewed</div>
                  <p><code>save</code> returns a promise, so rejections are dropped and the function returns before writes finish. Use <code>Promise.all</code>.</p>
                </div>
              </div>
            )}

            {f.id === 'ci' && (
              <div class="gb-body">
                <ul class="gb-list" role="list">
                  <li><span class="gb-ico gb-bad" set:html={icon('x-circle', 16)} /><span class="gb-li-t">build / test (ubuntu)</span><span class="gb-mut">failed 2m ago</span></li>
                  <li><span class="gb-ico gb-ok" set:html={icon('check-circle', 16)} /><span class="gb-li-t">build / lint</span><span class="gb-mut">passed</span></li>
                </ul>
                <div class="gb-h"><span class="gb-ico gb-ok" set:html={icon('issue-opened', 20)} /><span class="gb-h-t">CI failure: flaky timeout in db setup <span class="gb-num">#496</span></span></div>
                <p class="gb-p"><b>Likely cause:</b> <code>setupDb()</code> waits 5s for the container, but the runner took 8s. Same failure on 3 of the last 20 runs.</p>
                <div class="gb-chips"><span class="gb-chip">ci</span><span class="gb-chip">flaky</span></div>
              </div>
            )}

            {f.id === 'docs' && (
              <div class="gb-body">
                <div class="gb-h"><span class="gb-ico gb-pr" set:html={icon('git-pull-request', 20)} /><span class="gb-h-t">docs: sync CLI flags with --help <span class="gb-num">#214</span></span></div>
                <div class="gb-meta"><span class="gb-plus">+18</span><span class="gb-minus">−6</span><span class="gb-chip">documentation</span></div>
                <ul class="gb-list" role="list">
                  <li><span class="gb-ico" set:html={icon('file', 16)} /><span class="gb-li-t">docs/cli/run.md</span><span class="gb-plus">+12</span><span class="gb-minus">−4</span></li>
                  <li><span class="gb-ico" set:html={icon('file', 16)} /><span class="gb-li-t">docs/cli/compile.md</span><span class="gb-plus">+6</span><span class="gb-minus">−2</span></li>
                </ul>
                <p class="gb-p">The <code>--engine</code> and <code>--watch</code> flags changed in <b>#198</b> but were missing from the reference.</p>
              </div>
            )}

            {f.id === 'report' && (
              <div class="gb-body">
                <div class="gb-h"><span class="gb-ico gb-ok" set:html={icon('issue-opened', 20)} /><span class="gb-h-t">Release notes: v2.3.1 <span class="gb-num">#501</span></span></div>
                <div class="gb-meta"><span class="gb-ico" set:html={icon('tag', 14)} /><span class="gb-mut">14 merged pull requests · 3 fixes</span></div>
                <ul class="gb-list" role="list">
                  <li><span class="gb-li-t">Fixes</span><span class="gb-mut">Empty-file save crash, flaky db setup</span></li>
                  <li><span class="gb-li-t">Features</span><span class="gb-mut">Batch saves, new <code>--watch</code> flag</span></li>
                  <li><span class="gb-li-t">Docs</span><span class="gb-mut">CLI reference refreshed</span></li>
                </ul>
              </div>
            )}

            {f.id === 'security' && (
              <div class="gb-body">
                <div class="gb-h"><span class="gb-ico gb-bad" set:html={icon('shield', 20)} /><span class="gb-h-t">Unpinned action in release.yml</span></div>
                <div class="gb-meta"><span class="gb-chip gb-chip-danger">High</span><span class="gb-mut">Code scanning · Open</span></div>
                <div class="gb-code">
                  <div class="gb-ln"><span>18</span><span>  - name: Publish</span></div>
                  <div class="gb-ln gb-del"><span>19</span><span>    uses: acme/publish@main</span></div>
                </div>
                <p class="gb-p">This step runs with <code>contents: write</code> on a mutable ref. Pin it to a full commit SHA.</p>
              </div>
            )}
          </div>

          <div class="gb-cap">
            <div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
            <a class="gb-open" href={f.href}>View workflow <span aria-hidden="true">→</span></a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="gb-foot">
    <details class="gb-more">
      <summary>
        <span class="gb-sum-closed">Show all 15 workflows</span>
        <span class="gb-sum-open">Show fewer</span>
        <span class="gb-chev" set:html={icon('chevron-down', 16)} />
      </summary>
      <ul class="gb-rest" role="list">
        {rest.map((w) => (
          <li><a href={w.href}><span class="gb-rest-t">{w.title}</span><span class="gb-rest-d">{w.text}</span></a></li>
        ))}
      </ul>
    </details>
    <a class="gb-all" href="/gh-aw/gallery/">Browse the full gallery <span aria-hidden="true">→</span></a>
  </div>
</LandingSection>

<script>
  document.querySelectorAll<HTMLElement>('[data-gb]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    root.dataset.ready = '';
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j].hidden = i !== j;
      });
      if (focus) tabs[i].focus();
    };
    select(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('mouseenter', () => select(i));
      t.addEventListener('focus', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        const n = tabs.length;
        const to = k === 'ArrowDown' || k === 'ArrowRight' ? (i + 1) % n : k === 'ArrowUp' || k === 'ArrowLeft' ? (i - 1 + n) % n : k === 'Home' ? 0 : k === 'End' ? n - 1 : -1;
        if (to >= 0) { e.preventDefault(); select(to, true); }
      });
    });
  });
</script>

<style>
  .gb {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .gb-tabs { order: 2; display: flex; flex-direction: column; }
  .gb-panels { order: 1; display: flex; flex-direction: column; gap: 3rem; min-width: 0; }
  /* Tabs only make sense once JS can drive them; without it every panel shows. */
  .gb:not([data-ready]) .gb-tabs { display: none; }

  .gb-tab {
    all: unset;
    box-sizing: border-box;
    display: block;
    padding: 0.875rem 0 0.875rem 0;
    border-top: 1px solid var(--aw-color-divider);
    cursor: pointer;
  }
  .gb-tab:last-child { border-bottom: 1px solid var(--aw-color-divider); }
  .gb-tab-t { display: block; font-size: var(--aw-step-0); font-weight: 500; color: var(--aw-color-text-muted); transition: color 0.15s; }
  .gb-tab-d { display: none; margin-top: 0.25rem; font-size: var(--aw-step--1); line-height: 1.5; color: var(--aw-color-text-secondary); text-wrap: pretty; max-width: 38ch; }
  .gb-tab:hover .gb-tab-t { color: var(--aw-color-text-strong); }
  .gb-tab[aria-selected='true'] .gb-tab-t { color: var(--aw-color-text-strong); font-weight: 560; }
  .gb-tab[aria-selected='true'] .gb-tab-d { display: block; }
  .gb-tab:focus-visible, .gb-panel:focus-visible, .gb-open:focus-visible, .gb-more summary:focus-visible, .gb-all:focus-visible, .gb-rest a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  .gb-win {
    background: var(--aw-color-surface);
    border: 1px solid var(--aw-color-border);
    border-radius: 12px;
    box-shadow: var(--aw-shadow-raised);
    overflow: hidden;
    font-size: var(--aw-step--1);
    color: var(--aw-color-text-body);
  }
  .gb-bar {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.625rem 1rem;
    background: var(--aw-color-surface-header);
    border-bottom: 1px solid var(--aw-color-hairline-light);
    font-family: var(--aw-font-mono);
    color: var(--aw-color-text-muted);
  }
  .gb-body { display: flex; flex-direction: column; gap: 1rem; padding: 1.25rem 1.25rem 1.5rem; min-height: 19rem; }
  .gb-h { display: flex; align-items: flex-start; gap: 0.625rem; }
  .gb-h-t { font-size: var(--aw-step-1); font-weight: 560; letter-spacing: -0.01em; line-height: 1.3; color: var(--aw-color-text-strong); }
  .gb-num { font-weight: 400; color: var(--aw-color-text-muted); }
  .gb-ico { display: inline-flex; flex: none; color: var(--aw-color-text-muted); }
  .gb-h .gb-ico { margin-top: 0.125rem; }
  .gb-ico :global(svg) { fill: currentColor; }
  .gb-ok { color: var(--aw-color-success); }
  .gb-bad { color: var(--aw-color-danger); }
  .gb-pr { color: var(--aw-color-text-secondary); }
  .gb-p { margin: 0; line-height: 1.55; color: var(--aw-color-text-secondary); text-wrap: pretty; }
  .gb-body code, .gb-note code { padding: 0 0.25rem; background: var(--aw-color-bg-subtle); border: 0; border-radius: 4px; font-size: 0.92em; color: var(--aw-color-text-strong); }
  .gb-chips, .gb-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .gb-chip { display: inline-block; padding: 0 0.5rem; border: 1px solid var(--aw-color-border); border-radius: 999px; color: var(--aw-color-text-secondary); white-space: nowrap; }
  .gb-chip-new { border-color: var(--aw-color-complement); color: var(--aw-color-complement); }
  .gb-chip-danger { border-color: var(--aw-color-danger); color: var(--aw-color-danger); }
  .gb-mut { color: var(--aw-color-text-muted); }
  .gb-plus { color: var(--aw-color-success); }
  .gb-minus { color: var(--aw-color-danger); }
  .gb-note { border: 1px solid var(--aw-color-hairline-light); border-radius: 8px; overflow: hidden; }
  .gb-note-h { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; background: var(--aw-color-surface-header); border-bottom: 1px solid var(--aw-color-hairline-light); color: var(--aw-color-text-muted); }
  .gb-note-h b { color: var(--aw-color-text-strong); font-weight: 550; }
  .gb-note p { margin: 0; padding: 0.75rem; line-height: 1.55; color: var(--aw-color-text-secondary); text-wrap: pretty; }
  .gb-code { border: 1px solid var(--aw-color-hairline-light); border-radius: 8px; overflow: hidden; font-family: var(--aw-font-mono); }
  .gb-ln { display: flex; gap: 1rem; padding: 0.125rem 0.75rem; white-space: pre; overflow: hidden; color: var(--aw-color-text-secondary); }
  .gb-ln > span:first-child { flex: none; width: 1.5rem; color: var(--aw-color-text-muted); }
  .gb-ln > span:last-child { overflow: hidden; text-overflow: ellipsis; }
  .gb-add { background: var(--aw-color-surface-header); color: var(--aw-color-success); }
  .gb-del { background: var(--aw-color-surface-header); color: var(--aw-color-danger); }
  .gb-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--aw-color-hairline-light); border-radius: 8px; }
  .gb-list li { display: flex; align-items: center; gap: 0.625rem; margin: 0; padding: 0.5rem 0.75rem; }
  .gb-list li + li { border-top: 1px solid var(--aw-color-hairline-light); }
  .gb-li-t { flex: none; font-weight: 550; color: var(--aw-color-text-strong); }
  .gb-list .gb-mut { margin-left: auto; text-align: right; }
  .gb-list li > .gb-li-t + .gb-mut { margin-left: 0; text-align: left; }

  .gb-cap { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-top: 1.25rem; }
  .gb-cap h3 { margin: 0; font-size: var(--aw-step-1); font-weight: 550; letter-spacing: -0.01em; color: var(--aw-color-text-strong); border: 0; }
  .gb-cap p { margin: 0.25rem 0 0; max-width: 46ch; line-height: 1.5; color: var(--aw-color-text-secondary); text-wrap: pretty; }
  .gb-open, .gb-all { flex: none; font-size: var(--aw-step-0); color: var(--aw-color-accent-text); text-decoration: none; white-space: nowrap; }
  .gb-open:hover, .gb-all:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Without JS the stacked panels need separation. */
  .gb:not([data-ready]) .gb-panel + .gb-panel { padding-top: 0; }

  .gb-foot { margin-top: 3.5rem; position: relative; }
  .gb-foot .gb-all { position: absolute; top: 0; right: 0; line-height: 2.5rem; }
  @media (max-width: 40rem) { .gb-foot .gb-all { position: static; display: block; margin-top: 1.25rem; } }
  .gb-more summary {
    list-style: none; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.5rem; padding: 0 1rem;
    border: 1px solid var(--aw-color-border-strong); border-radius: 8px; background: var(--aw-color-surface);
    font-size: var(--aw-step-0); font-weight: 500; color: var(--aw-color-text-strong); cursor: pointer; user-select: none;
  }
  .gb-more summary::-webkit-details-marker { display: none; }
  .gb-more summary:hover { background: var(--aw-color-bg-subtle); }
  .gb-sum-open, .gb-more[open] .gb-sum-closed { display: none; }
  .gb-more[open] .gb-sum-open { display: inline; }
  .gb-chev { display: inline-flex; color: var(--aw-color-text-muted); transition: transform 0.2s; }
  .gb-chev :global(svg) { fill: currentColor; }
  .gb-more[open] .gb-chev { transform: rotate(180deg); }
  .gb-rest { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 2rem; }
  .gb-rest li { margin: 0; padding: 0; border-top: 1px solid var(--aw-color-divider); }
  .gb-rest a { display: block; padding: 0.75rem 0; color: inherit; text-decoration: none; }
  .gb-rest-t { display: block; font-weight: 500; color: var(--aw-color-text-strong); }
  .gb-rest a:hover .gb-rest-t { text-decoration: underline; text-decoration-color: var(--aw-color-border-strong); text-underline-offset: 3px; }
  .gb-rest-d { display: block; margin-top: 0.125rem; font-size: var(--aw-step--1); line-height: 1.45; color: var(--aw-color-text-muted); }

  @media (max-width: 60rem) {
    .gb { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .gb-tabs { order: 1; flex-direction: row; overflow-x: auto; scrollbar-width: none; gap: 1.25rem; }
    .gb-tabs::-webkit-scrollbar { display: none; }
    .gb-tab, .gb-tab:last-child { flex: none; border: 0; padding: 0.5rem 0; border-bottom: 2px solid transparent; }
    .gb-tab[aria-selected='true'] { border-bottom-color: var(--aw-color-text-strong); }
    .gb-tab-t { white-space: nowrap; }
    .gb-tab[aria-selected='true'] .gb-tab-d { display: none; }
    .gb-panels { order: 2; }
    .gb-rest { grid-template-columns: minmax(0, 1fr); }
    .gb-cap { flex-direction: column; gap: 0.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gb-chev, .gb-tab-t { transition: none; }
  }
  /* Stack panels in one cell so the spotlight keeps the tallest panel's height
     and the content below doesn't jump when switching workflows. */
  .gb[data-ready] .gb-panels { display: grid; }
  .gb[data-ready] .gb-panel { grid-area: 1 / 1; }
  .gb[data-ready] .gb-panel[hidden] { display: block; visibility: hidden; }
</style>
