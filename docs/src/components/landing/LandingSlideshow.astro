---
import Octicon from '../Octicon.astro';
import SlideshowDrawing from './SlideshowDrawing.astro';
import SlideshowSnippet from './SlideshowSnippet.astro';
---

<button
  type="button"
  class="slideshow-trigger"
  data-slideshow-trigger
  aria-label="Start slideshow"
  aria-haspopup="dialog"
  aria-controls="landing-slideshow"
  title="Start slideshow"
  hidden
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 3h18M4 3v13h16V3M12 16v5M7 21l5-5 5 5" />
    <path d="m10 7 5 3-5 3Z" />
  </svg>
</button>
<span class="slideshow-error" data-slideshow-error role="alert" hidden></span>

<dialog id="landing-slideshow" aria-label="GitHub Agentic Workflows presentation">
  <div class="slideshow-viewport" data-slideshow-viewport>
    <div class="slideshow-stage" data-slideshow-stage>
      <svg class="slideshow-ink" data-slideshow-ink role="img" aria-label="Slide annotations" preserveAspectRatio="none"></svg>
    </div>
  </div>
  <div class="slideshow-controls" role="group" aria-label="Slide navigation">
    <span class="slideshow-hint">Arrow keys to navigate · Esc to exit</span>
    <SlideshowDrawing />
    <button type="button" data-slideshow-previous aria-label="Previous slide">
      <Octicon name="chevron-left" size={20} />
    </button>
    <span data-slideshow-status role="status" aria-live="polite" aria-atomic="true"></span>
    <button type="button" data-slideshow-next aria-label="Next slide">
      <Octicon name="chevron-right" size={20} />
    </button>
    <button type="button" data-slideshow-close aria-label="Exit slideshow" autofocus>
      <Octicon name="x" size={20} />
    </button>
  </div>
  <SlideshowSnippet />
</dialog>

<script>
  let cleanup = () => {};

  function initialize() {
    cleanup();
    const trigger = document.querySelector<HTMLButtonElement>('[data-slideshow-trigger]');
    const errorMessage = document.querySelector<HTMLElement>('[data-slideshow-error]');
    const deck = document.querySelector<HTMLElement>('[data-slideshow-slides]');
    if (!trigger || !errorMessage || !deck?.querySelector(':scope > section:not([data-slideshow-hide])')) return;
    const controller = new AbortController();
    const { signal } = controller;
    const desktop = window.matchMedia('(min-width: 50rem)');
    let runtime: import('../../scripts/slideshow').SlideshowController | undefined;
    trigger.hidden = false;
    trigger.addEventListener('click', async () => {
      if (!desktop.matches || trigger.disabled) return;
      trigger.disabled = true;
      trigger.setAttribute('aria-busy', 'true');
      errorMessage.hidden = true;
      try {
        if (!runtime) {
          const { createSlideshow } = await import('../../scripts/slideshow');
          if (signal.aborted) return;
          runtime = createSlideshow(trigger);
        }
        runtime.open();
      } catch (error) {
        if (signal.aborted) return;
        console.error('Unable to load the slideshow:', error);
        errorMessage.textContent = 'Unable to load the slideshow. Reload the page and try again.';
        errorMessage.hidden = false;
      } finally {
        if (!signal.aborted) {
          trigger.disabled = false;
          trigger.removeAttribute('aria-busy');
        }
      }
    }, { signal });
    cleanup = () => {
      controller.abort();
      runtime?.destroy();
      trigger.hidden = true;
      trigger.disabled = false;
      trigger.removeAttribute('aria-busy');
      errorMessage.hidden = true;
    };
  }

  initialize();
  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>

<style>
  .slideshow-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: var(--aw-radius-sm);
    background: transparent;
    color: var(--aw-color-text-muted);
    cursor: pointer;
  }
  .slideshow-trigger:hover { color: var(--aw-color-text-strong); }
  .slideshow-trigger[hidden] { display: none; }
  .slideshow-error {
    position: fixed;
    inset: calc(var(--sl-nav-height) + 1rem) 1rem auto;
    z-index: 10;
    padding: 1rem;
    border: 1px solid var(--aw-color-border);
    border-radius: var(--aw-radius-sm);
    background: var(--aw-color-bg);
    color: var(--aw-color-text);
  }
  @media (max-width: 49.99rem) {
    .slideshow-trigger { display: none; }
  }
  :global(html:has(#landing-slideshow[open])) { overflow: hidden; }
  dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--aw-color-bg);
    color: var(--aw-color-text);
    font-family: var(--aw-font-sans);
    overflow: hidden;
  }
  dialog[open] { display: flex; flex-direction: column; }
  .slideshow-viewport {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .slideshow-stage { position: relative; width: 100%; height: 100%; flex: none; }
  dialog[open] .slideshow-stage { view-transition-name: aw-slide; }
  .slideshow-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .slideshow-ink[data-tool]:not([data-tool='pointer']) {
    pointer-events: auto;
    touch-action: none;
    cursor: crosshair;
  }
  dialog :global([data-slideshow-slides]) {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--aw-slide-width, 72rem);
    transform-origin: top left;
  }
  dialog :global([data-slideshow-slides] > section) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--aw-slide-height, 0px);
    margin: 0;
    padding-block: 2rem;
  }
  :global([data-slideshow-slides] > .aw-title-slide) { display: none; }
  dialog[open] :global([data-slideshow-slides] > .aw-title-slide:not([hidden])) {
    display: flex;
    align-items: center;
    text-align: center;
    padding-inline: 2rem;
  }
  dialog :global(.aw-title-slide h1) {
    margin: 0;
    max-width: 72rem;
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 460;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
    color: var(--aw-color-text);
  }
  dialog :global([data-slideshow-slides] > section > :is(.aw-container, [data-variant-group])) {
    width: 100%;
  }
  dialog :global([data-slideshow-slides] > section[hidden]) { display: none; }
  :global(#landing-slideshow[open] [data-slideshow-hide]) { display: none !important; }
  .slideshow-controls {
    position: absolute;
    inset-inline-start: 50%;
    bottom: 1.25rem;
    width: max-content;
    max-width: calc(100% - 2rem);
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    flex: none;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--aw-color-divider);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--aw-color-bg) 55%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: var(--aw-shadow-raised);
    font-size: 0.75rem;
    opacity: 0.1;
    transition: opacity 180ms ease, background-color 180ms ease;
  }
  .slideshow-controls:hover,
  .slideshow-controls:focus-within {
    opacity: 1;
    background: var(--aw-color-bg);
  }
  .slideshow-hint { display: none; }
  .slideshow-controls :global(button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--aw-color-border);
    border-radius: var(--aw-radius-sm);
    background: var(--aw-color-surface);
    color: var(--aw-color-text);
    cursor: pointer;
  }
  .slideshow-controls :global(button:hover) { background: var(--aw-color-bg-subtle); }
  .slideshow-controls :global(button:disabled) { opacity: 0.4; cursor: default; }
  .slideshow-controls > button,
  .slideshow-controls :global([data-drawing-toggle]) {
    width: 32px;
    height: 32px;
  }
  [data-slideshow-status] {
    max-width: min(40vw, 24rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }
  [data-slideshow-close] { margin-inline-start: auto; }
  @media (prefers-reduced-motion: reduce) {
    .slideshow-controls { transition: none; }
  }
</style>

<style is:global>
  html[data-slideshow-direction='forward'] { --aw-slide-offset: 100vw; }
  html[data-slideshow-direction='backward'] { --aw-slide-offset: -100vw; }
  html[data-slideshow-direction]::view-transition { pointer-events: none; }
  html[data-slideshow-direction]::view-transition-old(root),
  html[data-slideshow-direction]::view-transition-new(root) { animation: none; }
  html[data-slideshow-direction]::view-transition-group(aw-slide) {
    animation-duration: 280ms;
    animation-timing-function: ease;
  }
  html[data-slideshow-direction]::view-transition-old(aw-slide) {
    animation: aw-slide-out 280ms ease-in-out both;
  }
  html[data-slideshow-direction]::view-transition-new(aw-slide) {
    animation: aw-slide-in 280ms ease-in-out both;
  }
  @keyframes aw-slide-out {
    to { transform: translateX(calc(-1 * var(--aw-slide-offset))); }
  }
  @keyframes aw-slide-in {
    from { transform: translateX(var(--aw-slide-offset)); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    html[data-slideshow-direction]::view-transition-group(aw-slide),
    html[data-slideshow-direction]::view-transition-old(aw-slide),
    html[data-slideshow-direction]::view-transition-new(aw-slide) { animation: none; }
  }
</style>
