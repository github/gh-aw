---
import CopyCommand from './CopyCommand.astro';
interface Props {
  align?: 'start' | 'center';
}
const { align = 'start' } = Astro.props;
---

<div class:list={['aw-cta', align === 'center' && 'is-center']}>
  <div class="aw-cta-row">
    <a class="aw-btn" href="/gh-aw/setup/creating-workflows/">Create a workflow</a>
    <CopyCommand command="gh extension install github/gh-aw" />
  </div>
  <p class="aw-cta-note">
    Prefer a guided form?{' '}
    <a href="https://githubnext.github.io/gh-aw-wizard/">Try the workflow wizard <span aria-hidden="true">↗</span></a>
  </p>
</div>

<style>
  .aw-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .is-center .aw-cta-row {
    justify-content: center;
  }
  .aw-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding-inline: 1.25rem;
    border-radius: 999px;
    background: var(--aw-color-button-bg);
    color: var(--aw-color-button-text);
    font-size: var(--aw-step-0);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .aw-btn:hover {
    background: var(--aw-color-button-bg-hover);
    color: var(--aw-color-button-text);
  }
  .aw-btn:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 2px;
  }
  .aw-cta-note {
    margin: 1rem 0 0;
    font-size: var(--aw-step--1);
    color: var(--aw-color-text-muted);
  }
  .is-center .aw-cta-note {
    text-align: center;
  }
  .aw-cta-note a {
    color: inherit;
    text-decoration: none;
  }
  .aw-cta-note a:hover {
    text-decoration: underline;
    color: var(--aw-color-text-secondary);
  }
</style>
