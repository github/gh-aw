---
/**
 * Floating control for flipping between VariantGroup layouts while exploring
 * designs. Shown on the dev server, or anywhere with `?variants` in the URL.
 * Choices persist in localStorage. Remove once variants are chosen.
 */
const enabledByDefault = import.meta.env.DEV;
---

<aside class="aw-switcher not-content" data-enabled={enabledByDefault ? 'true' : 'false'} aria-label="Design variants" hidden>
  <button class="aw-switcher-toggle" type="button" aria-expanded="true">Variants</button>
  <div class="aw-switcher-body"></div>
</aside>

<script>
  const KEY = 'aw-variant-choices';
  const root = document.querySelector<HTMLElement>('.aw-switcher');
  const params = new URLSearchParams(location.search);
  if (root && (root.dataset.enabled === 'true' || params.has('variants'))) {
    root.hidden = false;
    const body = root.querySelector<HTMLElement>('.aw-switcher-body')!;
    const toggle = root.querySelector<HTMLButtonElement>('.aw-switcher-toggle')!;
    let saved: Record<string, string> = {};
    try {
      saved = JSON.parse(localStorage.getItem(KEY) || '{}');
    } catch {}

    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(saved));
      } catch {}
    };

    document.querySelectorAll<HTMLElement>('[data-variant-group]').forEach((group) => {
      const id = group.dataset.variantGroup!;
      const variants: { key: string; name: string }[] = JSON.parse(group.dataset.variants || '[]');
      if (saved[id] && variants.some((v) => v.key === saved[id])) group.dataset.active = saved[id];

      const row = document.createElement('div');
      row.className = 'aw-switcher-row';
      const label = document.createElement('a');
      label.className = 'aw-switcher-label';
      label.href = `#${id}`;
      label.textContent = group.dataset.variantLabel || id;
      row.append(label);

      const seg = document.createElement('div');
      seg.className = 'aw-switcher-seg';
      seg.setAttribute('role', 'radiogroup');
      seg.setAttribute('aria-label', `${label.textContent} layout`);
      variants.forEach((v) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = v.key.toUpperCase();
        b.title = v.name;
        b.setAttribute('role', 'radio');
        const sync = () => b.setAttribute('aria-checked', String(group.dataset.active === v.key));
        sync();
        b.addEventListener('click', () => {
          group.dataset.active = v.key;
          saved[id] = v.key;
          save();
          seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
          name.textContent = v.name;
          group.dispatchEvent(new CustomEvent('variantchange', { detail: v.key, bubbles: true }));
        });
        seg.append(b);
      });
      row.append(seg);

      const name = document.createElement('span');
      name.className = 'aw-switcher-name';
      name.textContent = variants.find((v) => v.key === group.dataset.active)?.name ?? '';
      row.append(name);
      body.append(row);
    });

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      body.hidden = open;
    });
  }
</script>

<style>
  .aw-switcher {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 100;
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.5rem;
    border: 1px solid var(--aw-color-border);
    border-radius: 12px;
    background: var(--aw-color-surface);
    box-shadow: var(--aw-shadow-raised);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text);
  }
  .aw-switcher-toggle {
    width: 100%;
    padding: 0.25rem 0.5rem;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--aw-color-text-muted);
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }
  .aw-switcher-body {
    display: grid;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem 0.5rem;
  }
  .aw-switcher :global(.aw-switcher-row) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.125rem 0.5rem;
    align-items: center;
  }
  .aw-switcher :global(.aw-switcher-label) {
    color: var(--aw-color-text);
    font-weight: 500;
    text-decoration: none;
  }
  .aw-switcher :global(.aw-switcher-name) {
    grid-column: 1 / -1;
    color: var(--aw-color-text-muted);
  }
  .aw-switcher :global(.aw-switcher-seg) {
    display: inline-flex;
    padding: 2px;
    border-radius: 8px;
    background: var(--aw-color-bg-subtle);
  }
  .aw-switcher :global(.aw-switcher-seg button) {
    min-width: 1.75rem;
    padding: 0.125rem 0.375rem;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--aw-color-text-muted);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .aw-switcher :global(.aw-switcher-seg button[aria-checked='true']) {
    background: var(--aw-color-surface);
    color: var(--aw-color-text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  .aw-switcher :global(button:focus-visible),
  .aw-switcher :global(a:focus-visible) {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 1px;
  }
</style>
