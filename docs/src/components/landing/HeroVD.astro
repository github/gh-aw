---
/** Hero D: category-led, with CI / CD / Continuous AI lanes. */
import CtaRow from './CtaRow.astro';
import HeroVDVisual from './HeroVDVisual.astro';
---

<div class="aw-hero-inner">
  <div class="aw-hero-text">
    <h2><span class="aw-line">Continuous AI</span> <span class="aw-line">for your repository,</span> <span class="aw-line aw-muted">triggered by your configuration.</span></h2>
    <p class="aw-hero-sub">
      Complement CI and CD with coding agents that help triage issues, update documentation, add tests and propose fixes. Workflows run in GitHub Actions on configured schedules or events, within the permissions and limits you set.
    </p>
    <div class="aw-hero-cta"><CtaRow /></div>
  </div>
  <div class="aw-hero-visual"><HeroVDVisual /></div>
</div>
