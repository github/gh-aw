---
/** Hero C: outcome-led. "Start every day with a better repository." with an overnight feed. */
import CtaRow from './CtaRow.astro';
import HeroVCVisual from './HeroVCVisual.astro';
---

<div class="aw-hero-inner">
  <div class="aw-hero-text">
    <h1><span class="aw-line">Start every day</span> <span class="aw-line">with a better repository,</span> <span class="aw-line aw-muted">improved while you sleep.</span></h1>
    <p class="aw-hero-sub">
      The coding agents you know and love triage issues, investigate failures and open pull requests overnight. Under your rules, in GitHub Actions.
    </p>
    <div class="aw-hero-cta"><CtaRow /></div>
  </div>
  <div class="aw-hero-visual"><HeroVCVisual /></div>
</div>
