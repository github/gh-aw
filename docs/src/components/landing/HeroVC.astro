---
/** Hero C: task-led, with a sample activity feed. */
import CtaRow from './CtaRow.astro';
import HeroVCVisual from './HeroVCVisual.astro';
---

<div class="aw-hero-inner">
  <div class="aw-hero-text">
    <h2><span class="aw-line">Put coding agents to work</span> <span class="aw-line">on repository tasks,</span> <span class="aw-line aw-muted">on your schedule or events.</span></h2>
    <p class="aw-hero-sub">
      Configure your preferred coding agents to help triage issues, investigate failures and open pull requests in GitHub Actions. Runs follow the schedules or events, permissions and limits you configure. Review generated changes before merging.
    </p>
    <div class="aw-hero-cta"><CtaRow /></div>
  </div>
  <div class="aw-hero-visual"><HeroVCVisual /></div>
</div>
