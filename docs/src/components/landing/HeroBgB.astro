---
// Hero background variant B: "rays".
// Soft light shafts falling from the top edge across the full width, all
// leaning ~20deg, each with its own width and intensity. They breathe and
// drift sideways slowly, fade out as they come down, and are quantised with
// an 8x8 Bayer ordered dither into a few purple steps. Rare GitHub-green
// glints sit in the brightest beams near the top. Rendered at low resolution
// and scaled up with `image-rendering: pixelated`.
---

<div class="hero-bg-b" data-hero-bg-b>
  <canvas class="hero-bg-b-canvas"></canvas>
</div>

<style>
  .hero-bg-b {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-bg-b-canvas {
    position: absolute;
    top: 0;
    right: 0;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    opacity: 0;
    transition: opacity 900ms ease-out;
  }
  .hero-bg-b-canvas.is-ready {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-b-canvas {
      transition: none;
    }
  }
</style>

<script>
  const VERT = `
    attribute vec2 a_pos;
    void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
  `;

  const FRAG = `
    precision highp float;
    uniform vec2 u_res;      // canvas size in cells
    uniform float u_cell;    // CSS px per cell
    uniform float u_time;
    uniform float u_strength;
    uniform vec3 u_p1;
    uniform vec3 u_p2;
    uniform vec3 u_p3;
    uniform vec3 u_p4;
    uniform vec3 u_green;

    float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
    float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    const float SLANT = 0.36;  // tan(~20deg): beams lean down and to the right
    const int BEAMS = 11;

    void main() {
      vec2 cell = gl_FragCoord.xy;            // cell coords, y up
      vec2 size = u_res * u_cell;             // CSS px
      float x = cell.x * u_cell;
      float y = size.y - cell.y * u_cell;     // CSS px from the top edge
      float t = u_time;
      bool narrow = size.x < 720.0;

      // Vertical reach of the light: calm from the h1 down. A little longer
      // on the right, where the hero visual sits at desktop widths.
      float xr = x / size.x;
      float reach = narrow
        ? mix(42.0, 96.0, smoothstep(0.3, 1.0, xr))  // h1 starts ~50px down
        : mix(min(size.y * 0.24, 210.0), min(size.y * 0.5, 420.0), smoothstep(0.4, 0.95, xr));

      // Position across the beams: shear x by depth so every beam leans.
      float margin = reach * SLANT + 220.0;
      float span = size.x + margin * 2.0;
      float u = x - y * SLANT + margin;
      float drift = t * 6.0 + sin(t * 0.07) * 40.0;  // slow sideways wander

      float light = 0.0;
      float peak = 0.0;
      for (int i = 0; i < BEAMS; i++) {
        float fi = float(i);
        float r1 = hash(vec2(fi, 3.1));
        float r2 = hash(vec2(fi, 7.7));
        float r3 = hash(vec2(fi, 1.9));
        float c = mod((fi + 0.15 + r1 * 0.7) / float(BEAMS) * span + drift, span);
        float w = mix(18.0, 90.0, r2) * (0.75 + 0.35 * sin(t * (0.21 + r3 * 0.2) + fi * 2.3));
        w *= 1.0 + 0.6 * y / reach;  // shafts spread slightly as they fall
        float k = mix(0.45, 1.0, r3) * (0.6 + 0.4 * sin(t * (0.17 + r1 * 0.15) + fi * 1.7));
        float d = abs(u - c) / w;
        float b = 1.0 - smoothstep(0.15, 1.0, d);
        // Each beam reaches a slightly different depth.
        float len = reach * mix(0.8, 1.2, r1);
        float fall = 1.0 - smoothstep(-0.15 * len, len, y);
        float v = b * k * fall;
        light += v;
        peak = max(peak, v);
      }

      // Faint wash along the very top so the band reads across the full width.
      float wash = (1.0 - smoothstep(0.0, reach * 0.45, y)) * 0.18;
      float v = clamp(light * 0.9 + wash, 0.0, 1.0) * u_strength;
      float th = bayer8(cell);

      // Rare green glints in the brightest beams, close to the top edge.
      float g = hash(cell + floor(t * 1.5) * 17.0);
      if (peak > 0.55 && y < reach * 0.45 && g < (peak - 0.55) * 0.1) {
        gl_FragColor = vec4(u_green, 1.0);
        return;
      }

      float level = floor(v * 4.0 + th);
      if (level < 1.0) { gl_FragColor = vec4(0.0); return; }
      vec3 col = level < 2.0 ? u_p1 : level < 3.0 ? u_p2 : level < 4.0 ? u_p3 : u_p4;
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const CELL = 3; // CSS px per dither cell
  const FRAME_MS = 1000 / 30;

  function parseColor(ctx: CanvasRenderingContext2D, value: string): [number, number, number] {
    ctx.clearRect(0, 0, 1, 1);
    ctx.fillStyle = '#000';
    ctx.fillStyle = value.trim() || '#000';
    ctx.fillRect(0, 0, 1, 1);
    const d = ctx.getImageData(0, 0, 1, 1).data;
    return [d[0] / 255, d[1] / 255, d[2] / 255];
  }

  function compile(gl: WebGLRenderingContext, type: number, src: string) {
    const s = gl.createShader(type);
    if (!s) return null;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      gl.deleteShader(s);
      return null;
    }
    return s;
  }

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.hero-bg-b-canvas');
    if (!canvas) return;
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true });
    if (!gl) return;

    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    if (!prog) return;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const u = (name: string) => gl.getUniformLocation(prog, name);
    const uRes = u('u_res');
    const uCell = u('u_cell');
    const uTime = u('u_time');
    const uStrength = u('u_strength');
    const uP = [u('u_p1'), u('u_p2'), u('u_p3'), u('u_p4')];
    const uGreen = u('u_green');
    gl.uniform1f(uCell, CELL);

    const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });

    function readColors() {
      if (!probe || !gl) return;
      const cs = getComputedStyle(document.documentElement);
      const dark = document.documentElement.getAttribute('data-theme') !== 'light';
      const steps = dark
        ? ['--aw-purple-9', '--aw-purple-8', '--aw-purple-7', '--aw-purple-6']
        : ['--aw-purple-3', '--aw-purple-4', '--aw-purple-6', '--aw-purple-7'];
      steps.forEach((name, i) => gl.uniform3fv(uP[i], parseColor(probe, cs.getPropertyValue(name))));
      gl.uniform3fv(uGreen, parseColor(probe, cs.getPropertyValue('--aw-green-6')));
      gl.uniform1f(uStrength, dark ? 1.0 : 0.72);
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Random phase so the field doesn't always start from the same shape.
    const t0 = performance.now() - Math.random() * 60000;
    let raf = 0;
    let last = 0;
    let onScreen = true;

    function visible() {
      return onScreen && !document.hidden && root.offsetParent !== null && root.clientWidth > 0;
    }

    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (!w || !h || !gl || !canvas) return false;
      const cw = Math.ceil(w / CELL);
      const ch = Math.ceil(h / CELL);
      if (canvas.width !== cw || canvas.height !== ch) {
        canvas.width = cw;
        canvas.height = ch;
        canvas.style.width = `${cw * CELL}px`;
        canvas.style.height = `${ch * CELL}px`;
        gl.viewport(0, 0, cw, ch);
        gl.uniform2f(uRes, cw, ch);
      }
      return true;
    }

    function draw(now: number) {
      if (!gl || !canvas) return;
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      canvas.classList.add('is-ready');
    }

    function tick(now: number) {
      raf = 0;
      if (!visible()) return;
      if (now - last >= FRAME_MS) {
        last = now;
        draw(now);
      }
      raf = requestAnimationFrame(tick);
    }

    function update() {
      if (!visible()) {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        return;
      }
      if (!resize()) return;
      if (reduceMotion.matches) {
        draw(t0 + 20000);
        return;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    }

    readColors();

    new ResizeObserver(update).observe(root);

    new IntersectionObserver((entries) => {
      onScreen = entries.some((e) => e.isIntersecting);
      update();
    }).observe(root);

    new MutationObserver(() => {
      readColors();
      if (visible()) draw(reduceMotion.matches ? t0 + 20000 : performance.now());
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    document.addEventListener('visibilitychange', update);
    reduceMotion.addEventListener('change', update);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-bg-b]').forEach(init);
</script>
