---
/** Hero A visual: a prompt, the workflow file it created, and the issue it opened next morning. */
import Octicon from '../Octicon.astro';
---

<div class="va" aria-hidden="true">
  <div class="va-card aw-card va-chat">
    <div class="va-msg">
      <span class="va-you">You</span>
      <p>Create a daily agentic workflow that gives me an issue summary</p>
    </div>
    <div class="va-reply">
      <Octicon name="copilot" size={14} class="va-agent" />
      <span>Added <code>daily-issue-summary.md</code> and opened a pull request.</span>
    </div>
  </div>

  <div class="va-step"><span class="va-step-line"></span></div>

  <div class="va-card aw-card va-file">
    <div class="va-bar"><Octicon name="file" size={14} />.github/workflows/daily-issue-summary.md</div>
<pre class="va-code"><span class="m">---</span>
<span class="k">on:</span> daily
<span class="k">safe-outputs:</span>
<span class="k">  create-issue:</span>
<span class="m">---</span>
Summarise yesterday's issues. Flag
anything that needs a reply.</pre>
  </div>

  <div class="va-step va-step-time"><span class="va-step-label"><Octicon name="clock" size={14} />Next morning, 08:00</span></div>

  <div class="va-card aw-card va-issue">
    <div class="va-issue-head">
      <span class="va-title">Issue summary — Oct 2 <span class="va-num">#241</span></span>
      <span class="va-state"><Octicon name="issue-opened" size={14} />Open</span>
    </div>
    <ul>
      <li><b>9</b> new issues, <b>6</b> closed</li>
      <li><b>2</b> waiting on a maintainer reply</li>
      <li><b>#482</b> blocked on design review</li>
    </ul>
  </div>
</div>

<style>
  .va {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .va-card {
    min-width: 0;
  }
  /* Prompt */
  .va-chat {
    padding: 1rem;
    width: min(100%, 26rem);
  }
  .va-msg {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.75rem 0.875rem;
    border-radius: 10px;
    background: var(--aw-color-bg-subtle);
  }
  .va-you {
    font-size: var(--aw-step--1);
    font-weight: 600;
    color: var(--aw-color-text-muted);
  }
  .va-msg p {
    margin: 0;
    font-size: var(--aw-step-0);
    line-height: 1.4;
    color: var(--aw-color-text);
  }
  .va-reply {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-inline: 0.125rem;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--aw-color-text-secondary);
  }
  .va-agent {
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--aw-color-accent-low);
    color: var(--aw-color-accent-text);
  }
  .va-reply code {
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text);
    background: none;
    padding: 0;
  }
  /* Connectors: each line sits on the centre of the span both cards share. */
  .va-step {
    display: flex;
    justify-content: center;
    width: min(100%, 26rem);
    height: 1.5rem;
  }
  .va-step-line {
    width: 1px;
    height: 100%;
    background: var(--aw-color-border-strong);
  }
  .va-step-time {
    flex-direction: column;
    align-items: center;
    width: auto;
    height: auto;
  }
  .va-step-time::before,
  .va-step-time::after {
    content: '';
    width: 1px;
    height: 0.875rem;
    background: var(--aw-color-border-strong);
  }
  .va-step-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.375rem;
    font-size: var(--aw-step--1);
    font-weight: 500;
    color: var(--aw-color-text-muted);
  }
  /* Workflow file */
  .va-file {
    overflow: hidden;
  }
  .va-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--aw-color-border);
    background: var(--aw-color-surface-header);
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .va-code {
    margin: 0;
    padding: 0.75rem 0.875rem;
    overflow-x: auto;
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    line-height: 1.55;
    color: var(--aw-color-text);
    background: transparent;
    border: 0;
    border-radius: 0;
  }
  .va-code .k,
  .va-code .m {
    color: var(--aw-color-text-muted);
  }
  /* Issue */
  .va-issue {
    padding: 0.875rem 1rem 1rem;
    animation: va-rise 0.5s var(--aw-ease-out) 0.3s backwards;
  }
  .va-issue-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.625rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--aw-color-border);
  }
  .va-state {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    padding: 0.25rem 0.625rem 0.25rem 0.5rem;
    border-radius: var(--aw-radius-pill);
    background: var(--aw-color-success);
    color: var(--aw-color-text-on-status);
    font-size: var(--aw-step--1);
    font-weight: 500;
  }
  .va-title {
    font-size: var(--aw-step-0);
    font-weight: 600;
    color: var(--aw-color-text-strong);
  }
  .va-num {
    font-weight: 400;
    color: var(--aw-color-text-muted);
  }
  .va-issue ul {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    font-size: var(--aw-text-ui);
    line-height: 1.65;
    color: var(--aw-color-text-body);
  }
  .va-issue b {
    font-weight: 600;
    color: var(--aw-color-text);
  }
  @media (min-width: 640px) {
    .va-file {
      margin-left: 2rem;
    }
    .va-step:not(.va-step-time) {
      padding-left: 2rem;
    }
    .va-step-time {
      margin-left: 4rem;
    }
    .va-issue {
      margin-left: 4rem;
    }
  }
  @keyframes va-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .va-issue {
      animation: none;
    }
  }
</style>
