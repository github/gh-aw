---
import CtaRow from './CtaRow.astro';
import HeroExample from './HeroExample.astro';
import VariantGroup from './VariantGroup.astro';
import HeroBgA from './HeroBgA.astro';
import HeroBgC from './HeroBgC.astro';
import HeroBgD from './HeroBgD.astro';
---

<section class="aw-hero not-content">
  <div class="aw-hero-bg" aria-hidden="true">
    <VariantGroup
      id="hero-bg"
      label="Hero background"
      variants={[
        { key: 'a', name: 'A · clouds' },
        { key: 'c', name: 'C · waves' },
        { key: 'd', name: 'D · columns' },
      ]}
    >
      <div data-variant="a"><HeroBgA /></div>
      <div data-variant="c"><HeroBgC /></div>
      <div data-variant="d"><HeroBgD /></div>
    </VariantGroup>
  </div>
  <div class="aw-hero-inner">
    <div class="aw-hero-text">
      <h1><span class="aw-line">Intelligent GitHub</span> <span class="aw-line">repository automation,</span> <span class="aw-line aw-muted">written in Markdown.</span></h1>
      <p class="aw-hero-sub">
        Describe a task in plain language and GitHub turns it into an Actions workflow. Run the coding agents you know and love, with strong guardrails and cost controls.
      </p>
      <div class="aw-hero-cta"><CtaRow /></div>
    </div>
    <div class="aw-hero-visual"><HeroExample /></div>
  </div>
</section>

<style>
  .aw-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 7rem);
  }
  /* Decorative background layer; each variant fills it edge to edge. */
  .aw-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .aw-hero-bg :global(.aw-variant-group),
  .aw-hero-bg :global([data-variant]) {
    height: 100%;
  }
  .aw-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 3.5rem);
    align-items: center;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }
  @media (min-width: 1024px) {
    .aw-hero-inner {
      grid-template-columns: minmax(0, 11fr) minmax(0, 10fr);
    }
  }
  h1 {
    margin: 0;
    font-size: var(--aw-step-5);
    font-weight: 460;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
    color: var(--aw-color-text);
    border: 0;
  }
  .aw-line {
    display: block;
  }
  .aw-muted {
    color: var(--aw-color-text-muted);
  }
  .aw-hero-sub {
    margin: 1.25rem 0 0;
    max-width: 42ch;
    font-size: var(--aw-step-1);
    line-height: 1.5;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  .aw-hero-cta {
    margin-top: 2rem;
  }
</style>
