---
// Hero background variant C: "waves".
// Three broad, soft ribbons hang from the top edge of the hero across the
// full width. Each ribbon's centre line undulates as a long, slow wave
// drifting left to right, and the ribbons thicken and thin along their
// length. The field is quantised with an 8x8 Bayer ordered dither into a few
// purple steps (3 CSS px cells, upscaled with `image-rendering: pixelated`),
// so the dither supplies the texture. Sparse coral glints sit on the crests.
---

<div class="hero-bg-c" data-hero-bg-c>
  <canvas class="hero-bg-c-canvas"></canvas>
</div>

<style>
  .hero-bg-c {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-bg-c-canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    opacity: 0;
    transition: opacity 900ms ease-out;
  }
  .hero-bg-c-canvas.is-ready {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-c-canvas {
      transition: none;
    }
  }
</style>

<script>
  const VERT = `
    attribute vec2 a_pos;
    void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
  `;

  const FRAG = `
    precision highp float;
    uniform vec2 u_res;      // canvas size in cells
    uniform float u_cell;    // CSS px per cell
    uniform float u_time;
    uniform float u_strength;
    uniform vec3 u_p1;
    uniform vec3 u_p2;
    uniform vec3 u_p3;
    uniform vec3 u_p4;
    uniform vec3 u_glint;

    float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
    float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

    float hash(vec2 q) { return fract(sin(dot(q, vec2(127.1, 311.7))) * 43758.5453); }

    // One broad ribbon: a soft band whose centre line undulates as a long,
    // slow wave travelling left to right. Returns intensity in .x and how
    // close this point is to a wave crest (the band's highest point) in .y.
    vec2 ribbon(vec2 p, float base, float amp, float kx, float speed, float ph, float halfW, float t) {
      float phase = p.x * kx - t * speed + ph;
      float s = sin(phase);
      // A second, longer undulation so the swells don't repeat too evenly.
      float yc = base + amp * s + amp * 0.45 * sin(p.x * kx * 0.37 + t * speed * 0.6 + ph * 1.9);
      float d = (p.y - yc) / halfW;
      // Breathing along the length: each ribbon thickens and thins.
      float body = 0.62 + 0.38 * sin(p.x * kx * 0.55 - t * speed * 0.5 + ph * 2.3);
      return vec2(exp(-d * d) * body, max(-s, 0.0));
    }

    void main() {
      vec2 cell = gl_FragCoord.xy;            // cell coords, y up
      vec2 size = u_res * u_cell;             // CSS px
      // CSS px with y = 0 at the top edge.
      vec2 p = vec2(cell.x * u_cell, size.y - cell.y * u_cell);
      float t = u_time;

      // Falloff: a band hanging from the top edge across the full width.
      // Desktop: gone by ~40% of the height (where the h1 starts), reaching a
      // little lower on the right behind the hero visual. Narrow screens: the
      // headline starts near the top, so keep it a thin strip.
      float wide = smoothstep(560.0, 1000.0, size.x);
      float fall = mix(105.0, 0.38 * size.y, wide);
      float xN = p.x / size.x;
      fall *= 1.0 + 0.55 * wide * smoothstep(0.5, 0.95, xN);

      // Ribbons are laid out in a space scaled to the band height so narrow
      // screens get the same composition, just shorter.
      float sc = clamp(fall / 340.0, 0.45, 1.0);
      vec2 q = vec2(p.x, p.y / sc);

      // Three thick, soft swells, ~100-250px tall, stacked from the top edge.
      vec2 r1 = ribbon(q, 50.0,  22.0, 1.0 / 140.0, 0.36, 0.0, 46.0, t);
      vec2 r2 = ribbon(q, 170.0, 30.0, 1.0 / 195.0, 0.27, 2.1, 60.0, t);
      vec2 r3 = ribbon(q, 300.0, 36.0, 1.0 / 260.0, 0.20, 4.3, 78.0, t);
      // Screen-blend so overlaps glow without clipping, then cap the peak so
      // ribbon centres sit in the lighter dither steps: airy, not inky.
      float n = 1.0 - (1.0 - r1.x) * (1.0 - r2.x) * (1.0 - r3.x);
      n *= 0.66;

      float m = 1.0 - smoothstep(0.0, fall, p.y);
      m = m * m * (1.0 + 0.15 * m);

      float v = n * m * u_strength;
      float th = bayer8(cell);

      // Coral glints: rare 2x2-cell specks on the crests of the two upper
      // ribbons. One candidate per 7x7-cell block, picked by hash, so they
      // spread out along the crest line instead of clumping at the top.
      vec2 blk = floor(cell / 7.0);
      // Jitter each speck inside its block so they don't line up in rows.
      vec2 jit = floor(vec2(hash(blk + 17.0), hash(blk + 41.0)) * 5.0);
      vec2 local = cell - blk * 7.0 - jit;
      bool onCrest = (r1.y > 0.9 && r1.x > 0.45) || (r2.y > 0.9 && r2.x > 0.45);
      bool inSpeck = local.x >= 0.0 && local.x < 2.0 && local.y >= 0.0 && local.y < 2.0;
      if (onCrest && m > 0.3 && inSpeck && hash(blk) > 0.95) {
        gl_FragColor = vec4(u_glint, 1.0);
        return;
      }

      float level = floor(v * 4.0 + th);
      if (level < 1.0) { gl_FragColor = vec4(0.0); return; }
      vec3 col = level < 2.0 ? u_p1 : level < 3.0 ? u_p2 : level < 4.0 ? u_p3 : u_p4;
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const CELL = 3; // CSS px per dither cell
  const FRAME_MS = 1000 / 30;

  function parseColor(ctx: CanvasRenderingContext2D, value: string): [number, number, number] {
    ctx.clearRect(0, 0, 1, 1);
    ctx.fillStyle = '#000';
    ctx.fillStyle = value.trim() || '#000';
    ctx.fillRect(0, 0, 1, 1);
    const d = ctx.getImageData(0, 0, 1, 1).data;
    return [d[0] / 255, d[1] / 255, d[2] / 255];
  }

  function compile(gl: WebGLRenderingContext, type: number, src: string) {
    const s = gl.createShader(type);
    if (!s) return null;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      gl.deleteShader(s);
      return null;
    }
    return s;
  }

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.hero-bg-c-canvas');
    if (!canvas) return;
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true });
    if (!gl) return;

    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    if (!prog) return;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const u = (name: string) => gl.getUniformLocation(prog, name);
    const uRes = u('u_res');
    const uCell = u('u_cell');
    const uTime = u('u_time');
    const uStrength = u('u_strength');
    const uP = [u('u_p1'), u('u_p2'), u('u_p3'), u('u_p4')];
    const uGlint = u('u_glint');
    gl.uniform1f(uCell, CELL);

    const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });

    function readColors() {
      if (!probe || !gl) return;
      const cs = getComputedStyle(document.documentElement);
      const dark = document.documentElement.getAttribute('data-theme') !== 'light';
      const steps = dark
        ? ['--aw-purple-9', '--aw-purple-8', '--aw-purple-7', '--aw-purple-6']
        : ['--aw-purple-2', '--aw-purple-3', '--aw-purple-4', '--aw-purple-6'];
      steps.forEach((name, i) => gl.uniform3fv(uP[i], parseColor(probe, cs.getPropertyValue(name))));
      gl.uniform3fv(uGlint, parseColor(probe, cs.getPropertyValue(dark ? '--aw-coral-4' : '--aw-coral-6')));
      gl.uniform1f(uStrength, dark ? 0.85 : 0.9);
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Random phase so the bands don't always start from the same shape.
    const t0 = performance.now() - Math.random() * 60000;
    let raf = 0;
    let last = 0;
    let onScreen = true;

    function visible() {
      return onScreen && !document.hidden && root.offsetParent !== null && root.clientWidth > 0;
    }

    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (!w || !h || !gl || !canvas) return false;
      const cw = Math.ceil(w / CELL);
      const ch = Math.ceil(h / CELL);
      if (canvas.width !== cw || canvas.height !== ch) {
        canvas.width = cw;
        canvas.height = ch;
        canvas.style.width = `${cw * CELL}px`;
        canvas.style.height = `${ch * CELL}px`;
        gl.viewport(0, 0, cw, ch);
        gl.uniform2f(uRes, cw, ch);
      }
      return true;
    }

    function draw(now: number) {
      if (!gl || !canvas) return;
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      canvas.classList.add('is-ready');
    }

    function tick(now: number) {
      raf = 0;
      if (!visible()) return;
      if (now - last >= FRAME_MS) {
        last = now;
        draw(now);
      }
      raf = requestAnimationFrame(tick);
    }

    function update() {
      if (!visible()) {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        return;
      }
      if (!resize()) return;
      if (reduceMotion.matches) {
        draw(t0 + 20000);
        return;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    }

    readColors();

    new ResizeObserver(update).observe(root);

    new IntersectionObserver((entries) => {
      onScreen = entries.some((e) => e.isIntersecting);
      update();
    }).observe(root);

    new MutationObserver(() => {
      readColors();
      if (visible()) draw(reduceMotion.matches ? t0 + 20000 : performance.now());
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Variant switching toggles display on an ancestor; resume when shown.
    const group = root.closest('[data-variant-group]');
    if (group) {
      new MutationObserver(update).observe(group, {
        attributes: true,
        subtree: true,
        attributeFilter: ['data-active', 'hidden', 'style', 'class'],
      });
    }

    document.addEventListener('visibilitychange', update);
    reduceMotion.addEventListener('change', update);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-bg-c]').forEach(init);
</script>
