---
import LandingSection from './LandingSection.astro';
import Foot from './SafeByDefaultFoot.astro';
import { icon, layer, TRIFECTA_URL } from './SafeByDefaultData';

// Each layer constrains one of the three risk circles, the dangerous overlap, or all of them.
const groups = [
  {
    hl: 'untrusted',
    title: 'Untrusted content',
    lead: 'Limit what the agent reads.',
    layers: [layer('integrity')],
  },
  {
    hl: 'private',
    title: 'Private data',
    lead: 'Keep secrets out of reach.',
    layers: [layer('credentials')],
  },
  {
    hl: 'outbound',
    title: 'Outbound access',
    lead: 'Limit what the agent can change or send.',
    layers: [layer('sandbox')],
  },
  {
    hl: 'centre',
    title: 'The combination',
    lead: 'If all three still meet, check what comes out.',
    layers: [layer('threat'), layer('outputs')],
  },
  {
    hl: 'all',
    title: 'All three, before anything runs',
    lead: 'Catch unsafe workflow design up front.',
    layers: [layer('compile')],
  },
] as const;
---

<LandingSection
  titleId="safety-c-title"
  title="Safe by default"
  lede="Agents read by default. Every write is checked before it lands."
>
  <div class="sv-root">
    <p class="sv-intro">
      An agent becomes dangerous when it combines all three of these. Security researchers call it{' '}
      <a href={TRIFECTA_URL}>the lethal trifecta</a>. gh-aw puts a layer on each circle, and more where they meet.
    </p>

    <div class="sv-layout">
      <figure class="sv-figure">
        <svg viewBox="0 0 440 400" role="img" aria-labelledby="sv-svg-title sv-svg-desc">
          <title id="sv-svg-title">The lethal trifecta</title>
          <desc id="sv-svg-desc">
            Three overlapping circles: untrusted content, private data and outbound access. Where all three overlap is
            the lethal trifecta.
          </desc>
          <defs>
            <clipPath id="sv-clip-a"><circle cx="220" cy="135" r="120" /></clipPath>
            <clipPath id="sv-clip-b"><circle cx="150" cy="256" r="120" /></clipPath>
          </defs>
          <g class="sv-circles">
            <circle class="sv-circle sv-c-untrusted" cx="220" cy="135" r="120" />
            <circle class="sv-circle sv-c-private" cx="150" cy="256" r="120" />
            <circle class="sv-circle sv-c-outbound" cx="290" cy="256" r="120" />
          </g>
          <g clip-path="url(#sv-clip-a)">
            <g clip-path="url(#sv-clip-b)">
              <circle class="sv-centre" cx="290" cy="256" r="120" />
            </g>
          </g>
          <g class="sv-labels">
            <text class="sv-t sv-t-untrusted" x="220" y="82" text-anchor="middle">Untrusted</text>
            <text class="sv-t sv-t-untrusted" x="220" y="102" text-anchor="middle">content</text>
            <text class="sv-t sv-t-private" x="104" y="302" text-anchor="middle">Private</text>
            <text class="sv-t sv-t-private" x="104" y="322" text-anchor="middle">data</text>
            <text class="sv-t sv-t-outbound" x="336" y="302" text-anchor="middle">Outbound</text>
            <text class="sv-t sv-t-outbound" x="336" y="322" text-anchor="middle">access</text>
            <text class="sv-t sv-t-centre" x="220" y="212" text-anchor="middle">Lethal</text>
            <text class="sv-t sv-t-centre" x="220" y="231" text-anchor="middle">trifecta</text>
          </g>
        </svg>
        <figcaption>Any one circle is manageable. The overlap is where agents get hijacked.</figcaption>
      </figure>

      <div class="sv-groups">
        {groups.map((g) => (
          <section class="sv-group" data-hl={g.hl} aria-labelledby={`sv-g-${g.hl}`}>
            <h3 id={`sv-g-${g.hl}`}>{g.title}</h3>
            <p class="sv-lead">{g.lead}</p>
            <ul>
              {g.layers.map((l) => (
                <li>
                  <span class="sv-ico" set:html={icon(l.icon)} />
                  <div>
                    <strong>{l.name}</strong>
                    <p>{l.text}</p>
                    <a href={l.href}>Learn more <span class="sv-ico" set:html={icon('arrow-right', 12)} /></a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>

    <Foot />
  </div>
</LandingSection>

<style>
  .sv-root {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .sv-ico {
    display: inline-flex;
    flex: none;
  }
  .sv-ico :global(svg) {
    fill: currentColor;
  }
  a {
    color: var(--aw-color-accent-text);
    text-underline-offset: 0.2em;
  }
  a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 2px;
  }
  .sv-intro {
    margin: 0;
    max-width: 58ch;
    font-size: var(--aw-step-0);
    line-height: 1.6;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }

  .sv-layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .sv-layout {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
    .sv-figure {
      position: sticky;
      top: 6rem;
    }
  }

  /* Venn */
  .sv-figure {
    margin: 0;
    max-width: 26rem;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sv-circle {
    fill: var(--aw-color-complement);
    fill-opacity: 0;
    stroke: var(--aw-color-complement);
    stroke-width: 1.5;
    transition: fill-opacity 0.2s ease, stroke-width 0.2s ease, opacity 0.2s ease;
  }
  .sv-centre {
    fill: var(--aw-color-complement-low);
    stroke: var(--aw-color-complement);
    stroke-width: 1.5;
    transition: opacity 0.2s ease;
  }
  .sv-t {
    font-size: var(--aw-step-0);
    font-weight: 500;
    fill: var(--aw-color-text);
    transition: opacity 0.2s ease;
  }
  .sv-t-centre {
    font-size: var(--aw-step-0);
    font-weight: 650;
    fill: var(--aw-color-complement);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--aw-color-text-muted);
    max-width: 34ch;
  }

  /* Highlight: hovering or focusing inside a group lights its circle(s) and dims the rest */
  .sv-layout:has(.sv-group:is(:hover, :focus-within)) .sv-circle,
  .sv-layout:has(.sv-group:is(:hover, :focus-within)) .sv-t:not(.sv-t-centre) {
    opacity: 0.4;
  }
  .sv-layout:has([data-hl='untrusted']:is(:hover, :focus-within)) :is(.sv-c-untrusted, .sv-t-untrusted),
  .sv-layout:has([data-hl='private']:is(:hover, :focus-within)) :is(.sv-c-private, .sv-t-private),
  .sv-layout:has([data-hl='outbound']:is(:hover, :focus-within)) :is(.sv-c-outbound, .sv-t-outbound),
  .sv-layout:has([data-hl='all']:is(:hover, :focus-within)) :is(.sv-circle, .sv-t) {
    opacity: 1;
  }
  .sv-layout:has([data-hl='untrusted']:is(:hover, :focus-within)) .sv-c-untrusted,
  .sv-layout:has([data-hl='private']:is(:hover, :focus-within)) .sv-c-private,
  .sv-layout:has([data-hl='outbound']:is(:hover, :focus-within)) .sv-c-outbound,
  .sv-layout:has([data-hl='all']:is(:hover, :focus-within)) .sv-circle {
    fill-opacity: 0.18;
    stroke-width: 3;
  }
  .sv-layout:has([data-hl='centre']:is(:hover, :focus-within)) .sv-centre {
    stroke-width: 3;
  }
  .sv-layout:has([data-hl='centre']:is(:hover, :focus-within)) .sv-circle {
    opacity: 0.4;
  }

  /* Groups */
  .sv-group {
    padding-block: 1.25rem;
    border-top: 1px solid var(--aw-color-border);
  }
  .sv-group:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .sv-group h3 {
    margin: 0;
    font-size: var(--aw-step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--aw-color-text-strong);
  }
  .sv-lead {
    margin: 0.25rem 0 0;
    font-size: var(--aw-step--1);
    color: var(--aw-color-text-muted);
  }
  .sv-group ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .sv-group li {
    display: flex;
    gap: 0.75rem;
  }
  .sv-group li > .sv-ico {
    margin-top: 0.2rem;
    color: var(--aw-color-text-muted);
  }
  .sv-group strong {
    font-size: var(--aw-step-0);
    font-weight: 560;
    color: var(--aw-color-text-strong);
  }
  .sv-group li p {
    margin: 0.25rem 0 0.5rem;
    max-width: 52ch;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  .sv-group li a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--aw-step--1);
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-circle,
    .sv-centre,
    .sv-t {
      transition: none;
    }
  }
</style>
