---
/** Ready-made workflows: a segmented control picks one; its copy, setup prompt and output mock sit in focus. */
import Octicon from '../Octicon.astro';
import LandingSection from './LandingSection.astro';
import CopyPrompt from './CopyPrompt.astro';
import WorkflowsMock from './WorkflowsMock.astro';
import WorkflowsMore from './WorkflowsMore.astro';

interface Workflow {
  id: 'repo-assist' | 'ci-doctor' | 'repo-status' | 'test-improver';
  name: string;
  trigger: string;
  triggerIcon: 'clock' | 'zap';
  outcome: string;
  detail: string;
  prompt: string;
  href: string;
}
interface Props {
  workflows: Workflow[];
  title: string;
  lede: string;
}
const { workflows, title, lede } = Astro.props;
const tabIcon = { 'repo-assist': 'copilot', 'ci-doctor': 'pulse', 'repo-status': 'graph', 'test-improver': 'beaker' } as const;
---

<LandingSection id="gallery" titleId="workflows-title" title={title} lede={lede}>
  <div class="wf-picker" data-wf-picker>
    <div class="wf-tabs" role="tablist" aria-label="Ready-made workflows">
      {workflows.map((w, i) => (
        <button
          type="button"
          role="tab"
          id={`wf-tab-${w.id}`}
          aria-controls={`wf-panel-${w.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <Octicon name={tabIcon[w.id]} class="wf-tab-tile" />
          <span class="wf-tab-text">
            <span class="wf-tab-name">{w.name}</span>
            <span class="wf-tab-trig">{w.trigger}</span>
          </span>
        </button>
      ))}
    </div>

    {workflows.map((w, i) => (
      <div
        class="wf-panel"
        role="tabpanel"
        id={`wf-panel-${w.id}`}
        aria-labelledby={`wf-tab-${w.id}`}
        hidden={i !== 0}
      >
        <div class="wf-copy">
          <h3>{w.name}</h3>
          <span class="wf-trigger"><Octicon name={w.triggerIcon} size={14} />{w.trigger}</span>
          <p class="wf-outcome">{w.outcome}</p>
          <p class="wf-detail">{w.detail}</p>
          {w.id === 'repo-assist' && (
            <p class="wf-proof">Running in <b>13</b> open-source repos, Repo Assist has closed <b>578</b> issues, with issues closing a median <b>8X</b> faster.</p>
          )}
          <div class="wf-actions">
            <CopyPrompt label="Copy setup prompt" text={w.prompt} />
            <a class="wf-link aw-link" href={w.href} aria-label={`Read more about ${w.name}`}>Read more <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="wf-visual">
          <WorkflowsMock kind={w.id} />
        </div>
      </div>
    ))}
  </div>
  <WorkflowsMore />
</LandingSection>

<style>
  /* Above the "more workflows" bar, so copy-prompt popovers aren't covered. */
  .wf-picker {
    position: relative;
    z-index: 2;
    margin-top: 2.5rem;
  }

  /* Segmented control */
  .wf-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--aw-color-divider);
    border-radius: 14px;
    background: var(--aw-color-bg-subtle);
  }
  @media (min-width: 48rem) {
    .wf-tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .wf-tabs [role='tab'] {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    padding: 0.625rem 0.875rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font: inherit;
    text-align: left;
    color: var(--aw-color-text-secondary);
    cursor: pointer;
    transition: background-color var(--aw-duration-fast) ease, color var(--aw-duration-fast) ease, box-shadow var(--aw-duration-fast) ease;
  }
  .wf-tabs [role='tab']:hover {
    color: var(--aw-color-text-strong);
  }
  .wf-tabs [role='tab'][aria-selected='true'] {
    background: var(--aw-color-surface);
    box-shadow: var(--aw-shadow-raised);
    color: var(--aw-color-text-strong);
  }
  .wf-tab-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    min-width: 0;
  }
  /* Same icon tiles as the spotlight list; Copilot stands for the agent */
  .wf-tab-tile {
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--aw-radius-md);
    background: var(--aw-color-surface);
    color: var(--aw-color-text-muted);
    transition: color var(--aw-duration-fast) ease, background-color var(--aw-duration-fast) ease;
  }
  /* Two-up tabs on phones are too narrow for a tile */
  @media (max-width: 47.99rem) {
    .wf-tab-tile { display: none; }
  }
  .wf-tabs [role='tab'][aria-selected='true'] .wf-tab-tile {
    background: var(--aw-color-accent-low);
    color: var(--aw-color-accent-text);
  }
  .wf-tab-name {
    font-size: var(--aw-step-0);
    font-weight: 550;
    line-height: 1.3;
  }
  .wf-tab-trig {
    font-size: var(--aw-text-ui);
    line-height: 1.3;
    color: var(--aw-color-text-muted);
  }

  /* Panel */
  .wf-panel {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .wf-panel[hidden] {
    display: none;
  }
  @media (min-width: 75rem) {
    .wf-panel {
      grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
      gap: 3.5rem;
      align-items: center;
    }
  }
  .wf-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .wf-copy h3 {
    margin: 0;
    font-size: var(--aw-step-2);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--aw-color-text-strong);
  }
  .wf-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-size: var(--aw-text-ui);
    color: var(--aw-color-text-muted);
  }
  .wf-outcome {
    margin: 1rem 0 0;
    font-size: var(--aw-step-1);
    line-height: 1.45;
    color: var(--aw-color-text);
    text-wrap: pretty;
  }
  .wf-detail {
    margin: 0.75rem 0 0;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  .wf-proof {
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--aw-color-divider);
    font-size: var(--aw-text-ui);
    line-height: 1.5;
    color: var(--aw-color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .wf-proof b {
    font-weight: 600;
    color: var(--aw-color-text-strong);
  }
  .wf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    max-width: 100%;
    min-width: 0;
    margin-top: 1.5rem;
  }
  .wf-link {
    font-size: var(--aw-step-0);
  }
  .wf-visual {
    min-width: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wf-panel[data-entering] .wf-copy,
    .wf-panel[data-entering] .wf-visual {
      animation: wf-enter 0.28s var(--aw-ease-emphasized) both;
    }
    .wf-panel[data-entering] .wf-visual {
      animation-delay: 0.04s;
    }
  }
  @keyframes wf-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wf-tabs [role='tab'] {
      transition: none;
    }
  }
</style>

<script>
  import { setupTabs } from '../../scripts/tabs';

  let cleanup = () => {};

  function initialize() {
    cleanup();
    const controller = new AbortController();

    document.querySelectorAll<HTMLElement>('[data-wf-picker]').forEach((root) => {
      setupTabs(root, (panel, on) => {
        if (on && panel.hidden) {
          // Replay the entrance animation on the newly shown panel.
          panel.hidden = false;
          panel.removeAttribute('data-entering');
          void panel.offsetWidth;
          panel.setAttribute('data-entering', '');
        } else if (!on) {
          panel.hidden = true;
        }
      }, controller.signal);
    });

    cleanup = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup());
  initialize();
</script>
