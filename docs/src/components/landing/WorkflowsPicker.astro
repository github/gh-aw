---
/** Variant C: a segmented control picks one workflow; its output mock and install sit in focus. */
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';
import CopyPrompt from './CopyPrompt.astro';
import WorkflowsMock from './WorkflowsMock.astro';
import WorkflowsMore from './WorkflowsMore.astro';

interface Workflow {
  id: 'repo-assist' | 'ci-doctor' | 'repo-status' | 'test-improver';
  name: string;
  trigger: string;
  triggerIcon: string;
  outcome: string;
  detail: string;
  install: string;
  prompt: string;
  href: string;
}
interface Props {
  workflows: Workflow[];
  title: string;
  lede: string;
}
const { workflows, title, lede } = Astro.props;
const tabIcon: Record<string, string> = { 'repo-assist': 'copilot', 'ci-doctor': 'pulse', 'repo-status': 'graph', 'test-improver': 'beaker' };
const icon = (n: string, s = 16) => (octicons as Record<string, { toSVG: (o: object) => string }>)[n].toSVG({ width: s, height: s });
---

<LandingSection id="gallery" titleId="workflows-title" title={title} lede={lede}>
  <div class="wf-picker" data-wf-picker>
    <div class="wf-tabs" role="tablist" aria-label="Ready-made workflows">
      {workflows.map((w, i) => (
        <button
          type="button"
          role="tab"
          id={`wf-tab-${w.id}`}
          aria-controls={`wf-panel-${w.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="wf-tab-tile" aria-hidden="true" set:html={icon(tabIcon[w.id], 16)} />
          <span class="wf-tab-text">
            <span class="wf-tab-name">{w.name}</span>
            <span class="wf-tab-trig">{w.trigger}</span>
          </span>
        </button>
      ))}
    </div>

    {workflows.map((w, i) => (
      <div
        class="wf-panel"
        role="tabpanel"
        id={`wf-panel-${w.id}`}
        aria-labelledby={`wf-tab-${w.id}`}
        hidden={i !== 0}
      >
        <div class="wf-copy">
          <h3>{w.name}</h3>
          <span class="wf-trigger"><span set:html={icon(w.triggerIcon, 14)} />{w.trigger}</span>
          <p class="wf-outcome">{w.outcome}</p>
          <p class="wf-detail">{w.detail}</p>
          {w.id === 'repo-assist' && (
            <p class="wf-proof">Running in <b>13</b> open-source repos, Repo Assist has closed <b>578</b> issues, with issues closing a median <b>8X</b> faster.</p>
          )}
          <div class="wf-actions">
            <CopyPrompt label="Copy setup prompt" text={w.prompt} />
            <a class="wf-link" href={w.href} aria-label={`Read more about ${w.name}`}>Read more <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="wf-visual">
          <WorkflowsMock kind={w.id === 'repo-assist' ? 'repo-assist-week' : w.id} size="lg" />
        </div>
      </div>
    ))}
  </div>
  <WorkflowsMore />
</LandingSection>

<style>
  /* Above the "more workflows" bar, so copy-prompt popovers aren't covered. */
  .wf-picker {
    position: relative;
    z-index: 2;
    margin-top: 2.5rem;
  }

  /* Segmented control */
  .wf-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--aw-color-divider);
    border-radius: 14px;
    background: var(--aw-color-bg-subtle);
  }
  @media (min-width: 48rem) {
    .wf-tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .wf-tabs [role='tab'] {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    padding: 0.625rem 0.875rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font: inherit;
    text-align: left;
    color: var(--aw-color-text-secondary);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .wf-tabs [role='tab']:hover {
    color: var(--aw-color-text-strong);
  }
  .wf-tabs [role='tab'][aria-selected='true'] {
    background: var(--aw-color-surface);
    box-shadow: var(--aw-shadow-raised);
    color: var(--aw-color-text-strong);
  }
  .wf-tabs [role='tab']:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 2px;
  }
  .wf-tab-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    min-width: 0;
  }
  /* Same icon tiles as the spotlight list; Copilot stands for the agent */
  .wf-tab-tile {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--aw-color-surface);
    color: var(--aw-color-text-muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  /* Two-up tabs on phones are too narrow for a tile */
  @media (max-width: 47.99rem) {
    .wf-tab-tile { display: none; }
  }
  .wf-tabs [role='tab'][aria-selected='true'] .wf-tab-tile {
    background: var(--aw-color-accent-low);
    color: var(--aw-color-accent-text);
  }
  .wf-tab-tile :global(svg) {
    display: block;
    fill: currentColor;
  }
  .wf-tab-name {
    font-size: var(--aw-step-0);
    font-weight: 550;
    line-height: 1.3;
  }
  .wf-tab-trig {
    font-size: var(--aw-text-ui);
    line-height: 1.3;
    color: var(--aw-color-text-muted);
  }

  /* Panel */
  .wf-panel {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  .wf-panel[hidden] {
    display: none;
  }
  @media (min-width: 75rem) {
    .wf-panel {
      grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
      gap: 3.5rem;
      align-items: center;
    }
  }
  .wf-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .wf-copy h3 {
    margin: 0;
    font-size: var(--aw-step-2);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--aw-color-text-strong);
    border: 0;
  }
  .wf-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-size: var(--aw-text-ui);
    color: var(--aw-color-text-muted);
  }
  .wf-trigger :global(svg) {
    display: block;
    fill: currentColor;
  }
  .wf-outcome {
    margin: 1rem 0 0;
    font-size: var(--aw-step-1);
    line-height: 1.45;
    color: var(--aw-color-text);
    text-wrap: pretty;
  }
  .wf-detail {
    margin: 0.75rem 0 0;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  .wf-proof {
    margin: 1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--aw-color-divider);
    font-size: var(--aw-text-ui);
    line-height: 1.5;
    color: var(--aw-color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .wf-proof b {
    font-weight: 600;
    color: var(--aw-color-text-strong);
  }
  .wf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    max-width: 100%;
    min-width: 0;
    margin-top: 1.5rem;
  }
  .wf-link {
    font-size: var(--aw-step-0);
    color: var(--aw-color-accent-text);
    text-decoration: none;
    border-radius: 4px;
  }
  .wf-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .wf-link:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
  }
  .wf-visual {
    min-width: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wf-panel[data-entering] .wf-copy,
    .wf-panel[data-entering] .wf-visual {
      animation: wf-enter 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .wf-panel[data-entering] .wf-visual {
      animation-delay: 0.04s;
    }
  }
  @keyframes wf-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wf-tabs [role='tab'] {
      transition: none;
    }
  }
</style>

<script>
  let cleanup = () => {};

  function initialize() {
    cleanup();
    const controller = new AbortController();
    const { signal } = controller;

    document.querySelectorAll<HTMLElement>('[data-wf-picker]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const select = (next: HTMLButtonElement, focus: boolean) => {
        tabs.forEach((tab) => {
          const on = tab === next;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`);
          if (!panel) return;
          if (on && panel.hidden) {
            panel.hidden = false;
            panel.removeAttribute('data-entering');
            void panel.offsetWidth;
            panel.setAttribute('data-entering', '');
          } else if (!on) {
            panel.hidden = true;
          }
        });
        if (focus) next.focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab, false), { signal });
        tab.addEventListener('keydown', (e) => {
          const last = tabs.length - 1;
          let j = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = i === last ? 0 : i + 1;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = i === 0 ? last : i - 1;
          else if (e.key === 'Home') j = 0;
          else if (e.key === 'End') j = last;
          if (j < 0) return;
          e.preventDefault();
          select(tabs[j], true);
        }, { signal });
      });
    });

    cleanup = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup());
  initialize();
</script>
