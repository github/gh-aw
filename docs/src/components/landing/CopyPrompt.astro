---
/**
 * Compact copy control. Shows a short label; the full text appears in a popover
 * below it on hover or keyboard focus (Esc hides it), and clicking copies it. Used for prompts you hand
 * to a coding agent (installation, workflow creation).
 */
interface Props {
  /** Visible label and accessible name, e.g. "Copy installation prompt". */
  label: string;
  /** Text copied to the clipboard and previewed in the popover. */
  text: string;
  /** Popover alignment relative to the control. */
  align?: 'start' | 'center';
  /**
   * Small note above the previewed text. Defaults to "Run in your terminal" for
   * shell commands and "Paste into your favourite coding agent" for prompts.
   */
  meta?: string;
}
const { label, text, align = 'start' } = Astro.props;
const isCommand = /^(gh|git|npm|npx|curl)\s/.test(text);
const meta = Astro.props.meta ?? (isCommand ? 'Run in your terminal' : 'Paste into your favourite coding agent');
const id = `aw-cp-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['aw-cp', `is-${align}`]} data-copy-prompt={text} data-label={label}>
  <button type="button" class="aw-cp-btn" aria-label={label} aria-describedby={id}>
    <span class="aw-cp-ico" aria-hidden="true"></span>
    <span class="aw-cp-label" aria-hidden="true">{label}</span>
  </button>
  <span class="aw-cp-pop aw-card" id={id} role="tooltip"><span class="aw-cp-meta">{meta}</span><span class="aw-cp-text">{text}</span></span>
  <span class="sr-only" role="status" aria-live="polite"></span>
</span>

<style>
  .aw-cp {
    position: relative;
    display: inline-flex;
    max-width: 100%;
  }
  .aw-cp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 44px;
    max-width: 100%;
    padding-inline: 1rem 1.125rem;
    border: 1px solid var(--aw-color-border-strong);
    border-radius: var(--aw-radius-pill);
    background: var(--aw-color-surface);
    color: var(--aw-color-text);
    font: inherit;
    font-size: var(--aw-step-0);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--aw-duration-fast) ease, border-color var(--aw-duration-fast) ease;
  }
  .aw-cp-btn:hover {
    background: var(--aw-color-bg-subtle);
  }
  .aw-cp-ico {
    flex: none;
    width: 16px;
    height: 16px;
    background: currentColor;
    -webkit-mask: var(--aw-icon-copy) center / contain no-repeat;
    mask: var(--aw-icon-copy) center / contain no-repeat;
    transition: transform 0.2s var(--aw-ease-out);
  }
  .aw-cp[data-copied] .aw-cp-ico {
    -webkit-mask-image: var(--aw-icon-check);
    mask-image: var(--aw-icon-check);
    animation: aw-cp-pop 0.25s var(--aw-ease-out);
  }
  .aw-cp-label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Popover preview of the full text */
  .aw-cp-pop {
    position: absolute;
    top: calc(100% + 0.5rem);
    z-index: 10;
    width: max-content;
    max-width: min(28rem, calc(100vw - 2rem));
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    text-align: left;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--aw-duration-fast) ease, transform var(--aw-duration-fast) ease, visibility 0s linear var(--aw-duration-fast);
  }
  .aw-cp-meta {
    display: block;
    margin-bottom: 0.375rem;
    font-family: var(--aw-font-sans);
    font-size: var(--aw-step--1);
    font-weight: 400;
    line-height: 1.4;
    color: var(--aw-color-text-muted);
  }
  .aw-cp-text {
    display: block;
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    font-weight: 400;
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .is-start .aw-cp-pop {
    left: 0;
  }
  .is-center .aw-cp-pop {
    left: 50%;
    translate: -50% 0;
  }
  /* Esc sets [data-dismissed], hiding it until the pointer or focus leaves. */
  .aw-cp:not([data-dismissed]):has(.aw-cp-btn:focus-visible) .aw-cp-pop {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (hover: hover) {
    .aw-cp:not([data-dismissed]):hover .aw-cp-pop {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: var(--aw-duration-fast);
    }
  }
  @keyframes aw-cp-pop {
    from {
      transform: scale(0.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aw-cp-ico,
    .aw-cp-pop {
      transition: none;
      animation: none;
    }
    .aw-cp[data-copied] .aw-cp-ico {
      animation: none;
    }
  }
</style>

<script>
  let cleanup = () => {};

  function initialize() {
    cleanup();
    const controller = new AbortController();
    const { signal } = controller;
    const timers: number[] = [];

    document.querySelectorAll<HTMLElement>('[data-copy-prompt]').forEach((root) => {
      const btn = root.querySelector('button');
      const label = root.querySelector('.aw-cp-label');
      const status = root.querySelector('[role="status"]');
      const original = root.dataset.label ?? '';
      let timer: number | undefined;
      const undismiss = () => root.removeAttribute('data-dismissed');
      root.addEventListener('pointerleave', undismiss, { signal });
      btn?.addEventListener('blur', undismiss, { signal });
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(root.dataset.copyPrompt ?? '');
        } catch {
          if (status) status.textContent = 'Copy failed';
          return;
        }
        // Hold the width so the shorter "Copied" label doesn't shift the layout.
        if (btn && !root.hasAttribute('data-copied')) btn.style.minWidth = `${btn.offsetWidth}px`;
        root.setAttribute('data-copied', '');
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Copied to clipboard';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          root.removeAttribute('data-copied');
          if (label) label.textContent = original;
          if (btn) btn.style.minWidth = '';
          if (status) status.textContent = '';
        }, 1800);
        timers.push(timer);
      }, { signal });
    });

    // WCAG 1.4.13: Esc hides any open popover without moving focus or the pointer.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('[data-copy-prompt]').forEach((root) => {
        if (root.matches(':hover, :focus-within')) root.setAttribute('data-dismissed', '');
      });
    }, { signal });

    cleanup = () => {
      controller.abort();
      timers.forEach(clearTimeout);
    };
  }

  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup());
  initialize();
</script>
