---
/**
 * "More workflows" under the workflows section: a hairline rule, then a plain
 * text disclosure that opens the rest of the agentics collection by group.
 */
import Octicon from '../Octicon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const A = 'https://github.com/githubnext/agentics/blob/main/docs/';

const groups = [
  {
    id: 'maintain',
    heading: 'Maintain',
    items: [
      { title: 'Issue Triage', slug: 'issue-triage', text: 'Labels new issues and pull requests.' },
      { title: 'AI Moderator', slug: 'ai-moderator', text: 'Detects and moderates spam and link spam.' },
      { title: 'Daily Documentation Updater', slug: 'doc-updater', text: 'Updates docs from recent code changes.' },
      { title: 'Link Checker', slug: 'link-checker', text: 'Finds and fixes broken links in your docs.' },
    ],
  },
  {
    id: 'improve',
    heading: 'Improve code',
    items: [
      { title: 'Code Simplifier', slug: 'code-simplifier', text: 'Simplifies recently modified code.' },
      { title: 'Duplicate Code Detector', slug: 'duplicate-code-detector', text: 'Spots duplication and suggests refactors.' },
      { title: 'Daily Perf Improver', slug: 'perf-improver', text: 'Benchmarks and optimises slow code.' },
      { title: 'PR Fix', slug: 'pr-fix', text: 'Fixes failing checks on a pull request.' },
    ],
  },
  {
    id: 'report',
    heading: 'Report and plan',
    items: [
      { title: 'Weekly Issue Activity', slug: 'weekly-issue-activity', text: 'Weekly issue trends and recommendations.' },
      { title: 'Daily Team Status', slug: 'team-status', text: 'An upbeat summary of team activity.' },
      { title: 'Daily Plan', slug: 'plan', text: 'Keeps planning issues up to date.' },
      { title: 'Grumpy Reviewer', slug: 'grumpy-reviewer', text: 'A thorough, opinionated code review on demand.' },
    ],
  },
];
const all = groups.flatMap((g) => g.items);
const docsLink = `${base}/gallery/`;
---

<div class="ma">
  <details class="ma-d" data-ma>
    <summary>
      <span class="ma-closed">Show {all.length} more workflows</span>
      <span class="ma-open">Show fewer</span>
      <Octicon name="chevron-down" class="chev" />
    </summary>
    <div class="ma-body">
      <div class="ma-body-inner">
        <div class="groups">
          {groups.map((g) => (
            <section>
              <h3>{g.heading}</h3>
              <ul role="list">
                {g.items.map((i) => (
                  <li><a href={`${A}${i.slug}.md`}><span class="li-t">{i.title}</span><span class="li-d">{i.text}</span></a></li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </details>
  <a class="ma-docs aw-link" href={docsLink}>Workflow patterns in the docs <span aria-hidden="true">→</span></a>
</div>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li { margin: 0; padding: 0; }
  li a {
    display: block;
    padding: 0.625rem 0;
    color: inherit;
    text-decoration: none;
  }
  .li-t {
    display: block;
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-strong);
  }
  li a:hover .li-t {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .li-d {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--aw-text-ui);
    line-height: 1.45;
    color: var(--aw-color-text-muted);
  }
  .chev {
    color: var(--aw-color-text-muted);
    transition: transform 0.3s ease;
  }
  .groups {
    padding-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .groups h3 {
    margin: 0 0 0.25rem;
    font-size: var(--aw-text-ui);
    font-weight: 550;
    color: var(--aw-color-text-muted);
  }
  /* Plain text toggle: no border, no fill, so it never reads as a button. */
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-secondary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover {
    color: var(--aw-color-text-strong);
  }

  .ma {
    position: relative;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--aw-color-divider);
  }
  .ma-docs {
    position: absolute;
    top: 1.25rem;
    right: 0;
    font-size: var(--aw-text-ui);
    line-height: 1.6;
    white-space: nowrap;
  }
  /* Labels and chevron follow [data-expanded] once the script takes over,
     or plain [open] without JS. */
  .ma-open,
  .ma-d[open]:not([data-enhanced]) .ma-closed,
  .ma-d[data-expanded] .ma-closed { display: none; }
  .ma-d[open]:not([data-enhanced]) .ma-open,
  .ma-d[data-expanded] .ma-open { display: inline; }
  .ma-d[open]:not([data-enhanced]) .chev,
  .ma-d[data-expanded] .chev { transform: rotate(180deg); }

  /* Smooth open and close: the body folds via grid rows and fades. */
  .ma-d[data-enhanced] .ma-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.4s var(--aw-ease-emphasized),
      opacity 0.3s ease;
  }
  .ma-d[data-enhanced][data-expanded] .ma-body {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .ma-body-inner {
    min-height: 0;
    overflow: hidden;
  }

  @media (max-width: 52rem) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (max-width: 40rem) {
    .ma-docs { position: static; display: inline-block; margin-top: 1rem; }
    .ma { display: flex; flex-direction: column; align-items: flex-start; }
    .ma-d { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chev,
    .ma-d[data-enhanced] .ma-body { transition: none; }
  }
</style>

<script>
  let cleanup = () => {};

  function initialize() {
    cleanup();
    const controller = new AbortController();
    const { signal } = controller;
    const rafs: number[] = [];
    const timers: number[] = [];

    document.querySelectorAll<HTMLDetailsElement>('[data-ma]').forEach((d) => {
      const summary = d.querySelector('summary')!;
      const body = d.querySelector<HTMLElement>('.ma-body')!;
      d.setAttribute('data-enhanced', '');
      const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

      // [data-expanded] drives the fold animation; [open] keeps the content rendered.
      const expand = () => {
        rafs.push(requestAnimationFrame(() => {
          rafs.push(requestAnimationFrame(() => d.setAttribute('data-expanded', '')));
        }));
      };
      const collapse = () => {
        d.removeAttribute('data-expanded');
        if (reduce()) { d.open = false; return; }
        // Close once the fold finishes; the timer covers a transitionend that never fires.
        let timer = 0;
        const done = (ev?: TransitionEvent) => {
          if (ev && ev.propertyName !== 'grid-template-rows') return;
          body.removeEventListener('transitionend', done);
          clearTimeout(timer);
          if (!d.hasAttribute('data-expanded')) d.open = false;
        };
        body.addEventListener('transitionend', done, { signal });
        timer = window.setTimeout(done, 600);
        timers.push(timer);
      };

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        if (!d.hasAttribute('data-expanded')) {
          d.open = true;
          expand();
        } else {
          collapse();
        }
      }, { signal });
      // Opened or closed some other way (find-in-page, script): keep [data-expanded] in step.
      d.addEventListener('toggle', () => {
        if (d.open && !d.hasAttribute('data-expanded')) expand();
        else if (!d.open) d.removeAttribute('data-expanded');
      }, { signal });
    });

    cleanup = () => {
      controller.abort();
      rafs.forEach(cancelAnimationFrame);
      timers.forEach(clearTimeout);
    };
  }

  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup());
  initialize();
</script>
