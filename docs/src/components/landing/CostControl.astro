---
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';
const icon = (n: keyof typeof octicons, size = 16) => octicons[n].toSVG({ width: size, height: size });

/*
 * Mirrors the default (compact) output of `gh aw logs` — see
 * pkg/cli/logs_format_compact.go and the rounded box table in pkg/console.
 * The failed run hit `max-ai-credits: 100` and was stopped.
 */
const cap = 100;
const headers = ['RUNID', 'WORKFLOW', 'ENGINE', 'STATUS', 'DUR', 'TOKENS', 'AIC', 'TURNS', 'ERR', 'WSRF', 'EVENT', 'ACTOR', 'BRANCH'];
const runs = [
  ['18412093317', 'issue-triage', 'copilot', 'success', '2.9m', '214512', '31.4', '12', '0', '-', 'issues', 'monalisa', 'main'],
  ['18411877042', 'issue-triage', 'copilot', 'success', '3.4m', '268903', '38.7', '15', '0', '-', 'issues', 'hubot', 'main'],
  ['18411520968', 'issue-triage', 'copilot', 'failure', '9.8m', '912455', '100.6', '44', '1', '-', 'issues', 'octocat', 'main'],
  ['18410763311', 'issue-triage', 'copilot', 'success', '2.2m', '176204', '24.9', '9', '0', '-', 'issues', 'monalisa', 'main'],
  ['18409951280', 'issue-triage', 'copilot', 'success', '3.1m', '233871', '33.2', '13', '0', '-', 'issues', 'hubot', 'main'],
  ['18409322715', 'issue-triage', 'copilot', 'success', '2.6m', '198340', '28.1', '11', '0', '-', 'issues', 'octocat', 'main'],
];
const capped = runs.find((r) => r[3] === 'failure')!;

const widths = headers.map((h, i) => Math.max(h.length, ...runs.map((r) => r[i].length)));
const rule = (l: string, m: string, r: string) => l + widths.map((w) => '─'.repeat(w)).join(m) + r;
const pad = (s: string, i: number) => s.padEnd(widths[i]);
// Cells to emphasise on the capped run: STATUS and AIC.
const hot = new Set([3, 6]);
---

<LandingSection id="cost" title="Cost under control" lede="Set a budget per run and see where every credit goes.">
  <figure class="aw-cost">
    <div class="aw-term">
      <div class="aw-bar"><span class="aw-ico" set:html={icon('terminal')} />Terminal</div>
      <div class="aw-scroll" tabindex="0" role="region" aria-label="gh aw logs output, scrollable">
        <div class="aw-out">
          <div class="aw-cmd"><span class="aw-prompt">$</span> gh aw logs issue-triage -c 6</div>
          <div><span class="aw-dim">[summary]</span> runs=6 duration=24.0m turns=104 errors=1 aic=256.9 tokens=2004285 engines=copilot:6</div>
          <div class="aw-dim">[runs]</div>
          <div class="aw-tbl">
            <div class="aw-dim">{rule('╭', '┬', '╮')}</div>
            <div><span class="aw-dim">│</span>{headers.map((h, i) => <Fragment><span class="aw-head">{pad(h, i)}</span><span class="aw-dim">│</span></Fragment>)}</div>
            <div class="aw-dim">{rule('├', '┼', '┤')}</div>
            {runs.map((r) => (
              <div><span class="aw-dim">│</span>{r.map((c, i) => <Fragment><span class={r === capped && hot.has(i) ? 'aw-hot' : undefined}>{pad(c, i)}</span><span class="aw-dim">│</span></Fragment>)}</div>
            ))}
            <div class="aw-dim">{rule('╰', '┴', '╯')}</div>
          </div>
          <div class="aw-dim">[insights]</div>
          <div><span class="aw-dim">[medium]</span> Failure hotspot identified: Workflow issue-triage accounted for 1 failure(s) across 6 run(s), a 17% failure rate.</div>
        </div>
      </div>
    </div>
    <figcaption class="aw-caption">
      <span class="aw-ico aw-hot" set:html={icon('stop')} />
      <span>Run {capped[0]} hit its <code>max-ai-credits: {cap}</code> cap and stopped: <em>“AI credits budget exceeded (configured cap={cap}, observed usage={capped[6]})”</em></span>
    </figcaption>
  </figure>

  <div class="aw-points">
    <div class="aw-point">
      <h3>Cap every run</h3>
      <p><code>max-ai-credits</code> and <code>max-turns</code> stop a run that runs away. On by default: 1,000 AI Credits per run.</p>
      <a href="/gh-aw/reference/cost-management/#cap-ai-credits-per-run">Set a budget<span aria-hidden="true"> →</span></a>
    </div>
    <div class="aw-point">
      <h3>Cap every day</h3>
      <p><code>max-daily-ai-credits</code> limits a workflow across 24 hours, 5,000 AIC by default. Over budget, the agent is skipped.</p>
      <a href="/gh-aw/reference/cost-management/#cap-daily-ai-credits-per-workflow">Daily limits<span aria-hidden="true"> →</span></a>
    </div>
    <div class="aw-point">
      <h3>Find the expensive runs</h3>
      <p><code>gh aw logs</code> lists tokens, AIC and turns per run. <code>gh aw audit</code> breaks one down. 1 AIC is $0.01.</p>
      <a href="/gh-aw/reference/cost-management/#monitoring-costs-with-gh-aw-logs">Monitor cost<span aria-hidden="true"> →</span></a>
    </div>
  </div>
  <p class="aw-more">Send traces to any OTLP backend with <a href="/gh-aw/reference/open-telemetry/">OpenTelemetry</a>, and compare cost with <a href="/gh-aw/reference/outcomes/">outcomes</a>.</p>
</LandingSection>

<style>
  .aw-cost {
    margin: 2.5rem 0 0;
    min-width: 0;
  }

  /* Terminal — matches the fragments in How it works */
  .aw-term {
    overflow: hidden;
    background: var(--aw-color-surface);
    border: 1px solid var(--aw-color-border);
    border-radius: 12px;
    box-shadow: var(--aw-shadow-raised);
  }
  .aw-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--aw-color-border);
    background: var(--aw-color-surface-header);
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text-secondary);
  }
  .aw-ico {
    display: inline-flex;
    flex: none;
  }
  .aw-ico :global(svg) {
    fill: currentColor;
  }
  .aw-scroll {
    overflow-x: auto;
  }
  .aw-scroll:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: -2px;
  }
  .aw-out {
    margin: 0;
    padding: 1rem 1.25rem 1.125rem;
    border: 0;
    border-radius: 0;
    background: none;
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    line-height: 1.6;
    color: var(--aw-color-text);
    white-space: pre;
    font-variant-ligatures: none;
    width: max-content;
    min-width: 100%;
  }
  .aw-tbl {
    line-height: 1.3;
  }
  .aw-cmd {
    margin-bottom: 0.5rem;
    color: var(--aw-color-text-strong);
  }
  .aw-prompt {
    color: var(--aw-color-text-muted);
  }
  .aw-dim {
    color: var(--aw-color-text-muted);
  }
  .aw-head {
    color: var(--aw-color-text-secondary);
  }
  .aw-hot {
    color: var(--aw-color-complement);
  }

  .aw-caption {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--aw-step--1);
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  .aw-caption .aw-ico {
    margin-top: 0.15em;
  }
  .aw-caption em {
    font-style: normal;
    color: var(--aw-color-text-muted);
  }

  /* Points */
  .aw-points {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 3rem;
  }
  @media (min-width: 50rem) {
    .aw-points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
  .aw-point {
    padding: 1.25rem 0;
    border-top: 1px solid var(--aw-color-border);
  }
  @media (min-width: 50rem) {
    .aw-point {
      padding-bottom: 0;
    }
  }
  .aw-points h3 {
    margin: 0;
    font-size: var(--aw-step-1);
    font-weight: 520;
    letter-spacing: -0.015em;
    color: var(--aw-color-text);
    border: 0;
  }
  .aw-points p {
    margin: 0.375rem 0 0.5rem;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-secondary);
    text-wrap: pretty;
  }
  .aw-cost code,
  .aw-points code {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--aw-color-code-bg);
    font-family: var(--aw-font-mono);
    font-size: 0.875em;
    color: var(--aw-color-text);
    white-space: nowrap;
  }
  .aw-points a,
  .aw-more a {
    color: var(--aw-color-accent-text);
    text-decoration: none;
  }
  .aw-points a {
    font-size: var(--aw-step--1);
  }
  .aw-points a:hover,
  .aw-more a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .aw-more {
    margin: 1.5rem 0 0;
    font-size: var(--aw-step--1);
    line-height: 1.55;
    color: var(--aw-color-text-muted);
  }
</style>
