---
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';

const icon = (n: keyof typeof octicons, size = 16) => octicons[n].toSVG({ width: size, height: size });
const G = '/gh-aw/gallery/';

const featured = [
  { id: 'triage', title: 'Issue Triage', href: `${G}ai-issue-triage/`, text: 'Classifies new issues, spots duplicates, applies labels and asks for missing details.' },
  { id: 'review', title: 'Pull Request Review', href: `${G}automated-pr-review/`, text: 'Inspects diffs for concrete defects and posts review feedback through safe outputs.' },
  { id: 'ci', title: 'CI Failure Investigation', href: `${G}ci-failure-investigation/`, text: 'Reads failed runs, correlates logs and opens an issue with the likely cause.' },
  { id: 'docs', title: 'Documentation Maintenance', href: `${G}docs-automation/`, text: 'Detects drift between code and docs and proposes updates you can review.' },
  { id: 'report', title: 'Repository Reporting', href: `${G}ai-release-notes/`, text: 'Summarises repository or release activity on an event or a schedule.' },
  { id: 'security', title: 'Security Review', href: `${G}security-review/`, text: 'Combines repository evidence with AI judgement and reports through code scanning.' },
];

const more = [
  {
    heading: 'Maintenance',
    items: [
      { title: 'Code Improvement', href: `${G}code-improvement/`, text: 'Finds duplicated logic and proposes focused changes.' },
      { title: 'Repository Maintenance', href: 'https://github.com/githubnext/agentics/blob/main/docs/repo-assist.md', text: 'Works through a backlog with bounded tasks on a schedule.' },
      { title: 'Dependency Analysis', href: '/gh-aw/patterns/research-plan-assign-ops/', text: 'Researches upstream changes, then files prioritised follow-ups.' },
    ],
  },
  {
    heading: 'Insights',
    items: [
      { title: 'Metrics and Analytics', href: `${G}metrics-analytics/`, text: 'Stores structured snapshots of workflow activity.' },
      { title: 'Code Quality Monitoring', href: `${G}multi-repo/code-quality-monitoring/`, text: 'Analyses quality across repositories and files actionable issues.' },
    ],
  },
  {
    heading: 'Across repositories',
    items: [
      { title: 'Triage from Side Repo', href: `${G}multi-repo/triage-from-side-repo/`, text: 'Triages a main repository from an isolated side repository.' },
      { title: 'Feature Synchronization', href: `${G}multi-repo/feature-sync/`, text: 'Syncs code and configuration through reviewable pull requests.' },
      { title: 'Cross-Repository Issue Tracking', href: `${G}multi-repo/issue-tracking/`, text: 'Aggregates issue status in one central repository.' },
      { title: 'Dependabot Rollout', href: `${G}multi-repo/dependabot-rollout/`, text: 'Rolls out tailored Dependabot configuration everywhere.' },
    ],
  },
];
---

    <LandingSection id="gallery" title="What teams automate" lede="Start from a proven workflow and adapt it to your repository.">
      <ul class="aw-feat" role="list">
        {featured.map((f) => (
          <li>
            <a class="aw-item" href={f.href}>
              <div class="aw-stage" aria-hidden="true">
                <div class="aw-mock">
                {f.id === 'triage' && (<>
                  <div class="aw-head">
                    <span class="aw-badge aw-badge-open"><span set:html={icon('issue-opened', 12)} />Open</span>
                    <span class="aw-t">Crash on empty file save</span>
                    <span class="aw-m">#482</span>
                  </div>
                  <div class="aw-event">
                    <span class="aw-av" set:html={icon('hubot', 12)} />
                    <span><b>github-actions</b> added</span>
                    <span class="aw-chip"><i class="aw-dot"></i>bug</span>
                    <span class="aw-chip"><i class="aw-dot"></i>editor</span>
                  </div>
                  <div class="aw-body">
                    <span class="aw-av" set:html={icon('hubot', 12)} />
                    <span><b>github-actions</b> commented<br />Thanks! Could you share your editor version and steps to reproduce?</span>
                  </div>
                </>)}
                {f.id === 'review' && (<>
                  <div class="aw-file"><span class="aw-ico" set:html={icon('file', 12)} /><span class="aw-code">src/store.ts</span></div>
                  <div class="aw-code aw-lines">
                    <div><span class="aw-ln">41</span><span>  const items = load()</span></div>
                    <div class="aw-addrow"><span class="aw-ln">42</span><span>+ items.forEach(save)</span></div>
                    <div><span class="aw-ln">43</span><span>  return items.length</span></div>
                  </div>
                  <div class="aw-body aw-thread">
                    <span class="aw-av" set:html={icon('hubot', 12)} />
                    <span><b>github-actions</b> commented<br />Errors thrown by <code>save</code> are dropped here. Consider awaiting each call.</span>
                  </div>
                </>)}
                {f.id === 'ci' && (<>
                  <div class="aw-checks">
                    <div class="aw-check"><span class="aw-ok" set:html={icon('check-circle-fill', 14)} /><span class="aw-t">lint</span><span class="aw-m">12s</span></div>
                    <div class="aw-check"><span class="aw-ok" set:html={icon('check-circle-fill', 14)} /><span class="aw-t">build</span><span class="aw-m">48s</span></div>
                    <div class="aw-check"><span class="aw-bad" set:html={icon('x-circle-fill', 14)} /><span class="aw-t">test (ubuntu)</span><span class="aw-m">2m 3s</span></div>
                  </div>
                  <div class="aw-event">
                    <span class="aw-av" set:html={icon('hubot', 12)} />
                    <span><b>github-actions</b> opened</span>
                    <span class="aw-ok" set:html={icon('issue-opened', 14)} />
                    <span class="aw-t">Flaky db timeout <span class="aw-m">#519</span></span>
                  </div>
                </>)}
                {f.id === 'docs' && (<>
                  <div class="aw-head">
                    <span class="aw-ico" set:html={icon('git-pull-request', 16)} />
                    <span class="aw-t">docs: sync CLI flags with --help</span>
                    <span class="aw-m">#214</span>
                  </div>
                  <div class="aw-files">
                    <div class="aw-fhead">Files changed <span class="aw-m">2</span></div>
                    <div class="aw-frow"><span class="aw-code aw-t">docs/cli.md</span><span class="aw-plus">+18</span><span class="aw-minus">−6</span><span class="aw-stat"><i class="aw-s-a"></i><i class="aw-s-a"></i><i class="aw-s-a"></i><i class="aw-s-d"></i><i class="aw-s-n"></i></span></div>
                    <div class="aw-frow"><span class="aw-code aw-t">docs/flags.md</span><span class="aw-plus">+4</span><span class="aw-minus">−2</span><span class="aw-stat"><i class="aw-s-a"></i><i class="aw-s-a"></i><i class="aw-s-d"></i><i class="aw-s-n"></i><i class="aw-s-n"></i></span></div>
                  </div>
                </>)}
                {f.id === 'report' && (<>
                  <div class="aw-head">
                    <span class="aw-badge aw-badge-open"><span set:html={icon('issue-opened', 12)} />Open</span>
                    <span class="aw-t">Weekly digest · Sep 22–29</span>
                  </div>
                  <div class="aw-md">
                    <div class="aw-h">Highlights</div>
                    <ul>
                      <li>14 pull requests merged</li>
                      <li>3 bugs fixed in the editor</li>
                      <li>New contributor: <span class="aw-link">@lena</span></li>
                    </ul>
                  </div>
                </>)}
                {f.id === 'security' && (<>
                  <div class="aw-head">
                    <span class="aw-bad" set:html={icon('shield', 16)} />
                    <span class="aw-t">Unpinned third-party action</span>
                    <span class="aw-chip aw-chip-danger">High</span>
                  </div>
                  <div class="aw-file"><span class="aw-ico" set:html={icon('file', 12)} /><span class="aw-code">.github/workflows/release.yml</span></div>
                  <div class="aw-code aw-lines">
                    <div><span class="aw-ln">18</span><span>  - name: Deploy</span></div>
                    <div class="aw-hit"><span class="aw-ln">19</span><span>    uses: some-org/deploy@v2</span></div>
                  </div>
                  <div class="aw-hint"><span class="aw-ico" set:html={icon('light-bulb', 12)} />Pin to a full-length commit SHA</div>
                </>)}
                </div>
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </a>
          </li>
        ))}
      </ul>

      <div class="aw-more-bar">
        <details class="aw-more">
          <summary>
            <span class="aw-sum-closed">Show all 15 workflows</span>
            <span class="aw-sum-open">Show fewer</span>
            <span class="aw-chev" set:html={icon('chevron-down', 16)} />
          </summary>
          <div class="aw-groups">
            {more.map((g) => (
              <section>
                <h3>{g.heading}</h3>
                <ul role="list">
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href}><span class="aw-li-t">{i.title}</span><span class="aw-li-d">{i.text}</span></a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </details>
        <a class="aw-all" href="/gh-aw/gallery/">Browse the full gallery <span aria-hidden="true">→</span></a>
      </div>
    </LandingSection>

<style>
  /* Featured row: scrolls inside itself on mobile, 3x2 grid on desktop */
  .aw-feat {
    --aw-gut: clamp(1rem, 4vw, 2rem);
    list-style: none;
    margin: 2.5rem calc(-1 * var(--aw-gut)) 0;
    padding: 0 var(--aw-gut) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 20rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--aw-gut);
    scrollbar-width: none;
  }
  .aw-feat::-webkit-scrollbar {
    display: none;
  }
  .aw-feat > li {
    margin: 0;
    padding: 0;
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .aw-feat {
      margin-inline: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 2.5rem 2rem;
      overflow: visible;
    }
  }

  .aw-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
  }
  .aw-item:focus-visible,
  .aw-more summary:focus-visible,
  .aw-all:focus-visible,
  .aw-groups a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
  }
  .aw-stage {
    position: relative;
    overflow: hidden;
    height: 12.5rem;
    background: var(--aw-color-bg-subtle);
    border: 1px solid var(--aw-color-divider);
    border-radius: 12px;
    transition: border-color 0.2s;
  }
  .aw-item:hover .aw-stage {
    border-color: var(--aw-color-border-strong);
  }
  .aw-item h3 {
    margin: 1rem 0 0;
    font-size: var(--aw-step-0);
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--aw-color-text-strong);
    border: 0;
  }
  .aw-item:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .aw-item p {
    margin: 0.375rem 0 0;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--aw-color-text-muted);
    text-wrap: pretty;
  }

  /* Cropped product shots: the mock is inset top/left and runs off the right/bottom */
  .aw-mock {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    width: calc(100% + 0.25rem);
    min-height: 14rem;
    box-sizing: border-box;
    /* the overshoot past the stage edge, so text wraps inside the visible area */
    padding-right: 1.5rem;
    display: flex;
    flex-direction: column;
    background: var(--aw-color-surface);
    border: 1px solid var(--aw-color-divider);
    border-radius: 8px;
    box-shadow: var(--aw-shadow-raised);
    font-size: var(--aw-step--1);
    line-height: 1.4;
    color: var(--aw-color-text-body);
  }
  .aw-mock > * {
    padding: 0.625rem 0.875rem;
    border-top: 1px solid var(--aw-color-divider);
    white-space: nowrap;
  }
  .aw-mock > :first-child {
    border-top: 0;
  }
  .aw-mock b {
    font-weight: 550;
    color: var(--aw-color-text-strong);
  }
  .aw-head,
  .aw-event,
  .aw-check,
  .aw-frow,
  .aw-file,
  .aw-hint,
  .aw-fhead {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .aw-head .aw-t {
    font-size: var(--aw-step-0);
  }
  .aw-t {
    flex: none;
    font-weight: 550;
    color: var(--aw-color-text-strong);
    min-width: 0;
  }
  .aw-m {
    flex: none;
    color: var(--aw-color-text-muted);
    font-weight: 400;
  }
  .aw-ico,
  .aw-ok,
  .aw-bad,
  .aw-av {
    display: inline-flex;
    flex: none;
    color: var(--aw-color-text-muted);
  }
  .aw-ok { color: var(--aw-color-success); }
  .aw-bad { color: var(--aw-color-danger); }
  .aw-mock :global(svg) {
    fill: currentColor;
  }
  .aw-av {
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--aw-color-bg-subtle);
    border: 1px solid var(--aw-color-border);
    color: var(--aw-color-text-secondary);
  }
  .aw-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    font-weight: 550;
  }
  .aw-badge-open {
    background: var(--aw-color-success);
    color: var(--aw-color-surface);
  }
  .aw-event {
    background: var(--aw-color-bg-subtle);
    color: var(--aw-color-text-muted);
  }
  .aw-body {
    white-space: normal;
    text-wrap: pretty;
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .aw-body .aw-av {
    margin-top: 0.125rem;
  }
  .aw-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    border: 1px solid var(--aw-color-border);
    border-radius: 999px;
    color: var(--aw-color-text-secondary);
    white-space: nowrap;
  }
  .aw-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--aw-color-text-muted);
  }
  .aw-chip-danger {
    border-color: var(--aw-color-danger);
    color: var(--aw-color-danger);
    font-weight: 550;
  }
  .aw-code,
  .aw-lines {
    font-family: var(--aw-font-mono);
  }
  .aw-lines {
    padding: 0.25rem 0;
    background: var(--aw-color-surface-header);
  }
  .aw-lines > div {
    display: flex;
    gap: 0.75rem;
    padding: 0 0.875rem;
  }
  .aw-ln {
    width: 1.5rem;
    flex: none;
    text-align: right;
    color: var(--aw-color-text-muted);
  }
  .aw-addrow,
  .aw-hit {
    color: var(--aw-color-text-strong);
  }
  .aw-addrow {
    background: color-mix(in srgb, var(--aw-color-success) 16%, transparent);
  }
  .aw-hit {
    background: color-mix(in srgb, var(--aw-color-danger) 14%, transparent);
  }
  .aw-mock code {
    padding: 0;
    background: none;
    border: 0;
    font-size: inherit;
  }
  .aw-thread {
    padding-left: 2.5rem;
  }
  .aw-checks {
    padding: 0;
  }
  .aw-check {
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--aw-color-divider);
  }
  .aw-check:first-child {
    border-top: 0;
  }
  .aw-check .aw-t {
    flex: 1 0 auto;
    font-weight: 500;
  }
  .aw-files {
    padding: 0;
  }
  .aw-fhead {
    padding: 0.5rem 0.875rem;
    background: var(--aw-color-surface-header);
    font-weight: 550;
    color: var(--aw-color-text-strong);
  }
  .aw-frow {
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--aw-color-divider);
  }
  .aw-frow .aw-t {
    flex: 1 0 auto;
    font-weight: 400;
  }
  .aw-plus { color: var(--aw-color-success); }
  .aw-minus { color: var(--aw-color-danger); }
  .aw-stat {
    display: inline-flex;
    gap: 2px;
  }
  .aw-stat i {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--aw-color-border);
  }
  .aw-stat .aw-s-a { background: var(--aw-color-success); }
  .aw-stat .aw-s-d { background: var(--aw-color-danger); }
  .aw-md .aw-h {
    padding-bottom: 0.375rem;
    margin-bottom: 0.375rem;
    border-bottom: 1px solid var(--aw-color-divider);
    font-size: var(--aw-step-0);
    font-weight: 600;
    color: var(--aw-color-text-strong);
  }
  .aw-md ul {
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .aw-md li {
    margin: 0;
    padding: 0;
  }
  .aw-link {
    color: var(--aw-color-link);
  }
  .aw-hint {
    color: var(--aw-color-text-muted);
  }

  /* Disclosure */
  .aw-more-bar {
    margin-top: 3rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .aw-more {
    width: 100%;
  }
  .aw-more summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--aw-color-border-strong);
    border-radius: 8px;
    background: var(--aw-color-surface);
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-strong);
    cursor: pointer;
    user-select: none;
  }
  .aw-more summary::-webkit-details-marker {
    display: none;
  }
  .aw-more summary:hover {
    background: var(--aw-color-bg-subtle);
  }
  .aw-sum-open,
  .aw-more[open] .aw-sum-closed {
    display: none;
  }
  .aw-more[open] .aw-sum-open {
    display: inline;
  }
  .aw-chev {
    display: inline-flex;
    color: var(--aw-color-text-muted);
    transition: transform 0.2s;
  }
  .aw-chev :global(svg) {
    fill: currentColor;
  }
  .aw-more[open] .aw-chev {
    transform: rotate(180deg);
  }
  @media (min-width: 40rem) {
    .aw-all {
      position: absolute;
      top: 0;
      right: 0;
      line-height: 2.5rem;
    }
  }
  .aw-all {
    font-size: var(--aw-step-0);
    color: var(--aw-color-accent-text);
    text-decoration: none;
    border-radius: 4px;
  }
  .aw-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .aw-groups {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .aw-groups h3 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--aw-color-divider);
    font-size: var(--aw-step--1);
    font-weight: 550;
    color: var(--aw-color-text-muted);
  }
  .aw-groups ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .aw-groups li {
    margin: 0;
    padding: 0;
  }
  .aw-groups a {
    display: block;
    padding: 0.625rem 0;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
  }
  .aw-li-t {
    display: block;
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-strong);
  }
  .aw-groups a:hover .aw-li-t {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .aw-li-d {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--aw-step--1);
    line-height: 1.45;
    color: var(--aw-color-text-muted);
  }
  @media (max-width: 52rem) {
    .aw-groups {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aw-chev, .aw-stage { transition: none; }
  }
</style>
