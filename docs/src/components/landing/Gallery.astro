---
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';

const icon = (n: keyof typeof octicons, size = 16) => octicons[n].toSVG({ width: size, height: size });
const G = '/gh-aw/gallery/';

const featured = [
  { id: 'triage', title: 'Issue Triage', href: `${G}ai-issue-triage/`, text: 'Classifies new issues, spots duplicates, applies labels and asks for missing details.' },
  { id: 'review', title: 'Pull Request Review', href: `${G}automated-pr-review/`, text: 'Inspects diffs for concrete defects and posts review feedback through safe outputs.' },
  { id: 'ci', title: 'CI Failure Investigation', href: `${G}ci-failure-investigation/`, text: 'Reads failed runs, correlates logs and opens an issue with the likely cause.' },
  { id: 'docs', title: 'Documentation Maintenance', href: `${G}docs-automation/`, text: 'Detects drift between code and docs and proposes updates you can review.' },
  { id: 'report', title: 'Repository Reporting', href: `${G}ai-release-notes/`, text: 'Summarises repository or release activity on an event or a schedule.' },
  { id: 'security', title: 'Security Review', href: `${G}security-review/`, text: 'Combines repository evidence with AI judgement and reports through code scanning.' },
];

const more = [
  {
    heading: 'Maintenance',
    items: [
      { title: 'Code Improvement', href: `${G}code-improvement/`, text: 'Finds duplicated logic and proposes focused changes.' },
      { title: 'Repository Maintenance', href: 'https://github.com/githubnext/agentics/blob/main/docs/repo-assist.md', text: 'Works through a backlog with bounded tasks on a schedule.' },
      { title: 'Dependency Analysis', href: '/gh-aw/patterns/research-plan-assign-ops/', text: 'Researches upstream changes, then files prioritised follow-ups.' },
    ],
  },
  {
    heading: 'Insights',
    items: [
      { title: 'Metrics and Analytics', href: `${G}metrics-analytics/`, text: 'Stores structured snapshots of workflow activity.' },
      { title: 'Code Quality Monitoring', href: `${G}multi-repo/code-quality-monitoring/`, text: 'Analyses quality across repositories and files actionable issues.' },
    ],
  },
  {
    heading: 'Across repositories',
    items: [
      { title: 'Triage from Side Repo', href: `${G}multi-repo/triage-from-side-repo/`, text: 'Triages a main repository from an isolated side repository.' },
      { title: 'Feature Synchronization', href: `${G}multi-repo/feature-sync/`, text: 'Syncs code and configuration through reviewable pull requests.' },
      { title: 'Cross-Repository Issue Tracking', href: `${G}multi-repo/issue-tracking/`, text: 'Aggregates issue status in one central repository.' },
      { title: 'Dependabot Rollout', href: `${G}multi-repo/dependabot-rollout/`, text: 'Rolls out tailored Dependabot configuration everywhere.' },
    ],
  },
];
---

    <LandingSection id="gallery" title="What teams automate" lede="Start from a proven workflow and adapt it to your repository.">
      <ul class="aw-feat" role="list">
        {featured.map((f) => (
          <li>
            <a class="aw-item" href={f.href}>
              <div class="aw-stage" aria-hidden="true">
                <div class={`gh gh-${f.id}`}>
                {f.id === 'triage' && (<>
                  <div class="gh-head">
                    <div class="gh-title">Crash on empty file save <span class="gh-num">#482</span></div>
                    <div class="gh-meta">
                      <span class="gh-state"><span set:html={icon('issue-opened', 14)} />Open</span>
                      <span><b>mona</b> opened 1 hour ago</span>
                    </div>
                  </div>
                  <div class="gh-tl">
                    <div class="gh-ev">
                      <span class="gh-badge" set:html={icon('tag', 16)} />
                      <span class="gh-ev-text">
                        <span class="gh-av gh-av-sm" set:html={icon('mark-github', 12)} />
                        <b>github-actions</b> added
                        <span class="gh-lbl gh-lbl-red">bug</span>
                        <span class="gh-lbl gh-lbl-blue">editor</span>
                      </span>
                    </div>
                    <div class="gh-cm">
                      <span class="gh-av" set:html={icon('mark-github', 16)} />
                      <div class="gh-box">
                        <div class="gh-box-head"><b>github-actions</b><span class="gh-bot">bot</span><span class="gh-muted">commented now</span></div>
                        <div class="gh-box-body">Thanks! Could you share your editor version and steps to reproduce?</div>
                      </div>
                    </div>
                  </div>
                </>)}
                {f.id === 'review' && (<>
                  <div class="gh-fh">
                    <span class="gh-muted" set:html={icon('chevron-down', 16)} />
                    <span class="gh-mono">src/store.ts</span>
                    <span class="gh-add-n">+1</span><span class="gh-del-n">−1</span>
                  </div>
                  <div class="gh-diff">
                    <div class="gh-dl gh-hunk"><span class="gh-ln"></span><span class="gh-ln"></span><span class="gh-sg"></span><span class="gh-cd">@@ -41,3 +41,3 @@ persist()</span></div>
                    <div class="gh-dl gh-del"><span class="gh-ln">42</span><span class="gh-ln"></span><span class="gh-sg">-</span><span class="gh-cd">  await all(items, save)</span></div>
                    <div class="gh-dl gh-add"><span class="gh-ln"></span><span class="gh-ln">42</span><span class="gh-sg">+</span><span class="gh-cd">  items.forEach(save)</span></div>
                    <div class="gh-thread">
                      <div class="gh-box">
                        <div class="gh-box-body">
                          <div class="gh-thread-head"><span class="gh-av gh-av-sm" set:html={icon('mark-github', 12)} /><b>github-actions</b><span class="gh-bot">bot</span><span class="gh-muted">now</span></div>
                          <code>forEach</code> won’t await <code>save</code>, so its errors are dropped.
                        </div>
                      </div>
                    </div>
                  </div>
                </>)}
                {f.id === 'ci' && (<>
                  <div class="gh-tl gh-tl-top">
                    <div class="gh-ev">
                      <span class="gh-badge" set:html={icon('cross-reference', 16)} />
                      <span class="gh-ev-text">
                        <span class="gh-av gh-av-sm" set:html={icon('mark-github', 12)} />
                        <b>github-actions</b> mentioned this
                      </span>
                    </div>
                    <div class="gh-ev-ref">
                      <span class="gh-ok" set:html={icon('issue-opened', 16)} />
                      <b>Flaky db timeout</b><span class="gh-muted">#519</span>
                    </div>
                  </div>
                  <div class="gh-box gh-merge">
                    <div class="gh-merge-head">
                      <span class="gh-merge-ico" set:html={icon('x', 16)} />
                      <span><b>Some checks were not successful</b><br /><span class="gh-muted">1 failing, 1 skipped, 2 successful</span></span>
                    </div>
                    <div class="gh-run"><span class="gh-bad" set:html={icon('x-circle-fill', 16)} /><span><b>CI / test (ubuntu)</b> <span class="gh-muted">Failing after 2m</span></span><span class="gh-link">Details</span></div>
                    <div class="gh-run"><span class="gh-muted" set:html={icon('skip', 16)} /><span><b>CI / deploy</b> <span class="gh-muted">Skipped</span></span><span class="gh-link">Details</span></div>
                    <div class="gh-run"><span class="gh-ok" set:html={icon('check-circle-fill', 16)} /><span><b>CI / lint</b> <span class="gh-muted">Successful in 12s</span></span><span class="gh-link">Details</span></div>
                  </div>
                </>)}
                {f.id === 'docs' && (<>
                  <div class="gh-head">
                    <div class="gh-title">docs: sync CLI flags with --help <span class="gh-num">#214</span></div>
                    <div class="gh-meta">
                      <span class="gh-state"><span set:html={icon('git-pull-request', 14)} />Open</span>
                      <span>into <span class="gh-ref">main</span> from <span class="gh-ref">docs/cli-flags</span></span>
                    </div>
                  </div>
                  <div class="gh-tabs">
                    <span><span set:html={icon('git-commit', 16)} />Commits <span class="gh-count">1</span></span>
                    <span class="gh-tab-on"><span set:html={icon('file-diff', 16)} />Files changed <span class="gh-count">2</span></span>
                  </div>
                  <div class="gh-files">
                    <div class="gh-fh"><span class="gh-muted" set:html={icon('chevron-down', 16)} /><span class="gh-mono">docs/cli.md</span><span class="gh-add-n">+18</span><span class="gh-del-n">−6</span><span class="gh-stat"><i class="a"></i><i class="a"></i><i class="a"></i><i class="d"></i><i></i></span></div>
                    <div class="gh-fh"><span class="gh-muted" set:html={icon('chevron-down', 16)} /><span class="gh-mono">docs/flags.md</span><span class="gh-add-n">+4</span><span class="gh-del-n">−2</span><span class="gh-stat"><i class="a"></i><i class="a"></i><i class="a"></i><i class="d"></i><i></i></span></div>
                  </div>
                </>)}
                {f.id === 'report' && (<>
                  <div class="gh-head">
                    <div class="gh-title">Weekly digest: Sep 22–29 <span class="gh-num">#530</span></div>
                    <div class="gh-meta">
                      <span class="gh-state"><span set:html={icon('issue-opened', 14)} />Open</span>
                      <span><b>github-actions</b> opened yesterday</span>
                    </div>
                  </div>
                  <div class="gh-cm gh-cm-top">
                    <span class="gh-av" set:html={icon('mark-github', 16)} />
                    <div class="gh-box">
                      <div class="gh-box-head"><b>github-actions</b><span class="gh-bot">bot</span><span class="gh-muted">opened yesterday</span></div>
                      <div class="gh-box-body gh-md">
                        <div class="gh-h3">Highlights</div>
                        <ul>
                          <li>14 pull requests merged</li>
                          <li>3 bugs fixed in the editor</li>
                          <li>New contributor: <span class="gh-link">@lena</span></li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </>)}
                {f.id === 'security' && (<>
                  <div class="gh-head">
                    <div class="gh-title">Unpinned third-party action</div>
                    <div class="gh-meta">
                      <span class="gh-state"><span set:html={icon('shield', 14)} />Open</span>
                      <span class="gh-sev">High</span>
                      <span>in <span class="gh-ref">main</span> 2 days ago</span>
                    </div>
                  </div>
                  <div class="gh-box gh-loc">
                    <div class="gh-box-head gh-mono">.github/workflows/release.yml:19</div>
                    <div class="gh-diff">
                      <div class="gh-dl gh-dl-1"><span class="gh-ln">18</span><span class="gh-cd">  - name: Deploy</span></div>
                      <div class="gh-dl gh-dl-1"><span class="gh-ln">19</span><span class="gh-cd">    uses: some-org/deploy@v2</span></div>
                    </div>
                    <div class="gh-annot">
                      <span class="gh-sev-ico" set:html={icon('alert', 16)} />
                      <span>Step uses <code>some-org/deploy</code> with ref <code>v2</code>, not a pinned commit hash</span>
                    </div>
                  </div>
                </>)}
                </div>
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </a>
          </li>
        ))}
      </ul>


      <div class="aw-more-bar">
        <details class="aw-more">
          <summary>
            <span class="aw-sum-closed">Show all 15 workflows</span>
            <span class="aw-sum-open">Show fewer</span>
            <span class="aw-chev" set:html={icon('chevron-down', 16)} />
          </summary>
          <div class="aw-groups">
            {more.map((g) => (
              <section>
                <h3>{g.heading}</h3>
                <ul role="list">
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href}><span class="aw-li-t">{i.title}</span><span class="aw-li-d">{i.text}</span></a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </details>
        <a class="aw-all" href="/gh-aw/gallery/">Browse the full gallery <span aria-hidden="true">→</span></a>
      </div>
    </LandingSection>

<style>
  /* Featured row: scrolls inside itself on mobile, 3x2 grid on desktop */
  .aw-feat {
    --aw-gut: clamp(1rem, 4vw, 2rem);
    list-style: none;
    margin: 2.5rem calc(-1 * var(--aw-gut)) 0;
    padding: 0 var(--aw-gut) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 20rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--aw-gut);
    scrollbar-width: none;
  }
  .aw-feat::-webkit-scrollbar {
    display: none;
  }
  .aw-feat > li {
    margin: 0;
    padding: 0;
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .aw-feat {
      margin-inline: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 2.5rem 2rem;
      overflow: visible;
    }
  }

  .aw-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
  }
  .aw-item:focus-visible,
  .aw-more summary:focus-visible,
  .aw-all:focus-visible,
  .aw-groups a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
  }
  .aw-stage {
    position: relative;
    overflow: hidden;
    height: 14rem;
    background: var(--aw-color-bg-subtle);
    border: 1px solid var(--aw-color-divider);
    border-radius: 12px;
    transition: border-color 0.2s;
  }
  .aw-item:hover .aw-stage {
    border-color: var(--aw-color-border-strong);
  }
  .aw-item h3 {
    margin: 1.125rem 0 0;
    font-size: var(--aw-step-0);
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--aw-color-text-strong);
    border: 0;
  }
  .aw-item:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .aw-item p {
    margin: 0.5rem 0 0;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-muted);
    text-wrap: pretty;
  }

  /* GitHub UI mocks ---------------------------------------------------------
     Cropped product shots in GitHub's Primer style. The palette below derives
     GitHub's cool neutrals and functional colours from site tokens, so the
     mocks read as github.com in both themes. Dark values first. */
  .gh {
    --gh-canvas: color-mix(in srgb, var(--aw-gray-13) 93%, var(--aw-blue-6));
    --gh-subtle: color-mix(in srgb, var(--aw-gray-12) 90%, var(--aw-blue-6));
    --gh-border: color-mix(in srgb, var(--aw-gray-9) 90%, var(--aw-blue-6));
    --gh-border-muted: color-mix(in srgb, var(--aw-gray-10) 90%, var(--aw-blue-6));
    --gh-fg: color-mix(in srgb, var(--aw-gray-1) 96%, var(--aw-blue-6));
    --gh-muted: color-mix(in srgb, var(--aw-gray-5) 88%, var(--aw-blue-6));
    --gh-neutral: color-mix(in srgb, var(--aw-gray-8) 85%, var(--aw-blue-6));
    --gh-accent: color-mix(in srgb, var(--aw-blue-6) 75%, var(--gh-fg));
    --gh-success: color-mix(in srgb, var(--aw-green-6) 85%, var(--gh-fg));
    --gh-success-em: color-mix(in srgb, var(--aw-green-6) 85%, var(--aw-gray-13));
    --gh-danger: var(--aw-red-5);
    --gh-severe: var(--aw-coral-4);
    --gh-tab-line: var(--aw-coral-4);
    --gh-add-bg: color-mix(in srgb, var(--aw-green-6) 15%, var(--gh-canvas));
    --gh-add-num: color-mix(in srgb, var(--aw-green-6) 30%, var(--gh-canvas));
    --gh-del-bg: color-mix(in srgb, var(--aw-red-5) 12%, var(--gh-canvas));
    --gh-del-num: color-mix(in srgb, var(--aw-red-5) 25%, var(--gh-canvas));
    --gh-hunk-bg: color-mix(in srgb, var(--aw-blue-6) 12%, var(--gh-canvas));
    --gh-hunk-num: color-mix(in srgb, var(--aw-blue-6) 25%, var(--gh-canvas));

    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    width: calc(100% + 0.25rem);
    min-height: 15rem;
    box-sizing: border-box;
    /* the overshoot past the stage edge, so content wraps inside the visible area */
    padding: 0.875rem 2.5rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--gh-canvas);
    border: 1px solid var(--gh-border);
    border-radius: 6px;
    box-shadow: var(--aw-shadow-raised);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--gh-fg);
    white-space: nowrap;
  }
  :global(:root[data-theme='light']) .gh {
    --gh-canvas: var(--aw-gray-0);
    --gh-subtle: color-mix(in srgb, var(--aw-gray-0) 97%, var(--aw-blue-6));
    --gh-border: color-mix(in srgb, var(--aw-gray-3) 90%, var(--aw-blue-6));
    --gh-border-muted: color-mix(in srgb, var(--aw-gray-2) 92%, var(--aw-blue-6));
    --gh-fg: color-mix(in srgb, var(--aw-gray-12) 95%, var(--aw-blue-6));
    --gh-muted: color-mix(in srgb, var(--aw-gray-7) 85%, var(--aw-blue-6));
    --gh-neutral: color-mix(in srgb, var(--aw-gray-3) 92%, var(--aw-blue-6));
    --gh-accent: var(--aw-blue-6);
    --gh-success: color-mix(in srgb, var(--aw-green-6) 80%, var(--aw-gray-13));
    --gh-danger: color-mix(in srgb, var(--aw-red-5) 82%, var(--aw-gray-13));
    --gh-severe: var(--aw-coral-6);
    --gh-add-bg: color-mix(in srgb, var(--aw-green-6) 13%, var(--gh-canvas));
    --gh-add-num: color-mix(in srgb, var(--aw-green-6) 24%, var(--gh-canvas));
    --gh-del-bg: color-mix(in srgb, var(--aw-red-5) 10%, var(--gh-canvas));
    --gh-del-num: color-mix(in srgb, var(--aw-red-5) 20%, var(--gh-canvas));
    --gh-hunk-bg: color-mix(in srgb, var(--aw-blue-6) 9%, var(--gh-canvas));
    --gh-hunk-num: color-mix(in srgb, var(--aw-blue-6) 18%, var(--gh-canvas));
  }
  .gh :global(svg) {
    display: block;
    fill: currentColor;
  }
  .gh b {
    font-weight: 600;
    color: var(--gh-fg);
  }
  .gh code,
  .gh-mono {
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
  }
  .gh code {
    padding: 0.1em 0.35em;
    border: 0;
    border-radius: 6px;
    background: color-mix(in srgb, var(--gh-muted) 20%, transparent);
    font-size: var(--aw-step--1);
  }
  .gh-muted { color: var(--gh-muted); }
  .gh-ok { color: var(--gh-success); }
  .gh-bad { color: var(--gh-danger); }
  .gh-link { color: var(--gh-accent); }

  /* Issue / PR header */
  .gh-head {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gh-border);
  }
  .gh-title {
    font-size: var(--aw-step-0);
    font-weight: 400;
    line-height: 1.3;
    color: var(--gh-fg);
  }
  .gh-num {
    color: var(--gh-muted);
    font-weight: 300;
  }
  .gh-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gh-muted);
  }
  .gh-meta b { color: var(--gh-muted); }
  .gh-state {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.25rem;
    height: 1.625rem;
    padding: 0 0.625rem 0 0.5rem;
    border-radius: 2em;
    background: var(--gh-success-em);
    color: var(--aw-gray-0);
    font-weight: 500;
  }
  .gh-ref {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--gh-accent) 15%, transparent);
    color: var(--gh-accent);
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
  }

  /* Avatars: the GitHub mark in a circle */
  .gh-av {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gh-canvas);
    box-shadow: 0 0 0 1px var(--gh-border);
    color: var(--gh-fg);
  }
  .gh-av-sm {
    width: 1.25rem;
    height: 1.25rem;
    vertical-align: middle;
  }
  .gh-bot {
    padding: 0 0.375rem;
    border: 1px solid var(--gh-border);
    border-radius: 2em;
    color: var(--gh-muted);
    font-size: var(--aw-step--1);
    line-height: 1.5;
    font-weight: 500;
  }

  /* Timeline: a 2px rail with circular event badges sitting on it */
  .gh-tl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: -0.75rem;
    padding-top: 0.625rem;
  }
  .gh-tl::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: -2rem;
    left: calc(1rem - 1px);
    width: 2px;
    background: var(--gh-border-muted);
  }
  .gh-ev {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--gh-muted);
  }
  .gh-ev-text {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .gh-badge {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gh-subtle);
    box-shadow: 0 0 0 2px var(--gh-canvas);
    color: var(--gh-muted);
  }
  .gh-ev-ref {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: -0.5rem;
    padding-left: 2.75rem;
  }
  .gh-lbl {
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
    border: 1px solid transparent;
    border-radius: 2em;
    font-size: var(--aw-step--1);
    font-weight: 500;
    line-height: 1.5;
    --lbl-fg: color-mix(in srgb, var(--lbl) 55%, var(--gh-fg));
    background: color-mix(in srgb, var(--lbl) 18%, transparent);
    border-color: color-mix(in srgb, var(--lbl) 30%, transparent);
    color: var(--lbl-fg);
  }
