---
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';

const icon = (n: keyof typeof octicons, size = 16) => octicons[n].toSVG({ width: size, height: size });
const G = '/gh-aw/gallery/';

const featured = [
  { id: 'triage', title: 'Issue Triage', href: `${G}ai-issue-triage/`, text: 'Classifies new issues, spots duplicates, applies labels and asks for missing details.' },
  { id: 'review', title: 'Pull Request Review', href: `${G}automated-pr-review/`, text: 'Inspects diffs for concrete defects and posts review feedback through safe outputs.' },
  { id: 'ci', title: 'CI Failure Investigation', href: `${G}ci-failure-investigation/`, text: 'Reads failed runs, correlates logs and opens an issue with the likely cause.' },
  { id: 'docs', title: 'Documentation Maintenance', href: `${G}docs-automation/`, text: 'Detects drift between code and docs and proposes updates you can review.' },
];

const more = [
  {
    heading: 'Maintenance',
    items: [
      { title: 'Code Improvement', href: `${G}code-improvement/`, text: 'Finds duplicated logic and proposes focused changes.' },
      { title: 'Repository Maintenance', href: 'https://github.com/githubnext/agentics/blob/main/docs/repo-assist.md', text: 'Works through a backlog with bounded tasks on a schedule.' },
      { title: 'Security Review', href: `${G}security-review/`, text: 'Reviews repository evidence and reports through code scanning.' },
      { title: 'Dependency Analysis', href: '/gh-aw/patterns/research-plan-assign-ops/', text: 'Researches upstream changes, then files prioritised follow-ups.' },
    ],
  },
  {
    heading: 'Insights',
    items: [
      { title: 'Repository Reporting', href: `${G}ai-release-notes/`, text: 'Summarises repository or release activity on a schedule.' },
      { title: 'Metrics and Analytics', href: `${G}metrics-analytics/`, text: 'Stores structured snapshots of workflow activity.' },
      { title: 'Code Quality Monitoring', href: `${G}multi-repo/code-quality-monitoring/`, text: 'Analyses quality across repositories and files actionable issues.' },
    ],
  },
  {
    heading: 'Across repositories',
    items: [
      { title: 'Triage from Side Repo', href: `${G}multi-repo/triage-from-side-repo/`, text: 'Triages a main repository from an isolated side repository.' },
      { title: 'Feature Synchronization', href: `${G}multi-repo/feature-sync/`, text: 'Syncs code and configuration through reviewable pull requests.' },
      { title: 'Cross-Repository Issue Tracking', href: `${G}multi-repo/issue-tracking/`, text: 'Aggregates issue status in one central repository.' },
      { title: 'Dependabot Rollout', href: `${G}multi-repo/dependabot-rollout/`, text: 'Rolls out tailored Dependabot configuration everywhere.' },
    ],
  },
];
---

    <LandingSection id="gallery" title="What teams automate" lede="Start from a proven workflow and adapt it to your repository.">
      <ul class="aw-feat" role="list">
        {featured.map((f) => (
          <li>
            <a class="aw-item" href={f.href}>
              <div class="aw-stage" aria-hidden="true">
                <div class={`gh gh-${f.id}`}>
                {f.id === 'triage' && (<>
                  <div class="gh-head">
                    <div class="gh-title">Crash on empty file save <span class="gh-num">#482</span></div>
                    <span class="gh-state"><span set:html={icon('issue-opened', 14)} />Open</span>
                  </div>
                  <div class="gh-tl">
                    <div class="gh-ev">
                      <span class="gh-badge" set:html={icon('tag', 16)} />
                      <span class="gh-ev-t"><b>github-actions</b> added <span class="gh-lbl gh-lbl-red">bug</span> <span class="gh-lbl gh-lbl-blue">editor</span></span>
                    </div>
                    <div class="gh-cm">
                      <span class="gh-av" set:html={icon('mark-github', 16)} />
                      <div class="gh-box">
                        <div class="gh-box-head"><b>github-actions</b><span class="gh-hide-sm"> commented</span></div>
                        <div class="gh-box-body">Thanks! Which editor version are you on?</div>
                      </div>
                    </div>
                  </div>
                </>)}
                {f.id === 'review' && (<>
                  <div class="gh-file">
                    <div class="gh-fh">
                      <span class="gh-muted" set:html={icon('chevron-down', 16)} />
                      <span class="gh-mono">src/store.ts</span>
                    </div>
                    <div class="gh-diff">
                      <div class="gh-dl"><span class="gh-ln">41</span><span class="gh-ln">41</span><span class="gh-sg"></span><span class="gh-cd">const ids = load()</span></div>
                      <div class="gh-dl gh-del"><span class="gh-ln">42</span><span class="gh-ln"></span><span class="gh-sg">-</span><span class="gh-cd">await saveAll(ids)</span></div>
                      <div class="gh-dl gh-add"><span class="gh-ln"></span><span class="gh-ln">42</span><span class="gh-sg">+</span><span class="gh-cd">ids.forEach(save)</span></div>
                    </div>
                    <div class="gh-thread">
                      <div class="gh-thread-head"><span class="gh-av gh-av-sm" set:html={icon('mark-github', 12)} /><b>github-actions</b></div>
                      <p><code>forEach</code> won’t wait for <code>save</code>, so failed saves are silently dropped.</p>
                    </div>
                  </div>
                </>)}
                {f.id === 'ci' && (<>
                  <div class="gh-box gh-merge">
                    <div class="gh-merge-head">
                      <span class="gh-merge-ico" set:html={icon('x', 16)} />
                      <span><b>Some checks were not successful</b><br /><span class="gh-muted">1 failing and 1 successful check</span></span>
                    </div>
                    <div class="gh-run"><span class="gh-bad" set:html={icon('x-circle-fill', 16)} /><b>CI / test</b><span class="gh-muted">Failing after 2m</span></div>
                    <div class="gh-run"><span class="gh-ok" set:html={icon('check-circle-fill', 16)} /><b>CI / lint</b><span class="gh-muted">Successful in 12s</span></div>
                  </div>
                  <div class="gh-tl">
                    <div class="gh-ev">
                      <span class="gh-badge" set:html={icon('issue-opened', 16)} />
                      <span class="gh-ev-t"><b>github-actions</b> opened <b>Flaky db timeout</b> <span class="gh-num">#519</span></span>
                    </div>
                  </div>
                </>)}
                {f.id === 'docs' && (<>
                  <div class="gh-head">
                    <div class="gh-title">docs: sync CLI flags with --help <span class="gh-num">#214</span></div>
                    <span class="gh-state"><span set:html={icon('git-pull-request', 14)} />Open</span>
                  </div>
                  <div class="gh-box gh-files">
                    <div class="gh-frow"><span class="gh-mono">docs/cli.md</span><span class="gh-add-n">+18</span><span class="gh-del-n">−6</span><span class="gh-stat"><i class="a"></i><i class="a"></i><i class="a"></i><i class="d"></i><i></i></span></div>
                    <div class="gh-frow"><span class="gh-mono">docs/flags.md</span><span class="gh-add-n">+4</span><span class="gh-del-n">−2</span><span class="gh-stat"><i class="a"></i><i class="a"></i><i class="d"></i><i></i><i></i></span></div>
                  </div>
                </>)}
                </div>
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </a>
          </li>
        ))}
      </ul>


      <div class="aw-more-bar">
        <details class="aw-more">
          <summary>
            <span class="aw-sum-closed">Show all 15 workflows</span>
            <span class="aw-sum-open">Show fewer</span>
            <span class="aw-chev" set:html={icon('chevron-down', 16)} />
          </summary>
          <div class="aw-groups">
            {more.map((g) => (
              <section>
                <h3>{g.heading}</h3>
                <ul role="list">
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href}><span class="aw-li-t">{i.title}</span><span class="aw-li-d">{i.text}</span></a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </details>
        <a class="aw-all" href="/gh-aw/gallery/">Browse the full gallery <span aria-hidden="true">→</span></a>
      </div>
    </LandingSection>

<style>
  /* Featured row: scrolls inside itself on mobile, 2x2 grid on desktop */
  .aw-feat {
    --aw-gut: clamp(1rem, 4vw, 2rem);
    list-style: none;
    margin: 2.5rem calc(-1 * var(--aw-gut)) 0;
    padding: 0 var(--aw-gut) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(86%, 24rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--aw-gut);
    scrollbar-width: none;
  }
  .aw-feat::-webkit-scrollbar {
    display: none;
  }
  .aw-feat > li {
    margin: 0;
    padding: 0;
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (min-width: 48rem) {
    .aw-feat {
      margin-inline: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 3.5rem 2.5rem;
      overflow: visible;
    }
  }

  .aw-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: 16px;
  }
  .aw-item:focus-visible,
  .aw-more summary:focus-visible,
  .aw-all:focus-visible,
  .aw-groups a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
  }
  .aw-stage {
    position: relative;
    overflow: hidden;
    background: var(--aw-color-bg-subtle);
    border: 1px solid var(--aw-color-divider);
    border-radius: 16px;
    transition: border-color 0.2s;
  }
  @media (min-width: 48rem) {
    .aw-stage { height: 19rem; }
  }
  .aw-item:hover .aw-stage {
    border-color: var(--aw-color-border-strong);
  }
  .aw-item h3 {
    margin: 1.25rem 0 0;
    font-size: var(--aw-step-0);
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--aw-color-text-strong);
    border: 0;
  }
  .aw-item:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .aw-item p {
    margin: 0.5rem 0 0;
    max-width: 36rem;
    font-size: var(--aw-step-0);
    line-height: 1.55;
    color: var(--aw-color-text-muted);
    text-wrap: pretty;
  }

  /* GitHub UI mocks ---------------------------------------------------------
     Cropped product shots in GitHub's Primer style. GitHub's cool neutrals and
     functional colours are derived from site tokens. Dark values first. */
  .gh {
    --gh-canvas: var(--aw-gray-13);
    --gh-subtle: var(--aw-gray-12);
    --gh-border: var(--aw-gray-9);
    --gh-rail: var(--aw-gray-10);
    --gh-fg: var(--aw-gray-1);
    --gh-muted: var(--aw-gray-5);
    --gh-neutral: var(--aw-gray-8);
    --gh-success: color-mix(in srgb, var(--aw-green-6) 85%, var(--gh-fg));
    --gh-success-em: color-mix(in srgb, var(--aw-green-6) 85%, var(--aw-gray-13));
    --gh-danger: var(--aw-red-5);
    --gh-add-bg: color-mix(in srgb, var(--aw-green-6) 15%, var(--gh-canvas));
    --gh-add-num: color-mix(in srgb, var(--aw-green-6) 30%, var(--gh-canvas));
    --gh-del-bg: color-mix(in srgb, var(--aw-red-5) 12%, var(--gh-canvas));
    --gh-del-num: color-mix(in srgb, var(--aw-red-5) 25%, var(--gh-canvas));
    --gh-r: 8px;

    position: absolute;
    top: 2rem;
    left: 2rem;
    width: calc(100% + 0.5rem);
    min-height: calc(100% + 1rem);
    box-sizing: border-box;
    /* the overshoot past the stage edge, so content stays inside the visible area */
    padding: 1.25rem 4rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--gh-canvas);
    border: 1px solid var(--gh-border);
    border-radius: 12px;
    box-shadow: var(--aw-shadow-raised);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--gh-fg);
    white-space: nowrap;
  }
  :global(:root[data-theme='light']) .gh {
    --gh-canvas: var(--aw-gray-0);
    --gh-subtle: var(--aw-gray-0);
    --gh-border: var(--aw-gray-3);
    --gh-rail: var(--aw-gray-2);
    --gh-fg: var(--aw-gray-12);
    --gh-muted: var(--aw-gray-7);
    --gh-neutral: var(--aw-gray-3);
    --gh-success: color-mix(in srgb, var(--aw-green-6) 80%, var(--aw-gray-13));
    --gh-danger: color-mix(in srgb, var(--aw-red-5) 82%, var(--aw-gray-13));
    --gh-add-bg: color-mix(in srgb, var(--aw-green-6) 13%, var(--gh-canvas));
    --gh-add-num: color-mix(in srgb, var(--aw-green-6) 24%, var(--gh-canvas));
    --gh-del-bg: color-mix(in srgb, var(--aw-red-5) 10%, var(--gh-canvas));
    --gh-del-num: color-mix(in srgb, var(--aw-red-5) 20%, var(--gh-canvas));
  }
  .gh :global(svg) {
    display: block;
    fill: currentColor;
  }
  .gh b {
    font-weight: 600;
    color: var(--gh-fg);
  }
  .aw-item .gh p {
    margin: 0;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--gh-fg);
  }
  .gh code,
  .gh-mono {
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
  }
  .gh code {
    padding: 0.05em 0.3em;
    border: 0;
    border-radius: 6px;
    background: color-mix(in srgb, var(--gh-muted) 18%, transparent);
  }
  .gh-muted { color: var(--gh-muted); }
  .gh-ok { color: var(--gh-success); }
  .gh-bad { color: var(--gh-danger); }

  /* Issue / PR header: title, then the state pill */
  .gh-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .gh-title {
    font-size: var(--aw-step-0);
    line-height: 1.3;
    color: var(--gh-fg);
  }
  .gh-num {
    color: var(--gh-muted);
    font-weight: 300;
  }
  .gh-state {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 1.625rem;
    padding: 0 0.625rem 0 0.5rem;
    border-radius: 2em;
    background: var(--gh-success-em);
    color: var(--aw-gray-0);
    font-weight: 500;
  }

  /* Avatars: the GitHub mark in a circle */
  .gh-av {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--gh-canvas);
    box-shadow: 0 0 0 1px var(--gh-border);
    color: var(--gh-fg);
  }
  .gh-av-sm {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Timeline: a 2px rail with circular event badges sitting on it */
  .gh-tl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .gh-tl::before {
    content: "";
    position: absolute;
    top: 1rem;
    bottom: -3rem;
    left: calc(1rem - 1px);
    width: 2px;
    background: var(--gh-rail);
  }
  .gh-ev {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--gh-muted);
  }
  .gh-ev-t { line-height: 1.75; }
  .gh-badge {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-right: 0.375rem;
    border-radius: 50%;
    background: var(--gh-subtle);
    box-shadow: 0 0 0 3px var(--gh-canvas);
    color: var(--gh-muted);
  }
  .gh-ci .gh-badge { color: var(--gh-success); }
  .gh-lbl {
    white-space: nowrap;
    padding: 0.0625rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--lbl) 30%, transparent);
    border-radius: 2em;
    background: color-mix(in srgb, var(--lbl) 18%, transparent);
    color: color-mix(in srgb, var(--lbl) 55%, var(--gh-fg));
    font-weight: 500;
  }
  .gh-lbl-red { --lbl: var(--aw-red-5); }
  .gh-lbl-blue { --lbl: var(--aw-blue-6); }
  :global(:root[data-theme='light']) .gh-lbl {
    background: var(--lbl);
    border-color: transparent;
    color: var(--aw-gray-0);
  }
  :global(:root[data-theme='light']) .gh-lbl-red {
    --lbl: color-mix(in srgb, var(--aw-red-5) 88%, var(--aw-gray-13));
  }

  /* Boxes: comments, merge box, file list */
  .gh-box {
    position: relative;
    min-width: 0;
    background: var(--gh-canvas);
    border: 1px solid var(--gh-border);
    border-radius: var(--gh-r);
  }
  .gh-cm {
    position: relative;
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }
  .gh-cm .gh-box { flex: 1 1 auto; }
  .gh-box-head {
    overflow: hidden;
    padding: 0.5rem 0.875rem;
    background: var(--gh-subtle);
    border-bottom: 1px solid var(--gh-border);
    border-radius: var(--gh-r) var(--gh-r) 0 0;
    color: var(--gh-muted);
  }
  .gh-box-body {
    padding: 0.75rem 0.875rem;
    white-space: normal;
    text-wrap: pretty;
  }

  /* Diff: two number gutters, a sign column and code */
  .gh-file {
    border: 1px solid var(--gh-border);
    border-radius: var(--gh-r);
    overflow: hidden;
  }
  .gh-fh {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--gh-subtle);
    border-bottom: 1px solid var(--gh-border);
  }
  .gh-diff {
    font-family: var(--aw-font-mono);
    line-height: 1.85;
  }
  .gh-dl {
    display: grid;
    grid-template-columns: 2.5rem 2.5rem 1.5rem 1fr;
  }
  .gh-ln {
    padding-right: 0.625rem;
    text-align: right;
    color: var(--gh-muted);
  }
  .gh-sg {
    padding-left: 0.5rem;
    color: var(--gh-muted);
  }
  .gh-cd { white-space: pre; }
  .gh-add { background: var(--gh-add-bg); }
  .gh-add .gh-ln { background: var(--gh-add-num); color: var(--gh-fg); }
  .gh-del { background: var(--gh-del-bg); }
  .gh-del .gh-ln { background: var(--gh-del-num); color: var(--gh-fg); }
  .gh-add .gh-sg, .gh-del .gh-sg { color: var(--gh-fg); }
  .gh-thread {
    padding: 0.875rem 0.875rem 1rem;
    border-top: 1px solid var(--gh-border);
    white-space: normal;
    text-wrap: pretty;
  }
  .gh-thread-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }

  /* Checks merge box */
  .gh-merge-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--gh-border);
    line-height: 1.4;
  }
  .gh-merge-ico {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--gh-r);
    background: var(--gh-danger);
    color: var(--aw-gray-0);
  }
  .gh-run {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
  }
  .gh-run + .gh-run { border-top: 1px solid var(--gh-border); }
  .gh-ci .gh-tl::before { top: -1.25rem; }

  /* PR file list with diffstats */
  .gh-frow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
  }
  .gh-frow + .gh-frow { border-top: 1px solid var(--gh-border); }
  .gh-frow .gh-mono { margin-right: auto; padding-right: 1rem; }
  .gh-add-n { color: var(--gh-success); font-weight: 600; }
  .gh-del-n { color: var(--gh-danger); font-weight: 600; }
  .gh-stat { display: inline-flex; gap: 1px; margin-left: 0.25rem; }
  .gh-stat i {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--gh-neutral);
  }
  .gh-stat i.a { background: var(--gh-success-em); }
  .gh-stat i.d { background: var(--gh-danger); }

  @media (max-width: 47.99rem) {
    .aw-stage { height: 19rem; }
    .gh-hide-sm { display: none; }
    .gh {
      top: 1.25rem;
      left: 1.25rem;
      padding: 1rem 2.75rem 1rem 1rem;
      gap: 1rem;
    }
    .gh { white-space: normal; }
    .gh-dl { grid-template-columns: 1.75rem 1.75rem 1rem 1fr; }
    .gh-ln { padding-right: 0.375rem; }
    .gh-sg { padding-left: 0.25rem; }
    .gh-stat { display: none; }
  }

  /* Disclosure */
  .aw-more-bar {
    margin-top: 3rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .aw-more {
    width: 100%;
  }
  .aw-more summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--aw-color-border-strong);
    border-radius: 8px;
    background: var(--aw-color-surface);
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-strong);
    cursor: pointer;
    user-select: none;
  }
  .aw-more summary::-webkit-details-marker {
    display: none;
  }
  .aw-more summary:hover {
    background: var(--aw-color-bg-subtle);
  }
  .aw-sum-open,
  .aw-more[open] .aw-sum-closed {
    display: none;
  }
  .aw-more[open] .aw-sum-open {
    display: inline;
  }
  .aw-chev {
