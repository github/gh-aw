---
import octicons from '@primer/octicons';
import LandingSection from './LandingSection.astro';

const icon = (n: keyof typeof octicons, size = 16) => octicons[n].toSVG({ width: size, height: size });
const G = '/gh-aw/gallery/';

const featured = [
  { id: 'triage', title: 'Issue Triage', href: `${G}ai-issue-triage/`, text: 'Classifies new issues, spots duplicates, applies labels and asks for missing details.' },
  { id: 'review', title: 'Pull Request Review', href: `${G}automated-pr-review/`, text: 'Inspects diffs for concrete defects and posts review feedback through safe outputs.' },
  { id: 'ci', title: 'CI Failure Investigation', href: `${G}ci-failure-investigation/`, text: 'Reads failed runs, correlates logs and opens an issue with the likely cause.' },
  { id: 'docs', title: 'Documentation Maintenance', href: `${G}docs-automation/`, text: 'Detects drift between code and docs and proposes updates you can review.' },
  { id: 'report', title: 'Repository Reporting', href: `${G}ai-release-notes/`, text: 'Summarises repository or release activity on an event or a schedule.' },
  { id: 'security', title: 'Security Review', href: `${G}security-review/`, text: 'Combines repository evidence with AI judgement and reports through code scanning.' },
];

const more = [
  {
    heading: 'Maintenance',
    items: [
      { title: 'Code Improvement', href: `${G}code-improvement/`, text: 'Finds duplicated logic and proposes focused changes.' },
      { title: 'Repository Maintenance', href: 'https://github.com/githubnext/agentics/blob/main/docs/repo-assist.md', text: 'Works through a backlog with bounded tasks on a schedule.' },
      { title: 'Dependency Analysis', href: '/gh-aw/patterns/research-plan-assign-ops/', text: 'Researches upstream changes, then files prioritised follow-ups.' },
    ],
  },
  {
    heading: 'Insights',
    items: [
      { title: 'Metrics and Analytics', href: `${G}metrics-analytics/`, text: 'Stores structured snapshots of workflow activity.' },
      { title: 'Code Quality Monitoring', href: `${G}multi-repo/code-quality-monitoring/`, text: 'Analyses quality across repositories and files actionable issues.' },
    ],
  },
  {
    heading: 'Across repositories',
    items: [
      { title: 'Triage from Side Repo', href: `${G}multi-repo/triage-from-side-repo/`, text: 'Triages a main repository from an isolated side repository.' },
      { title: 'Feature Synchronization', href: `${G}multi-repo/feature-sync/`, text: 'Syncs code and configuration through reviewable pull requests.' },
      { title: 'Cross-Repository Issue Tracking', href: `${G}multi-repo/issue-tracking/`, text: 'Aggregates issue status in one central repository.' },
      { title: 'Dependabot Rollout', href: `${G}multi-repo/dependabot-rollout/`, text: 'Rolls out tailored Dependabot configuration everywhere.' },
    ],
  },
];
---

    <LandingSection id="gallery" title="What teams automate" lede="Start from a proven workflow and adapt it to your repository.">
      <ul class="aw-feat" role="list">
        {featured.map((f) => (
          <li>
            <a class="aw-item" href={f.href}>
              <div class="aw-stage" aria-hidden="true">
                {f.id === 'triage' && (
                  <div class="aw-frag">
                    <div class="aw-row">
                      <span class="aw-ico aw-open" set:html={icon('issue-opened')} />
                      <span class="aw-t">Crash when saving an empty file</span>
                    </div>
                    <div class="aw-chips">
                      <span class="aw-chip">bug</span>
                      <span class="aw-chip">area: editor</span>
                      <span class="aw-chip aw-chip-new">needs repro</span>
                    </div>
                  </div>
                )}
                {f.id === 'review' && (
                  <div class="aw-frag">
                    <div class="aw-diff"><span class="aw-ln">42</span><span class="aw-add">+ items.forEach(save)</span></div>
                    <div class="aw-comment">
                      <span class="aw-ico" set:html={icon('comment-discussion', 14)} />
                      <span><b>github-actions</b> Errors from <code>save</code> are dropped here.</span>
                    </div>
                  </div>
                )}
                {f.id === 'ci' && (
                  <div class="aw-frag">
                    <div class="aw-row">
                      <span class="aw-ico aw-fail" set:html={icon('x-circle')} />
                      <span class="aw-t">build / test (ubuntu)</span>
                      <span class="aw-m">failed</span>
                    </div>
                    <div class="aw-row">
                      <span class="aw-ico aw-open" set:html={icon('issue-opened')} />
                      <span class="aw-t">Diagnosis: flaky timeout in db setup</span>
                    </div>
                  </div>
                )}
                {f.id === 'docs' && (
                  <div class="aw-frag">
                    <div class="aw-row">
                      <span class="aw-ico aw-pr" set:html={icon('git-pull-request')} />
                      <span class="aw-t">docs: sync CLI flags with --help</span>
                    </div>
                    <div class="aw-row aw-sub">
                      <span class="aw-m">#214</span>
                      <span class="aw-plus">+18</span>
                      <span class="aw-minus">−6</span>
                      <span class="aw-chip">documentation</span>
                    </div>
                  </div>
                )}
                {f.id === 'report' && (
                  <div class="aw-frag">
                    <div class="aw-row">
                      <span class="aw-ico aw-open" set:html={icon('issue-opened')} />
                      <span class="aw-t">Release notes: v2.3.1</span>
                    </div>
                    <div class="aw-row aw-sub">
                      <span class="aw-ico" set:html={icon('tag', 14)} />
                      <span class="aw-m">14 merged pull requests · 3 fixes</span>
                    </div>
                  </div>
                )}
                {f.id === 'security' && (
                  <div class="aw-frag">
                    <div class="aw-row">
                      <span class="aw-ico aw-fail" set:html={icon('shield')} />
                      <span class="aw-t">Unpinned action in release.yml</span>
                    </div>
                    <div class="aw-row aw-sub">
                      <span class="aw-chip aw-chip-danger">High</span>
                      <span class="aw-m">Code scanning · Open</span>
                    </div>
                  </div>
                )}
              </div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </a>
          </li>
        ))}
      </ul>

      <div class="aw-more-bar">
        <details class="aw-more">
          <summary>
            <span class="aw-sum-closed">Show all 15 workflows</span>
            <span class="aw-sum-open">Show fewer</span>
            <span class="aw-chev" set:html={icon('chevron-down', 16)} />
          </summary>
          <div class="aw-groups">
            {more.map((g) => (
              <section>
                <h3>{g.heading}</h3>
                <ul role="list">
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href}><span class="aw-li-t">{i.title}</span><span class="aw-li-d">{i.text}</span></a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </details>
        <a class="aw-all" href="/gh-aw/gallery/">Browse the full gallery <span aria-hidden="true">→</span></a>
      </div>
    </LandingSection>

<style>
  /* Featured row: scrolls inside itself on mobile, 3x2 grid on desktop */
  .aw-feat {
    --aw-gut: clamp(1rem, 4vw, 2rem);
    list-style: none;
    margin: 2.5rem calc(-1 * var(--aw-gut)) 0;
    padding: 0 var(--aw-gut) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 20rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--aw-gut);
    scrollbar-width: none;
  }
  .aw-feat::-webkit-scrollbar {
    display: none;
  }
  .aw-feat > li {
    margin: 0;
    padding: 0;
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .aw-feat {
      margin-inline: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 2.5rem 2rem;
      overflow: visible;
    }
  }

  .aw-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: 12px;
  }
  .aw-item:focus-visible,
  .aw-more summary:focus-visible,
  .aw-all:focus-visible,
  .aw-groups a:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 3px;
  }
  .aw-stage {
    display: flex;
    align-items: center;
    height: 9rem;
    padding: 1rem;
    background: var(--aw-color-bg-subtle);
    border: 1px solid var(--aw-color-hairline-light);
    border-radius: 12px;
    transition: border-color 0.2s;
  }
  .aw-item:hover .aw-stage {
    border-color: var(--aw-color-border-strong);
  }
  .aw-item h3 {
    margin: 1rem 0 0;
    font-size: var(--aw-step-0);
    font-weight: 550;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--aw-color-text-strong);
    border: 0;
  }
  .aw-item:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .aw-item p {
    margin: 0.375rem 0 0;
    font-size: var(--aw-step--1);
    line-height: 1.5;
    color: var(--aw-color-text-muted);
    text-wrap: pretty;
  }

  /* Fragments */
  .aw-frag {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    background: var(--aw-color-surface);
    border: 1px solid var(--aw-color-hairline-light);
    border-radius: 8px;
    box-shadow: var(--aw-shadow-raised);
    font-size: var(--aw-step--1);
    line-height: 1.35;
    color: var(--aw-color-text-body);
  }
  .aw-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .aw-sub {
    padding-left: 1.5rem;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }
  .aw-sub .aw-ico {
    margin-left: -0.125rem;
  }
  .aw-t {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 550;
    color: var(--aw-color-text-strong);
  }
  .aw-m {
    flex: none;
    color: var(--aw-color-text-muted);
  }
  .aw-ico {
    display: inline-flex;
    flex: none;
    color: var(--aw-color-text-muted);
  }
  .aw-ico :global(svg) {
    fill: currentColor;
  }
  .aw-open {
    color: var(--aw-color-success);
  }
  .aw-fail {
    color: var(--aw-color-danger);
  }
  .aw-pr {
    color: var(--aw-color-text-secondary);
  }
  .aw-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding-left: 1.5rem;
  }
  .aw-chip {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px solid var(--aw-color-border);
    border-radius: 999px;
    color: var(--aw-color-text-secondary);
    white-space: nowrap;
  }
  .aw-chip-new {
    border-color: var(--aw-color-complement);
    color: var(--aw-color-complement);
    animation: aw-chip-in 0.6s ease-out 0.4s backwards;
  }
  .aw-chip-danger {
    border-color: var(--aw-color-danger);
    color: var(--aw-color-danger);
  }
  .aw-plus {
    color: var(--aw-color-success);
  }
  .aw-minus {
    color: var(--aw-color-danger);
  }
  .aw-diff {
    display: flex;
    gap: 0.625rem;
    padding: 0.125rem 0.5rem;
    margin: -0.125rem -0.25rem 0;
    border-radius: 4px;
    background: var(--aw-color-surface-header);
    font-family: var(--aw-font-mono);
    white-space: nowrap;
    overflow: hidden;
  }
  .aw-ln {
    color: var(--aw-color-text-muted);
  }
  .aw-add {
    color: var(--aw-color-success);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .aw-comment {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding-top: 0.5rem;
    border-top: 1px solid var(--aw-color-hairline-light);
  }
  .aw-comment .aw-ico {
    margin-top: 0.125rem;
  }
  .aw-comment b {
    font-weight: 550;
    color: var(--aw-color-text-strong);
    margin-right: 0.25rem;
  }
  .aw-comment code {
    padding: 0;
    background: none;
    border: 0;
    font-size: inherit;
  }
  @keyframes aw-chip-in {
    from { opacity: 0; transform: translateY(2px); }
  }

  /* Disclosure */
  .aw-more-bar {
    margin-top: 3rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .aw-more {
    width: 100%;
  }
  .aw-more summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--aw-color-border-strong);
    border-radius: 8px;
    background: var(--aw-color-surface);
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-strong);
    cursor: pointer;
    user-select: none;
  }
  .aw-more summary::-webkit-details-marker {
    display: none;
  }
  .aw-more summary:hover {
    background: var(--aw-color-bg-subtle);
  }
  .aw-sum-open,
  .aw-more[open] .aw-sum-closed {
    display: none;
  }
  .aw-more[open] .aw-sum-open {
    display: inline;
  }
  .aw-chev {
    display: inline-flex;
    color: var(--aw-color-text-muted);
    transition: transform 0.2s;
  }
  .aw-chev :global(svg) {
    fill: currentColor;
  }
  .aw-more[open] .aw-chev {
    transform: rotate(180deg);
  }
  @media (min-width: 40rem) {
    .aw-all {
      position: absolute;
      top: 0;
      right: 0;
      line-height: 2.5rem;
    }
  }
  .aw-all {
    font-size: var(--aw-step-0);
    color: var(--aw-color-accent-text);
    text-decoration: none;
    border-radius: 4px;
  }
  .aw-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .aw-groups {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .aw-groups h3 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--aw-color-hairline-light);
    font-size: var(--aw-step--1);
    font-weight: 550;
    color: var(--aw-color-text-muted);
  }
  .aw-groups ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .aw-groups li {
    margin: 0;
    padding: 0;
  }
  .aw-groups a {
    display: block;
    padding: 0.625rem 0;
    color: inherit;
    text-decoration: none;
    border-radius: 4px;
  }
  .aw-li-t {
    display: block;
    font-size: var(--aw-step-0);
    font-weight: 500;
    color: var(--aw-color-text-strong);
  }
  .aw-groups a:hover .aw-li-t {
    text-decoration: underline;
    text-decoration-color: var(--aw-color-border-strong);
    text-underline-offset: 3px;
  }
  .aw-li-d {
    display: block;
    margin-top: 0.125rem;
    font-size: var(--aw-step--1);
    line-height: 1.45;
    color: var(--aw-color-text-muted);
  }
  @media (max-width: 52rem) {
    .aw-groups {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aw-chip-new { animation: none; }
    .aw-chev, .aw-stage { transition: none; }
  }
</style>
