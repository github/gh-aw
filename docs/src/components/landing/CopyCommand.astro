---
import octicons from '@primer/octicons';
interface Props {
  command: string;
}
const { command } = Astro.props;
const copyIcon = octicons.copy.toSVG({ width: 16, height: 16 });
const checkIcon = octicons.check.toSVG({ width: 16, height: 16 });
---

<div class="aw-copy" data-copy-command={command}>
  <code class="aw-copy-text" tabindex="0" aria-label={`Command: ${command}`}><span class="aw-prompt" aria-hidden="true">$ </span>{command}</code>
  <button type="button" class="aw-copy-btn" aria-label="Copy command">
    <span class="aw-icon aw-icon-copy" set:html={copyIcon} />
    <span class="aw-icon aw-icon-check" set:html={checkIcon} />
  </button>
  <span class="aw-sr" role="status" aria-live="polite"></span>
</div>

<style>
  .aw-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 44px;
    max-width: 100%;
    min-width: 0;
    padding-inline: 1rem 0.375rem;
    border: 1px solid var(--aw-color-border);
    border-radius: 999px;
    background: var(--aw-color-bg-subtle);
  }
  .aw-copy-text {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    font-family: var(--aw-font-mono);
    font-size: var(--aw-step--1);
    color: var(--aw-color-text);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    border-radius: 4px;
  }
  .aw-copy-text::-webkit-scrollbar {
    display: none;
  }
  .aw-prompt {
    color: var(--aw-color-text-muted);
    user-select: none;
  }
  .aw-copy-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--aw-color-text-secondary);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .aw-copy-btn:hover {
    background: var(--aw-color-border);
    color: var(--aw-color-text);
  }
  .aw-copy-btn:focus-visible,
  .aw-copy-text:focus-visible {
    outline: 2px solid var(--aw-color-accent);
    outline-offset: 2px;
  }
  .aw-icon {
    display: inline-flex;
  }
  .aw-icon-check {
    display: none;
    color: var(--aw-color-success);
  }
  .aw-copy[data-copied] .aw-icon-copy {
    display: none;
  }
  .aw-copy[data-copied] .aw-icon-check {
    display: inline-flex;
  }
  .aw-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  let cleanup = () => {};

  function initialize() {
    cleanup();
    const controller = new AbortController();
    const timers: number[] = [];

    document.querySelectorAll<HTMLElement>('[data-copy-command]').forEach((root) => {
      const btn = root.querySelector('button');
      const status = root.querySelector('[role="status"]');
      let timer: number | undefined;
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(root.dataset.copyCommand ?? '');
        } catch {
          return;
        }
        root.setAttribute('data-copied', '');
        if (status) status.textContent = 'Copied';
        if (timer !== undefined) clearTimeout(timer);
        timer = window.setTimeout(() => {
          root.removeAttribute('data-copied');
          if (status) status.textContent = '';
        }, 1500);
        timers.push(timer);
      }, { signal: controller.signal });
    });

    cleanup = () => {
      controller.abort();
      timers.forEach(clearTimeout);
    };
  }

  document.addEventListener('astro:page-load', initialize);
  document.addEventListener('astro:before-swap', () => cleanup());
  initialize();
</script>
