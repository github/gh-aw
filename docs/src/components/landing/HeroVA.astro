---
/** Hero A: "AI-powered workflows for GitHub" with prompt → workflow → result. */
import CtaRow from './CtaRow.astro';
import HeroVAVisual from './HeroVAVisual.astro';
import { engineLogos } from './HowItWorksEngineLogos';

const engines = [
  { id: 'copilot', name: 'Copilot' },
  { id: 'claude', name: 'Claude' },
  { id: 'codex', name: 'Codex' },
  { id: 'agy', name: 'Antigravity' },
];
---

<div class="aw-hero-inner">
  <div class="aw-hero-text">
    <h2><span class="aw-line">AI-powered workflows</span> <span class="aw-line">for GitHub</span></h2>
    <p class="aw-hero-sub">
      Use {engines.map((e, i) => {
        const sep = i === engines.length - 1 ? '' : i === engines.length - 2 ? ' or ' : ', ';
        return (
          <Fragment>
            <span class="aw-engine">{e.name}</span>{sep}
          </Fragment>
        );
      })} to automatically triage issues, investigate failures and open pull requests across your repos.
    </p>
    <p class="aw-hero-sub">
      With strong guardrails, permissions, audit and cost controls, in GitHub Actions.
    </p>
    <div class="aw-hero-cta"><CtaRow /></div>
  </div>
  <div class="aw-hero-visual"><HeroVAVisual /></div>
</div>

<style>
  .aw-engine {
    white-space: nowrap;
  }
</style>
