---
// Hero background variant D: "columns".
// Vertical columns hang from the top edge across the full width, like an
// equaliser or rain streaks. Each column's length breathes on smooth noise
// sampled along x, so neighbours move together as gentle waves. Columns fade
// from strong at the top to nothing at the tip through an 8x8 Bayer dither,
// and a rare GitHub-green cell lights up at a tip like a finished run.
// Rendered at low resolution and upscaled with `image-rendering: pixelated`.
---

<div class="hero-bg-d" data-hero-bg-d>
  <canvas class="hero-bg-d-canvas"></canvas>
</div>

<style>
  .hero-bg-d {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-bg-d-canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    opacity: 0;
    transition: opacity 900ms ease-out;
  }
  .hero-bg-d-canvas.is-ready {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-d-canvas {
      transition: none;
    }
  }
</style>

<script>
  const VERT = `
    attribute vec2 a_pos;
    void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }
  `;

  const FRAG = `
    precision highp float;
    uniform vec2 u_res;      // canvas size in cells
    uniform float u_cell;    // CSS px per cell
    uniform float u_time;
    uniform float u_strength;
    uniform float u_calm;    // CSS px from the top where the h1 starts
    uniform float u_wide;    // 1.0 when the hero visual sits on the right
    uniform vec3 u_p1;
    uniform vec3 u_p2;
    uniform vec3 u_p3;
    uniform vec3 u_p4;
    uniform vec3 u_green;

    float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
    float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }
    float vnoise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      float a = hash(i);
      float b = hash(i + vec2(1.0, 0.0));
      float c = hash(i + vec2(0.0, 1.0));
      float d = hash(i + vec2(1.0, 1.0));
      return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    const float SLOT = 12.0; // cells per slot; each slot splits into 2-4 columns

    void main() {
      vec2 cell = floor(gl_FragCoord.xy);     // cell coords, y up
      float row = u_res.y - 1.0 - cell.y;     // cell rows from the top
      float fromTop = (row + 0.5) * u_cell;   // CSS px from the top
      float t = u_time;

      // Split the width into columns of 2-6 cells with a 1-cell gap after each.
      float slot = floor(cell.x / SLOT);
      float local = cell.x - slot * SLOT;
      float start = 0.0;
      float size = SLOT;
      float idx = 0.0;
      for (int k = 0; k < 4; k++) {
        float s = 3.0 + floor(hash(vec2(slot, float(k) + 0.5)) * 5.0);
        if (SLOT - (start + s) < 3.0 || k == 3) s = SLOT - start;
        if (local < start + s) { size = s; idx = float(k); break; }
        start += s;
      }
      if (local >= start + size - 1.0) { gl_FragColor = vec4(0.0); return; }
      float colId = slot * 4.0 + idx;
      float centerX = (slot * SLOT + start + (size - 1.0) * 0.5) * u_cell;
      float xn = centerX / (u_res.x * u_cell);

      // Column length: a slow wave along x shared by neighbours, plus a
      // smaller per-column wobble so the skyline isn't perfectly smooth.
      float wave = vnoise(vec2(centerX / 210.0 + t * 0.05, t * 0.11));
      float own = vnoise(vec2(colId * 7.31, t * 0.23 + hash(vec2(colId, 3.1)) * 9.0));
      float len = clamp(wave * 0.78 + own * 0.32, 0.0, 1.0);
      len = 0.18 + 0.82 * len * len * (3.0 - 2.0 * len);

      // Reach: stop short of the h1, longer on the right behind the visual.
      float reach = u_calm * 0.92;
      float right = smoothstep(0.5, 0.85, xn) * u_wide;
      reach = mix(reach, max(reach, u_calm * 1.75), right);
      float L = len * reach;

      float f = fromTop / L;
      if (f >= 1.0) { gl_FragColor = vec4(0.0); return; }

      float th = bayer8(cell);

      // Rare green glint: one or two cells at the tip of a few columns, each
      // lit for a moment as if a run just finished.
      float tipRow = floor(L / u_cell);
      float epoch = floor(t * 0.45 + hash(vec2(colId, 8.7)) * 7.0);
      float lit = hash(vec2(colId, epoch));
      float centerCell = slot * SLOT + start + floor((size - 1.0) * 0.5);
      if (lit < 0.03 && len > 0.45 && cell.x == centerCell && row >= tipRow - 2.0 && row <= tipRow - 1.0) {
        gl_FragColor = vec4(u_green, 1.0);
        return;
      }

      float amp = 0.68 + 0.3 * hash(vec2(colId, 1.7));
      float v = pow(1.0 - f, 1.6) * amp * u_strength;
      float level = floor(v * 4.0 + th);
      if (level < 1.0) { gl_FragColor = vec4(0.0); return; }
      vec3 col = level < 2.0 ? u_p1 : level < 3.0 ? u_p2 : level < 4.0 ? u_p3 : u_p4;
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const CELL = 3; // CSS px per dither cell
  const FRAME_MS = 1000 / 30;
  const WIDE_MIN = 960; // hero visual sits beside the text from about here

  function parseColor(ctx: CanvasRenderingContext2D, value: string): [number, number, number] {
    ctx.clearRect(0, 0, 1, 1);
    ctx.fillStyle = '#000';
    ctx.fillStyle = value.trim() || '#000';
    ctx.fillRect(0, 0, 1, 1);
    const d = ctx.getImageData(0, 0, 1, 1).data;
    return [d[0] / 255, d[1] / 255, d[2] / 255];
  }

  function compile(gl: WebGLRenderingContext, type: number, src: string) {
    const s = gl.createShader(type);
    if (!s) return null;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
      gl.deleteShader(s);
      return null;
    }
    return s;
  }

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('.hero-bg-d-canvas');
    if (!canvas) return;
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true });
    if (!gl) return;

    const vs = compile(gl, gl.VERTEX_SHADER, VERT);
    const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    if (!prog) return;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const u = (name: string) => gl.getUniformLocation(prog, name);
    const uRes = u('u_res');
    const uCell = u('u_cell');
    const uTime = u('u_time');
    const uStrength = u('u_strength');
    const uCalm = u('u_calm');
    const uWide = u('u_wide');
    const uP = [u('u_p1'), u('u_p2'), u('u_p3'), u('u_p4')];
    const uGreen = u('u_green');
    gl.uniform1f(uCell, CELL);

    const probe = document.createElement('canvas').getContext('2d', { willReadFrequently: true });

    function readColors() {
      if (!probe || !gl) return;
      const cs = getComputedStyle(document.documentElement);
      const dark = document.documentElement.getAttribute('data-theme') !== 'light';
      const steps = dark
        ? ['--aw-purple-9', '--aw-purple-8', '--aw-purple-7', '--aw-purple-6']
        : ['--aw-purple-2', '--aw-purple-3', '--aw-purple-4', '--aw-purple-6'];
      steps.forEach((name, i) => gl.uniform3fv(uP[i], parseColor(probe, cs.getPropertyValue(name))));
      gl.uniform3fv(uGreen, parseColor(probe, cs.getPropertyValue('--aw-green-6')));
      gl.uniform1f(uStrength, 1.0);
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Random phase so the skyline doesn't always start from the same shape.
    const t0 = performance.now() - Math.random() * 60000;
    let raf = 0;
    let last = 0;
    let onScreen = true;

    function visible() {
      return onScreen && !document.hidden && root.offsetParent !== null && root.clientWidth > 0;
    }

    // Where the headline starts, so the columns stop short of it.
    function measureCalm(w: number, h: number) {
      const h1 = root.closest('section, .aw-hero')?.querySelector('h1');
      if (!h1) return h * 0.35;
      const top = h1.getBoundingClientRect().top - root.getBoundingClientRect().top;
      return top > 40 ? top : Math.min(h * 0.35, w * 0.4);
    }

    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (!w || !h || !gl || !canvas) return false;
      const cw = Math.ceil(w / CELL);
      const ch = Math.ceil(h / CELL);
      if (canvas.width !== cw || canvas.height !== ch) {
        canvas.width = cw;
        canvas.height = ch;
        canvas.style.width = `${cw * CELL}px`;
        canvas.style.height = `${ch * CELL}px`;
        gl.viewport(0, 0, cw, ch);
        gl.uniform2f(uRes, cw, ch);
      }
      gl.uniform1f(uCalm, measureCalm(w, h));
      gl.uniform1f(uWide, w >= WIDE_MIN ? 1 : 0);
      return true;
    }

    function draw(now: number) {
      if (!gl || !canvas) return;
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      canvas.classList.add('is-ready');
    }

    function tick(now: number) {
      raf = 0;
      if (!visible()) return;
      if (now - last >= FRAME_MS) {
        last = now;
        draw(now);
      }
      raf = requestAnimationFrame(tick);
    }

    function update() {
      if (!visible()) {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        return;
      }
      if (!resize()) return;
      if (reduceMotion.matches) {
        draw(t0 + 20000);
        return;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    }

    readColors();

    new ResizeObserver(update).observe(root);

    new IntersectionObserver((entries) => {
      onScreen = entries.some((e) => e.isIntersecting);
      update();
    }).observe(root);

    new MutationObserver(() => {
      readColors();
      if (visible()) draw(reduceMotion.matches ? t0 + 20000 : performance.now());
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    document.addEventListener('visibilitychange', update);
    reduceMotion.addEventListener('change', update);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-hero-bg-d]').forEach(init);
</script>
