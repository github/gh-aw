---
/**
 * Overrides Starlight's MobileMenuFooter: the bottom row of the mobile menu
 * sheet, on docs pages (inside the sidebar) and on the landing page (#site-menu).
 */
import octicons from '@primer/octicons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL;
const githubIcon = octicons['mark-github'].toSVG({ width: 18, height: 18, 'aria-hidden': 'true' });
---

<div class="mobile-menu-footer">
	<div class="mobile-menu-footer-row">
		<a class="mobile-menu-github" href="https://github.com/github/gh-aw">
			<Fragment set:html={githubIcon} />
			GitHub
		</a>
		<ThemeSelect />
	</div>
	<a class="mobile-menu-cta" href={`${base}setup/quick-start/`}>Get started</a>
</div>

<style>
	.mobile-menu-footer {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-block: 0.5rem calc(1rem + env(safe-area-inset-bottom, 0px));
		border-top: 1px solid var(--aw-color-divider);
	}

	.mobile-menu-footer-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.mobile-menu-github {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		font-size: var(--aw-step--1);
		font-weight: 500;
		color: var(--aw-color-text-muted);
		text-decoration: none;
	}

	.mobile-menu-github:hover {
		color: var(--aw-color-text-strong);
	}

	.mobile-menu-github :global(svg) {
		fill: currentColor;
	}

	.mobile-menu-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.75rem;
		border-radius: var(--aw-radius-pill);
		background: var(--aw-color-button-bg);
		color: var(--aw-color-button-text);
		font-size: var(--aw-step-0);
		font-weight: 500;
		text-decoration: none;
	}

	.mobile-menu-cta:hover {
		background: var(--aw-color-button-bg-hover);
		color: var(--aw-color-button-text);
	}
</style>
