{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run build:slides",
    "start": "astro dev",
    "prebuild": "node scripts/check-reading-measure.mjs && npm run generate-agent-factory && npm run generate-model-tables && npm run build:slides",
    "build": "rm -rf dist && astro build",
    "build:slides": "node ../scripts/ensure-docs-slide-pdf.js",
    "preview": "astro preview",
    "astro": "astro",
    "validate-links": "astro build",
    "og": "node scripts/capture-og.mjs",
    "generate-agent-factory": "cd .. && node scripts/generate-agent-factory.js",
    "generate-model-tables": "cd .. && node scripts/generate-model-tables.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@primer/octicons": "^19.40.0",
    "astro": "^7.4.1",
    "astro-mermaid": "^2.1.0",
    "mermaid": "11.17.2",
    "sharp": "^0.35.5",
    "starlight-blog": "^0.30.0",
    "starlight-changelogs": "^0.7.1",
    "starlight-links-validator": "0.26.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/primer__octicons": "^19.21.0",
    "http-server": "^14.1.1",
    "satori": "^0.33.5",
    "starlight-github-alerts": "^0.5.0"
  },
  "overrides": {
    "@astrojs/markdown-remark": "7.3.3",
    "p-queue": "9.3.3",
    "zod": "4.6.5",
    "mermaid": {
      "katex": "^0.18.2"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
