{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run build:slides",
    "start": "astro dev",
    "prebuild": "npm run check:cracktro && node scripts/check-reading-measure.mjs && node scripts/check-redirects.mjs && npm run generate-agent-factory && npm run generate-model-tables && npm run build:slides",
    "build": "rm -rf dist && astro build",
    "build:slides": "node ../scripts/ensure-docs-slide-pdf.js",
    "preview": "astro preview",
    "astro": "astro",
    "validate-links": "astro build",
    "og": "node scripts/capture-og.mjs",
    "generate-agent-factory": "cd .. && node scripts/generate-agent-factory.js",
    "generate-model-tables": "cd .. && node scripts/generate-model-tables.js",
    "check:cracktro": "tsc -p tsconfig.cracktro.json",
    "test": "playwright test",
    "test:jsonld": "ASTRO_TELEMETRY_DISABLED=1 node --test tests/jsonld-security.test.mjs",
    "perf:cracktro": "node scripts/cracktro-perf.mjs",
    "test:cracktro-perf": "node --test scripts/cracktro-perf.test.mjs",
    "test:titles": "ASTRO_TELEMETRY_DISABLED=1 node --test tests/page-titles.test.mjs src/lib/rehype/deduplicateTitle.test.mjs",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "0.42.10",
    "@primer/octicons": "^19.42.0",
    "astro": "7.4.5",
    "astro-mermaid": "2.2.0",
    "mermaid": "12.3.0",
    "sharp": "^0.35.5",
    "starlight-blog": "^0.30.2",
    "starlight-changelogs": "^0.7.1",
    "starlight-links-validator": "0.27.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/primer__octicons": "^19.21.0",
    "http-server": "^14.1.1",
    "postcss": "8.5.32",
    "satori": "^0.63.2",
    "starlight-github-alerts": "^0.5.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@astrojs/markdown-remark": "7.3.6",
    "p-queue": "9.3.3",
    "postcss": "$postcss",
    "qs": "6.16.1",
    "zod": "4.6.5",
    "mermaid": {
      "katex": "^0.18.2"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
