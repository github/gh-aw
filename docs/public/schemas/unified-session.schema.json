        "inputTokensIncludeCache": { "type": "boolean" },
        "overflowedTokens": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false,
      "description": "Essential accounting projection; parser traces retain their snake_case usage."
    },
    "UsageReportData": {
      "type": "object",
      "properties": {
        "provider": { "$ref": "#/definitions/JsonValue" },
        "model": { "$ref": "#/definitions/JsonValue" },
