        "status": { "$ref": "#/definitions/JsonValue" },
        "aic": { "$ref": "#/definitions/JsonValue" },
        "totalAic": { "$ref": "#/definitions/JsonValue" },
        "premiumRequests": { "$ref": "#/definitions/JsonValue" },
        "durationMs": { "$ref": "#/definitions/JsonValue" },
        "usage": { "anyOf": [{ "$ref": "#/definitions/UnifiedSessionUsage" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "WorkflowInfoData": {
      "type": "object",
      "properties": {
        "engineId": { "$ref": "#/definitions/JsonValue" },
        "agentVersion": { "$ref": "#/definitions/JsonValue" },
        "cliVersion": { "$ref": "#/definitions/JsonValue" },
        "awfVersion": { "$ref": "#/definitions/JsonValue" },
        "mcpgVersion": { "$ref": "#/definitions/JsonValue" },
        "requestedModel": { "$ref": "#/definitions/JsonValue" },
        "triggerType": { "$ref": "#/definitions/JsonValue" },
        "workflow": { "$ref": "#/definitions/JsonValue" },
        "repository": { "$ref": "#/definitions/JsonValue" },
        "runId": { "$ref": "#/definitions/JsonValue" }
      },
      "additionalProperties": false
    }
  }
