      },
      {
        "if": { "properties": { "type": { "const": "tool.execution_complete" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "$ref": "#/definitions/JsonValue" },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "toolCallId": { "type": "string" },
                "stepIndex": { "$ref": "#/definitions/SessionCount" },
                "toolName": { "type": "string" },
                "success": { "type": "boolean" },
                "output": { "$ref": "#/definitions/JsonValue" },
                "result": { "$ref": "#/definitions/JsonValue" },
                "error": { "$ref": "#/definitions/JsonValue" },
                "durationMs": { "$ref": "#/definitions/SessionMetric" },
                "exitCode": { "type": ["number", "null"] },
                "status": { "type": "string" },
                "mcpServerName": { "type": "string" },
                "isError": { "type": "boolean" },
                "taskId": { "type": "string" },
                "taskType": { "type": "string" },
                "workflowName": { "type": "string" },
                "workflowRunId": { "type": "string" }
              }
            }
          }
        }
      },
      {
        "if": { "properties": { "type": { "const": "tool.execution_start" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "$ref": "#/definitions/JsonValue" },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "toolCallId": { "type": "string" },
                "stepIndex": { "$ref": "#/definitions/SessionCount" },
                "toolName": { "type": "string" },
                "input": { "$ref": "#/definitions/JsonValue" },
                "inputTruncated": { "type": "boolean" },
                "command": { "type": "string" },
                "mcpServerName": { "type": "string" }
              }
            }
          }
