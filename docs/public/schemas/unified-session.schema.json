      },
      {
        "if": { "properties": { "type": { "const": "tool.execution_update" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "$ref": "#/definitions/JsonValue" },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "output": { "$ref": "#/definitions/JsonValue" },
                "partial": { "$ref": "#/definitions/JsonValue" },
                "delta": { "$ref": "#/definitions/JsonValue" },
                "contentIndex": { "$ref": "#/definitions/JsonValue" },
                "sourceType": { "$ref": "#/definitions/JsonValue" },
                "usageSnapshot": { "$ref": "#/definitions/JsonValue", "description": "Repeated observed metadata, never additive inference usage." },
                "toolCallId": { "type": "string" },
                "stepIndex": { "$ref": "#/definitions/SessionCount" },
                "toolName": { "type": "string" },
                "input": { "$ref": "#/definitions/JsonValue" },
                "mcpServerName": { "type": "string" }
              }
            }
