      { "if": { "properties": { "type": { "const": "session.format" } }, "required": ["type"] }, "then": { "properties": { "data": { "$ref": "#/definitions/SessionFileFormatData" } } } },
      {
        "if": { "properties": { "type": { "const": "session.info" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "$ref": "#/definitions/JsonValue" },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "message": { "$ref": "#/definitions/JsonValue" },
                "content": { "$ref": "#/definitions/JsonValue" },
                "model": { "$ref": "#/definitions/JsonValue" },
                "status": { "$ref": "#/definitions/JsonValue" },
                "sourceType": { "$ref": "#/definitions/JsonValue" },
                "role": { "$ref": "#/definitions/JsonValue" },
                "messageId": { "$ref": "#/definitions/JsonValue" },
                "toolCallId": { "$ref": "#/definitions/JsonValue" },
