        "if": { "properties": { "type": { "const": "session.init" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "type": ["string", "null"] },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "sourceEngine": { "type": "string" },
                "model": { "type": "string" },
                "cwd": { "type": "string" },
                "reasoningEffort": { "type": "string" }
              }
            }
          }
        }
      },
      { "if": { "properties": { "type": { "const": "session.result" } }, "required": ["type"] }, "then": { "properties": { "data": { "$ref": "#/definitions/UnifiedSessionResultData" } } } },
      {
        "if": { "properties": { "type": { "const": "session.shutdown" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "$ref": "#/definitions/JsonValue" },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "shutdownType": { "$ref": "#/definitions/JsonValue" },
                "errorReason": { "$ref": "#/definitions/JsonValue" },
                "premiumRequests": { "$ref": "#/definitions/JsonValue" },
                "totalNanoAiu": { "$ref": "#/definitions/JsonValue" },
                "totalApiDurationMs": { "$ref": "#/definitions/JsonValue" },
                "sessionStartTime": { "$ref": "#/definitions/JsonValue" },
                "currentModel": { "$ref": "#/definitions/JsonValue" }
              }
            }
          }
        }
      },
      {
        "if": { "properties": { "type": { "const": "session.start" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "type": ["string", "null"] },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "sourceEngine": { "type": "string" },
                "model": { "type": "string" },
                "cwd": { "type": "string" },
                "reasoningEffort": { "type": "string" }
              }
            }
          }
        }
      },
      {
        "if": { "properties": { "type": { "const": "session.task_complete" } }, "required": ["type"] },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sessionId": { "$ref": "#/definitions/JsonValue" },
                "parentToolUseId": { "$ref": "#/definitions/JsonValue" },
                "parentToolCallId": { "$ref": "#/definitions/JsonValue" },
                "agentId": { "$ref": "#/definitions/JsonValue" },
                "success": { "$ref": "#/definitions/JsonValue" },
                "summary": { "$ref": "#/definitions/JsonValue" }
              }
