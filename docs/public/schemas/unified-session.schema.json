      { "if": { "properties": { "type": { "const": "usage.report" } }, "required": ["type"] }, "then": { "properties": { "data": { "$ref": "#/definitions/UsageReportData" } } } },
      { "if": { "properties": { "type": { "const": "user.message" } }, "required": ["type"] }, "then": { "properties": { "data": { "$ref": "#/definitions/UnifiedMessageData" } } } },
      { "if": { "properties": { "type": { "const": "workflow.info" } }, "required": ["type"] }, "then": { "properties": { "data": { "$ref": "#/definitions/WorkflowInfoData" } } } }
    ]
  },
  "minItems": 1,
  "allOf": [
    {
      "items": [
        {
          "properties": {
            "type": { "const": "session.format" },
            "data": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
            "provenance": { "properties": { "component": { "const": "collector" }, "phase": { "const": "conclusion" }, "path": { "const": "usage/aw_session.jsonl" }, "index": { "const": 0 } }, "not": { "required": ["timestampMs"] } }
          },
          "not": { "required": ["timestamp"] }
        }
      ]
    }
  ],
  "definitions": {
    "AgentExecutionData": {
      "type": "object",
      "properties": {
        "categories": { "type": "array", "items": { "$ref": "#/definitions/SessionDiagnosticName" }, "uniqueItems": true },
        "errorCodes": { "type": "array", "items": { "anyOf": [{ "$ref": "#/definitions/SessionDiagnosticName" }, { "$ref": "#/definitions/SessionErrorNumber" }] }, "uniqueItems": true },
        "errorTypes": { "type": "array", "items": { "$ref": "#/definitions/SessionDiagnosticName" }, "uniqueItems": true },
        "exitCode": { "$ref": "#/definitions/SessionExitCode" }
      },
      "required": ["categories", "errorCodes", "errorTypes"],
      "additionalProperties": {}
    },
    "CollectionData": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": { "type": "string" },
              "phase": { "type": "string" },
              "path": { "type": "string" },
              "events": { "$ref": "#/definitions/SessionCount" },
              "timestampUnit": { "type": "string", "enum": ["seconds", "milliseconds"] }
            },
            "required": ["component", "phase", "path", "events"],
            "additionalProperties": false
          }
        },
        "warnings": { "$ref": "#/definitions/SessionCount" },
        "untimedEvents": { "$ref": "#/definitions/SessionCount" },
        "absentComponents": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["sources", "warnings", "untimedEvents", "absentComponents"],
      "additionalProperties": false
    },
    "CollectionWarningData": { "type": "object", "properties": { "code": { "type": "string" }, "path": { "type": "string" }, "line": { "type": "number", "minimum": 1, "multipleOf": 1 } }, "required": ["code"], "additionalProperties": {} },
    "DailyAICDecisionData": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["disabled", "skipped", "under_budget", "exceeded", "structural_error", "transient_error"] },
        "exceeded": { "type": "boolean" },
        "total": { "type": "number" },
        "estimated": { "type": "number" },
        "threshold": { "type": "number" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "DetectionResultData": {
      "type": "object",
      "properties": {
        "jobResult": { "type": "string" },
        "conclusion": { "type": "string" },
        "reason": { "type": "string" },
        "promptInjection": { "type": "boolean" },
        "secretLeak": { "type": "boolean" },
        "maliciousPatch": { "type": "boolean" }
      },
      "additionalProperties": {}
    },
    "DynamicWorkflowObservationData": {
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "toolCallId": { "type": "string" },
        "taskType": { "type": "string" },
        "workflowName": { "type": "string" },
        "status": { "type": "string" },
        "sessionId": { "type": "string" },
        "parentToolUseId": { "type": ["string", "null"] },
        "usage": {
          "type": "object",
          "properties": { "totalTokens": { "$ref": "#/definitions/SessionCount" }, "toolUses": { "$ref": "#/definitions/SessionCount" }, "durationMs": { "$ref": "#/definitions/SessionMetric" } },
          "additionalProperties": false
        },
        "tasks": { "type": "array", "items": { "$ref": "#/definitions/DynamicWorkflowTaskData" } },
        "workflowProgress": { "type": "array", "items": { "$ref": "#/definitions/DynamicWorkflowProgressData" } }
      },
      "additionalProperties": false
    },
    "DynamicWorkflowProgressData": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "index": { "$ref": "#/definitions/SessionCount" },
        "phaseIndex": { "$ref": "#/definitions/SessionCount" },
        "agentId": { "type": "string" },
        "model": { "type": "string" },
