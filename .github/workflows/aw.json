{
  "admission": true,
  "gateway-dispatch": true,
  "protected_files": { "exclude": [".changeset/*.md"] },
  "auto_upgrade": { "cron": "0 9 * * 1", "options": ["--pre-releases"] },
  "maintenance": {
    "action_failure_issue_expires": 12,
    "label_triggers": true
  },
  "utc": "-08:00",
  "work_queue": {
    "concurrency": 3,
    "pending_limit": 30,
    "retry": { "max_attempts": 3 },
    "issues": { "label": "work" },
    "pools": {
      "default": {},
      "smoke-work-queue": { "concurrency": 3 },
      "code-scanning": { "concurrency": 3 },
      "daily-reports": { "concurrency": 3, "per_account_limit": 1 },
      "engine-conformance": { "concurrency": 3, "per_account_limit": 1 }
    }
  }
}
