package sprintfbool

import "strconv"

func firstBadSprintfBool(b bool) string {
	return strconv.FormatBool(b) // want `use strconv\.FormatBool\(b\) instead of fmt\.Sprintf\("%t", b\)`
}

func secondBadSprintfBool(b bool) string {
	return strconv.FormatBool(b) // want `use strconv\.FormatBool\(b\) instead of fmt\.Sprintf\("%t", b\)`
}
