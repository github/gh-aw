package mapcopyloop

import "maps"

func clone(src map[string]int) map[string]int {
	return maps.Clone(src)
}

func bad() {
	src := map[string]int{"a": 1}
	dst := make(map[string]int)

	// want +1 `range-copy loop can be replaced with maps.Copy\(dst, src\)`
	maps.Copy(dst, src)

	var k string
	var v int
	for k, v = range src {
		dst[k] = v
	}
	_ = k
	_ = v

	// A shadowed package name prevents an unsafe suggested fix.
	{
		maps := struct{}{}
		_ = maps
		// want +1 `range-copy loop can be replaced with maps.Copy\(dst, src\)`
		for k, v := range src {
			dst[k] = v
		}
	}

	// Keep comments in the loop rather than dropping them in a suggested fix.
	// want +1 `range-copy loop can be replaced with maps.Copy\(dst, src\)`
	for k, v := range src {
		// copied entry
		dst[k] = v
	}

	nestedDst := map[string]map[string]int{"a": {}}
	// want +1 `range-copy loop can be replaced with maps.Copy\(nestedDst\[k\], src\)`
	for k, v := range src {
		nestedDst[k][k] = v
	}

	nextDst := func() map[string]int { return dst }
	// want +1 `range-copy loop can be replaced with maps.Copy\(nextDst\(\), src\)`
	for k, v := range src {
		nextDst()[k] = v
	}

	nextSrc := func() map[string]int { return src }
	// want +1 `range-copy loop can be replaced with maps.Copy\(dst, nextSrc\(\)\)`
	for k, v := range nextSrc() {
		dst[k] = v
	}
}

func good() {
	src := map[string]int{"a": 1}
	dst := make(map[string]int)

	for _, v := range src {
		dst["a"] = v
	}

	for k, _ := range src {
		dst[k] = 1
	}

	for k, v := range src {
		dst[k] += v
	}

	for k, v := range src {
		dst[k] = v
		_ = k
	}

	for k, v := range src {
		src[k] = v
	}

	dstAny := make(map[any]any)
	for k, v := range src {
		dstAny[k] = v
	}

	for k, v := range src { //nolint:mapcopyloop
		dst[k] = v
	}

	ints := map[int]int{1: 1}
	dstSlice := make([]int, 2)
	for k, v := range ints {
		dstSlice[k] = v
	}

	values := []int{1}
	for k, v := range values {
		dst[string(rune(k))] = v
	}
}
