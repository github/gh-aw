{
  "$defs": {
    "Decimal": {
      "maxLength": 256,
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "ProjectorRule": {
      "additionalProperties": false,
      "properties": {
        "pools": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "principal": {
          "$ref": "#/$defs/Decimal"
        },
        "ref": {
          "$ref": "#/$defs/Revision"
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "workflow": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": ["principal", "workflow", "ref", "pools", "repositories"],
      "type": "object"
    },
    "Revision": {
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "ProjectorRule.json",
  "$ref": "#/$defs/ProjectorRule",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectorRule"
}
