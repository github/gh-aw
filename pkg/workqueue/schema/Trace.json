        },
        "trace_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "$id": "Trace.json",
  "$ref": "#/$defs/Trace",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace"
}
