{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkQueueWorkTransaction.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "Work"
    },
    "work": {
      "$ref": "#/$defs/WorkQueueIdentity"
    },
    "claim": {
      "type": "null"
    },
    "attempt": {
      "type": "null"
    }
  },
  "required": ["version", "kind", "work", "claim", "attempt"],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "WorkQueueIdentity": {
      "type": "string",
      "minLength": 1
    }
  }
}
