{
  "$defs": {
    "AssignmentClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/Identity"
        },
        "handle": {
          "$ref": "#/$defs/Identity"
        },
        "result_refs": {
          "items": {
            "$ref": "#/$defs/ResultReference"
          },
          "type": "array"
        },
        "work": {
          "additionalProperties": {},
          "type": "object"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "handle",
        "claim_id",
        "work_id",
        "work",
        "result_refs"
      ],
      "type": "object"
    },
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "ResultReference": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "additionalProperties": {},
          "type": "object"
        },
        "result_commit_id": {
          "$ref": "#/$defs/Identity"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "work_id",
        "result_commit_id",
        "descriptor"
      ],
      "type": "object"
    }
  },
  "$id": "AssignmentClaim.json",
  "$ref": "#/$defs/AssignmentClaim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssignmentClaim"
}
