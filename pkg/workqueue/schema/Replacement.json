{
  "$defs": {
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "Replacement": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "const": "idempotent"
            },
            {
              "const": "compensated"
            },
            {
              "const": "inspection"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Identity"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "work_id",
        "disposition",
        "evidence"
      ],
      "type": "object"
    }
  },
  "$id": "Replacement.json",
  "$ref": "#/$defs/Replacement",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replacement"
}
