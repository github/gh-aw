{
  "$defs": {
    "Decimal": {
      "maxLength": 256,
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "Revision": {
      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "type": "string"
    },
    "RunBinding": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "workflow_dispatch"
        },
        "principal": {
          "$ref": "#/$defs/Identity"
        },
        "ref": {
          "$ref": "#/$defs/Revision"
        },
        "repository": {
          "$ref": "#/$defs/Identity"
        },
        "run_attempt": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/Decimal"
        },
        "workflow": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "run_id",
        "run_attempt",
        "repository",
        "workflow",
        "ref",
        "principal",
        "event"
      ],
      "type": "object"
    }
  },
  "$id": "RunBinding.json",
  "$ref": "#/$defs/RunBinding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunBinding"
}
