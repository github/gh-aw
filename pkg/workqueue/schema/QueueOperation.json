        "reconciliation": {
          "$ref": "#/$defs/ReconciliationPolicy"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        }
      },
      "required": [
        "default_profile",
        "profiles",
        "logical_limit",
        "native_limit",
        "allowed_repositories",
        "max_observation_age_ms",
        "retry",
        "reconciliation"
