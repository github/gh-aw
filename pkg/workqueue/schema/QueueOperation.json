      "type": "object"
    },
    "ControlOperation": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "anyOf": [
            {
              "const": "admission_paused"
            },
            {
              "const": "grants_paused"
            },
            {
              "const": "credential_generation"
            }
          ]
