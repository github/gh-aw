        "pools": {
          "additionalProperties": {
            "$ref": "#/$defs/PoolPolicy"
          },
          "type": "object",
          "x-forbid-key-ascii-controls": true,
          "x-key-min-utf8-bytes": 1,
          "x-key-utf8-max-bytes": 256
        },
        "producers": {
          "additionalProperties": {
            "$ref": "#/$defs/ProducerRule"
          },
          "type": "object",
          "x-forbid-key-ascii-controls": true,
          "x-key-min-utf8-bytes": 1,
          "x-key-utf8-max-bytes": 256
        }
      },
      "required": [
        "mode",
        "class_weights",
        "accounting_weights",
        "producers",
        "pools",
        "limits"
      ],
      "type": "object"
    },
    "ReasonCode": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
