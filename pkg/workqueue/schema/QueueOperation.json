        "claim_id": {
          "$ref": "#/$defs/Identity"
        },
        "completion_id": {
          "$ref": "#/$defs/Identity"
        },
        "descriptor": {
          "additionalProperties": {},
          "type": "object"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "kind": {
          "const": "Result"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "work_id",
        "claim_id",
        "completion_id",
        "descriptor",
        "evidence"
      ],
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "backoff_ms": {
          "$ref": "#/$defs/Timestamp"
        },
        "max_attempts": {
          "$ref": "#/$defs/CountBound"
        }
      },
      "required": [
        "max_attempts",
        "backoff_ms"
      ],
      "type": "object"
