      "anyOf": [
        {
          "$ref": "#/$defs/WorkEdge"
        },
        {
          "$ref": "#/$defs/IssueEdge"
        },
        {
          "$ref": "#/$defs/PullRequestEdge"
        }
      ]
    },
    "DispatchOperation": {
      "additionalProperties": false,
      "properties": {
        "dispatch_id": {
          "$ref": "#/$defs/Identity"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "kind": {
          "const": "Dispatch"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "run": {
          "$ref": "#/$defs/RunBinding"
        },
        "sender": {
          "$ref": "#/$defs/Actor"
        },
        "state": {
          "anyOf": [
            {
              "const": "started"
            },
            {
              "const": "bound"
            },
            {
              "const": "rejected"
            },
            {
              "const": "uncertain"
            },
            {
              "const": "unresolved"
            }
          ]
        }
      },
      "required": [
        "kind",
        "dispatch_id",
        "state"
