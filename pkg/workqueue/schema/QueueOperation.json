        },
        "principal": {
          "$ref": "#/$defs/Identity"
        },
        "repository": {
          "$ref": "#/$defs/Identity"
        },
        "role": {
          "anyOf": [
            {
              "const": "administrator"
            },
            {
              "const": "producer"
            },
            {
              "const": "dispatcher"
            },
            {
              "const": "worker"
            },
            {
              "const": "reconciler"
            }
          ]
        },
        "run_attempt": {
          "$ref": "#/$defs/CountBound"
