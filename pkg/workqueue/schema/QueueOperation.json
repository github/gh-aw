        "kind": {
          "anyOf": [
            {
              "const": "prelaunch"
            },
            {
              "const": "nonlaunch"
            },
            {
              "const": "terminal_run"
            },
            {
              "const": "delivery"
            },
            {
              "const": "reconciliation"
            }
          ]
        },
        "principal": {
          "$ref": "#/$defs/Identity"
        },
        "receipt": {
          "$ref": "#/$defs/Identity"
        },
        "ref": {
          "$ref": "#/$defs/Revision"
        },
        "repository": {
          "$ref": "#/$defs/Identity"
        },
        "run_attempt": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/Decimal"
        },
        "source": {
          "anyOf": [
            {
              "const": "trusted_publisher"
            },
            {
              "const": "github_api"
            },
            {
              "const": "trusted_activation"
            },
            {
              "const": "verified_receipts"
            }
          ]
        },
        "status": {
          "const": "completed"
        },
        "workflow": {
          "$ref": "#/$defs/Identity"
        }
