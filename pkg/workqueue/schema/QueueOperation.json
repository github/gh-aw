      "type": "object"
    },
    "ClaimBound": {
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "ClaimCancellationOperation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "const": "ClaimCancellation"
