      "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$",
      "type": "string"
    },
    "RunBinding": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "workflow_dispatch"
        },
        "principal": {
          "$ref": "#/$defs/Identity"
        },
        "ref": {
          "$ref": "#/$defs/Revision"
        },
        "repository": {
          "$ref": "#/$defs/Identity"
        },
        "run_attempt": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/Decimal"
        },
        "workflow": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "run_id",
        "run_attempt",
        "repository",
        "workflow",
        "ref",
        "principal",
        "event"
      ],
      "type": "object"
    },
    "Timestamp": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Weight": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
