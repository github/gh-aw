        "pending_nodes": {
          "$ref": "#/$defs/CountBound"
        },
        "predecessors": {
          "$ref": "#/$defs/CountBound"
        },
        "recovery_bytes": {
          "$ref": "#/$defs/Timestamp"
        },
        "result_bytes": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "ledger_bytes",
        "recovery_bytes",
        "payload_bytes",
        "graph_nodes",
        "predecessors",
        "pending_nodes",
        "operations",
        "assignment_bytes",
        "result_bytes",
        "evidence_bytes",
        "observation_writes"
      ],
      "type": "object"
    },
    "ObservationOperation": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
