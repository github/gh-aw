              "$ref": "#/$defs/Identity"
            }
          ]
        }
      },
      "required": [
        "kind",
        "control",
        "value",
        "reason"
      ],
      "type": "object"
    },
    "CountBound": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
    },
    "Decimal": {
      "maxLength": 256,
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "DeliveryFailureOperation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/Identity"
        },
        "completion_id": {
          "$ref": "#/$defs/Identity"
        },
        "disposition": {
          "anyOf": [
            {
              "const": "none"
            },
            {
              "const": "partial"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "kind": {
          "const": "DeliveryFailure"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
