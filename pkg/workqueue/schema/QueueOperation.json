          "$ref": "#/$defs/Resource"
        }
      },
      "required": [
        "kind",
        "resource",
        "condition"
      ],
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "assignment_bytes": {
          "$ref": "#/$defs/Timestamp"
        },
        "evidence_bytes": {
          "$ref": "#/$defs/Timestamp"
        },
        "graph_nodes": {
          "$ref": "#/$defs/CountBound"
        },
        "ledger_bytes": {
          "$ref": "#/$defs/Timestamp"
        },
        "observation_writes": {
          "$ref": "#/$defs/CountBound"
        },
        "operations": {
          "$ref": "#/$defs/CountBound"
        },
        "payload_bytes": {
          "$ref": "#/$defs/Timestamp"
