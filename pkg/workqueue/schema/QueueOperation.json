          "$ref": "#/$defs/Identity"
        },
        "repository_id": {
          "$ref": "#/$defs/Decimal"
        },
        "resource_id": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "kind",
        "host",
        "repository",
        "repository_id",
        "resource_id",
        "number"
      ],
      "type": "object"
