        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "work_id",
        "claim_id",
        "dispatch_id",
        "handle",
        "observations"
      ],
      "type": "object"
    },
    "CompletionOperation": {
      "additionalProperties": false,
      "properties": {
        "claim_handle": {
          "$ref": "#/$defs/Identity"
        },
        "claim_id": {
          "$ref": "#/$defs/Identity"
        },
        "dispatch_id": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "const": "Completion"
        },
        "run_attempt": {
          "const": 1
        },
        "run_id": {
          "$ref": "#/$defs/Decimal"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "work_id",
        "claim_id",
        "dispatch_id",
        "claim_handle",
        "run_id",
        "run_attempt"
