        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "retry_not_before": {
          "$ref": "#/$defs/Timestamp"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "work_id",
        "claim_id",
        "reason",
        "retry_not_before"
      ],
      "type": "object"
