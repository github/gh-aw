          "type": "array"
        },
        "priorities": {
          "items": {
            "$ref": "#/$defs/Priority"
          },
          "type": "array"
        }
      },
      "required": [
        "pools",
        "priorities",
        "fairness_keys"
      ],
      "type": "object"
    },
    "PullRequestEdge": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "const": "merged"
