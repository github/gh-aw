        {
          "$ref": "#/$defs/ControlOperation"
        },
        {
          "$ref": "#/$defs/WorkOperation"
        },
        {
          "$ref": "#/$defs/ClaimOperation"
        },
        {
          "$ref": "#/$defs/CompletionOperation"
        },
        {
          "$ref": "#/$defs/ResultOperation"
        },
        {
          "$ref": "#/$defs/DeliveryFailureOperation"
        },
        {
          "$ref": "#/$defs/ObservationOperation"
        },
        {
          "$ref": "#/$defs/ClaimCancellationOperation"
        },
        {
          "$ref": "#/$defs/WorkCancellationOperation"
        },
        {
          "$ref": "#/$defs/DispatchOperation"
        },
        {
          "$ref": "#/$defs/ReleaseOperation"
        }
      ]
