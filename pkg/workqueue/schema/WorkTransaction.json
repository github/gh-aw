{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkTransaction.json",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "const": 3 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "kind": {
      "type": "string",
      "const": "Work"
    },
    "work_id": {
      "type": "string"
    },
    "work": {
      "$ref": "#/$defs/RecordUnknown"
    }
  },
  "required": ["kind", "work_id", "work"],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "RecordUnknown": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {}
    }
  }
}
