{
  "$defs": {
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "ReasonCode": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "WorkCancellationOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "WorkCancellation"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "work_id",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "WorkCancellationOperation.json",
  "$ref": "#/$defs/WorkCancellationOperation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkCancellationOperation"
}
