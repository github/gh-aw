{
  "$defs": {
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "Priority": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "ReasonCode": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "WorkPriorityOperation": {
      "additionalProperties": false,
      "properties": {
        "expected_priority": {
          "$ref": "#/$defs/Priority"
        },
        "kind": {
          "const": "WorkPriority"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "work_id": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": ["kind", "work_id", "priority", "expected_priority", "reason"],
      "type": "object"
    }
  },
  "$id": "WorkPriorityOperation.json",
  "$ref": "#/$defs/WorkPriorityOperation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkPriorityOperation"
}
