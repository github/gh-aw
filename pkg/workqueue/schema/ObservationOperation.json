{
  "$defs": {
    "Decimal": {
      "maxLength": 256,
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
    },
    "Identity": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-forbid-ascii-controls": true,
      "x-utf8-max-bytes": 256
    },
    "ObservationOperation": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "const": "completed"
            },
            {
              "const": "closed"
            },
            {
              "const": "merged"
            }
          ]
        },
        "credential_generation": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "const": "Observation"
        },
        "merge_commit": {
          "$ref": "#/$defs/Identity"
        },
        "merged": {
          "type": "boolean"
        },
        "observation_id": {
          "$ref": "#/$defs/Identity"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "read_status": {
          "$ref": "#/$defs/Identity"
        },
        "resource": {
          "$ref": "#/$defs/Resource"
        },
        "resource_state": {
          "anyOf": [
            {
              "const": "open"
            },
            {
              "const": "closed"
            }
          ]
        },
        "source_updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "anyOf": [
            {
              "const": "ready"
            },
            {
              "const": "waiting"
            },
            {
              "const": "failed"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "state_reason": {
          "anyOf": [
            {
              "const": "completed"
            },
            {
              "const": "not_planned"
            },
            {
              "const": "reopened"
            }
          ]
        }
      },
      "required": [
        "kind",
        "observation_id",
        "resource",
        "condition",
        "state",
        "observed_at",
        "credential_generation",
        "read_status"
      ],
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "anyOf": [
            {
              "const": "issue"
            },
            {
              "const": "pull_request"
            }
          ]
        },
        "number": {
          "$ref": "#/$defs/Decimal"
        },
        "repository": {
          "$ref": "#/$defs/Identity"
        },
        "repository_id": {
          "$ref": "#/$defs/Decimal"
        },
        "resource_id": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "kind",
        "host",
        "repository",
        "repository_id",
        "resource_id",
        "number"
      ],
      "type": "object"
    },
    "Timestamp": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "ObservationOperation.json",
  "$ref": "#/$defs/ObservationOperation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservationOperation"
}
