{
  "jira_issue": {
    "provider": "jira",
    "actions": ["opened", "edited", "closed", "reopened", "labeled", "unlabeled", "deleted"],
    "native_events": {
      "opened": "jira:issue_created",
      "edited": "jira:issue_updated",
      "closed": "jira:issue_updated",
      "reopened": "jira:issue_updated",
      "labeled": "jira:issue_updated",
      "unlabeled": "jira:issue_updated",
      "deleted": "jira:issue_deleted"
    },
    "description": "Experimental. Jira Cloud issue lifecycle and unambiguous single-label changes. Closed/reopened means resolution set/cleared, not a guessed status name. Multi-label changelog string deltas are not normalized.",
    "source": "https://developer.atlassian.com/cloud/jira/platform/webhooks/",
    "availability": ["Jira Cloud tenant"],
    "filters": {
      "issue_id": { "path": ["issue", "id"], "type": "string", "description": "Jira issue database ID." },
      "issue_key": { "path": ["issue", "key"], "type": "string", "description": "Current human-readable issue key." },
      "project": { "path": ["issue", "fields", "project", "key"], "type": "string", "description": "Jira project key." },
      "labels": { "path": ["issue", "fields", "labels", "*"], "type": "string", "description": "A current issue label; not necessarily the label changed by this delivery." },
      "status": { "path": ["issue", "fields", "status", "name"], "type": "string", "description": "Current workflow status name, not a lifecycle transition." },
      "resolution": { "path": ["issue", "fields", "resolution", "id"], "type": "string", "description": "Current resolution ID, when set." },
      "sender": { "path": ["user", "accountId"], "type": "string", "description": "Jira account ID of the actor; not dispatch authorization." }
    }
  },
  "azure_devops_issue": {
    "provider": "azure-devops",
    "actions": ["opened", "edited", "closed", "reopened", "labeled", "unlabeled", "deleted", "restored"],
    "native_events": {
      "opened": "workitem.created",
      "edited": "workitem.updated",
      "closed": "workitem.updated",
      "reopened": "workitem.updated",
      "labeled": "workitem.updated",
      "unlabeled": "workitem.updated",
      "deleted": "workitem.deleted",
      "restored": "workitem.restored"
    },
    "description": "Experimental. Azure DevOps work item events. Closed/reopened requires explicitly configured closed-states and native old/new state values; label changes are old/new System.Tags set differences.",
    "source": "https://learn.microsoft.com/en-us/azure/devops/service-hooks/events?view=azure-devops#work-item",
    "availability": ["Azure DevOps project"],
    "filters": {
      "collection_id": { "path": ["resourceContainers", "collection", "id"], "type": "string", "description": "Immutable source collection ID." },
      "project_id": { "path": ["resourceContainers", "project", "id"], "type": "string", "description": "Immutable source project ID." },
      "state.from": {
        "path": ["resource", "fields", "System.State", "oldValue"],
        "type": "string",
        "description": "Previous state in a delivered work item update delta.",
        "actions": ["edited", "closed", "reopened", "labeled", "unlabeled"]
      },
      "state.to": { "path": ["resource", "fields", "System.State", "newValue"], "type": "string", "description": "New state in a delivered work item update delta.", "actions": ["edited", "closed", "reopened", "labeled", "unlabeled"] },
      "tags.from": {
        "path": ["resource", "fields", "System.Tags", "oldValue"],
        "type": "string",
        "description": "Entire previous semicolon-separated tag string, not a single tag.",
        "actions": ["edited", "closed", "reopened", "labeled", "unlabeled"]
      },
      "tags.to": {
        "path": ["resource", "fields", "System.Tags", "newValue"],
        "type": "string",
        "description": "Entire new semicolon-separated tag string, not a single tag.",
        "actions": ["edited", "closed", "reopened", "labeled", "unlabeled"]
      }
    }
  }
}
