          GH_AW_DOCKER_HOST=""
          if [[ "${DOCKER_HOST:-}" =~ ^tcp:// ]]; then
            GH_AW_DOCKER_HOST="${DOCKER_HOST}"
          fi
          if [[ "${DOCKER_HOST:-}" =~ ^tcp:// ]]; then
            GH_AW_CHROOT_BINARIES_SOURCE_PATH="${GH_AW_SETUP_ROOT}" GH_AW_CHROOT_IDENTITY_HOME="${GH_AW_SETUP_ROOT}/home" node "${GH_AW_SETUP_ROOT}/actions/patch_awf_chroot_config.cjs"
          fi
          GH_AW_TOOL_CACHE_MOUNT=""
          GH_AW_TOOL_CACHE="${RUNNER_TOOL_CACHE:?RUNNER_TOOL_CACHE must be set}"
          if [ -d "$GH_AW_TOOL_CACHE" ]; then
            if [[ "$GH_AW_TOOL_CACHE" != /opt/* ]]; then
              GH_AW_TOOL_CACHE_MOUNT="$GH_AW_TOOL_CACHE:$GH_AW_TOOL_CACHE:ro"
            fi
          fi
          unset GH_AW_RUNTIME_TOKEN GH_AW_RUNTIME_ID GH_AW_SETUP_ID
          # shellcheck disable=SC1003,SC2016,SC2086
          unset GH_AW_RUNTIME_TOKEN GH_AW_RUNTIME_ID GH_AW_SETUP_ID
          mkdir -p "${GH_AW_RUNTIME_ROOT}"
          evidence_tmp="${GH_AW_RUNTIME_ROOT}/agent_execution.json.tmp"
          printf '{"version":1,"component":"agent","run_id":%s,"run_attempt":%s,"state":"started"}\n' "$GITHUB_RUN_ID" "$GITHUB_RUN_ATTEMPT" > "$evidence_tmp"
          mv "$evidence_tmp" "${GH_AW_RUNTIME_ROOT}/agent_execution.json"
          export GH_AW_AWF_EXECUTION_COMPONENT="agent"
          export GH_AW_AWF_EXECUTION_EVIDENCE_FILE="${GH_AW_RUNTIME_ROOT}/agent_execution.json"
          GH_AW_AWF_ENGINE_NAME=copilot \
          GH_AW_AWF_HARNESS_MARKER='[copilot-harness]' \
          GH_AW_AWF_LOG_FILE=${GH_AW_RUNTIME_ROOT}/agent-stdio.log \
          GH_AW_AWF_ATTEMPT_LOG_NAME=copilot \
          bash "${GH_AW_SETUP_ROOT}/actions/run_awf_with_startup_retries.sh" -- \
            awf --config "${GH_AW_SETUP_ROOT}/awf-config.json" --container-workdir "${GITHUB_WORKSPACE}" --mount "${GH_AW_SETUP_ROOT}:${GH_AW_SETUP_ROOT}:ro" --mount "${GH_AW_SETUP_ROOT}:/host${GH_AW_SETUP_ROOT}:ro" ${GH_AW_ENGINE_STEP_TIMEOUT_MINUTES:+--agent-timeout "$GH_AW_ENGINE_STEP_TIMEOUT_MINUTES"} ${GH_AW_TOOL_CACHE_MOUNT:+--mount "$GH_AW_TOOL_CACHE_MOUNT"} ${GH_AW_DOCKER_HOST:+--docker-host "$GH_AW_DOCKER_HOST"} --env-all --exclude-env ACTIONS_ID_TOKEN_REQUEST_TOKEN --exclude-env ACTIONS_ID_TOKEN_REQUEST_URL --exclude-env COPILOT_GITHUB_TOKEN --exclude-env GH_AW_OTLP_ALL_HEADERS --exclude-env GH_AW_OTLP_ENDPOINTS --exclude-env GITHUB_MCP_SERVER_TOKEN --exclude-env MCP_GATEWAY_AGENT_ID --exclude-env OTEL_EXPORTER_OTLP_ENDPOINT --exclude-env OTEL_EXPORTER_OTLP_HEADERS --mount ${GH_AW_RUNTIME_ROOT}:${GH_AW_RUNTIME_ROOT}:rw --log-level info --session-state-dir ${GH_AW_RUNTIME_ROOT}/sandbox/agent/session-state --skip-pull \
            -- /bin/bash -c 'set +o histexpand; export PATH="${GH_AW_SETUP_ROOT}/mcp-cli/bin:$PATH" && : "${RUNNER_TOOL_CACHE:?RUNNER_TOOL_CACHE must be set}"; GH_AW_TOOL_CACHE="$RUNNER_TOOL_CACHE"; GH_AW_TOOL_BINS="$(find "$GH_AW_TOOL_CACHE" -maxdepth 5 -type d -name bin 2>/dev/null | tr "\n" ":")"; GH_AW_TOOL_BINS="${GH_AW_TOOL_BINS%:}"; export PATH="$PATH${GH_AW_TOOL_BINS:+:}$GH_AW_TOOL_BINS"; [ -n "$GOROOT" ] && export PATH="$GOROOT/bin:$PATH" || true; [ -n "$ERLANG_HOME" ] && export PATH="$ERLANG_HOME/bin:$PATH" || true && GH_AW_NODE_EXEC="${GH_AW_NODE_BIN:-}"; if [ -z "$GH_AW_NODE_EXEC" ] || [ ! -x "$GH_AW_NODE_EXEC" ]; then GH_AW_NODE_EXEC="$(command -v node 2>/dev/null || true)"; fi; if [ -z "$GH_AW_NODE_EXEC" ]; then echo "node runtime missing on this runner — check runtimes.node in workflow YAML" >&2; exit 127; fi; GH_AW_NPM_GLOBAL_ROOT="$(npm root -g 2>/dev/null || true)"; if [ -n "$GH_AW_NPM_GLOBAL_ROOT" ]; then export NODE_PATH="${GH_AW_NPM_GLOBAL_ROOT}${NODE_PATH:+:${NODE_PATH}}"; fi; "$GH_AW_NODE_EXEC" "${GH_AW_SETUP_ROOT}/actions/copilot_harness.cjs" "${GH_AW_SETUP_ROOT}/bin/copilot" --add-dir ${GH_AW_RUNTIME_ROOT}/ --log-level all --log-dir ${GH_AW_RUNTIME_ROOT}/sandbox/agent/logs/ --disable-builtin-mcps --no-ask-user --allow-tool github --allow-tool safeoutputs --allow-tool '\''shell(cat)'\'' --allow-tool '\''shell(curl:*)'\'' --allow-tool '\''shell(date)'\'' --allow-tool '\''shell(echo)'\'' --allow-tool '\''shell(github:*)'\'' --allow-tool '\''shell(grep)'\'' --allow-tool '\''shell(head)'\'' --allow-tool '\''shell(ls)'\'' --allow-tool '\''shell(playwright-cli:*)'\'' --allow-tool '\''shell(printf)'\'' --allow-tool '\''shell(pwd)'\'' --allow-tool '\''shell(safeoutputs:*)'\'' --allow-tool '\''shell(sort)'\'' --allow-tool '\''shell(tail)'\'' --allow-tool '\''shell(uniq)'\'' --allow-tool '\''shell(wc)'\'' --allow-tool '\''shell(yq)'\'' --allow-tool write --deny-tool workflow --allow-all-paths --add-dir "${GITHUB_WORKSPACE}" --prompt-file ${GH_AW_RUNTIME_ROOT}/aw-prompts/prompt.txt'
        env:
          AWF_REFLECT_ENABLED: 1
          COPILOT_AGENT_RUNNER_TYPE: STANDALONE
          COPILOT_DUMMY_BYOK: dummy-byok-key-for-offline-mode
          COPILOT_GITHUB_TOKEN: ${{ secrets.COPILOT_GITHUB_TOKEN }}
          COPILOT_MODEL: ${{ needs.activation.outputs.model-routing != 'true' && (vars.GH_AW_MODEL_AGENT_COPILOT || vars.GH_AW_DEFAULT_MODEL_COPILOT || 'default') || '' }}
          GH_AW_ENGINE_STEP_TIMEOUT_MINUTES: ${{ fromJSON(vars.GH_AW_DEFAULT_TIMEOUT_MINUTES || '20') }}
          GH_AW_LLM_PROVIDER: github
          GH_AW_MAX_AI_CREDITS: ${{ vars.GH_AW_DEFAULT_MAX_AI_CREDITS || '1000' }}
          GH_AW_MAX_TURNS: ${{ vars.GH_AW_DEFAULT_MAX_TURNS || '' }}
          GH_AW_MODEL_ROUTING: ${{ needs.activation.outputs.model-routing == 'true' && '1' || '0' }}
          GH_AW_PHASE: agent
          GH_AW_PROMPT: ${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/prompt.txt
          GH_AW_SAFE_OUTPUTS: ${{ steps.set-runtime-paths.outputs.GH_AW_SAFE_OUTPUTS }}
          GH_AW_TIMEOUT_MINUTES: ${{ fromJSON(vars.GH_AW_DEFAULT_TIMEOUT_MINUTES || '20') }}
          GH_AW_VERSION: dev
          GITHUB_API_URL: ${{ github.api_url }}
          GITHUB_AW: true
          GITHUB_COPILOT_INTEGRATION_ID: agentic-workflows
          GITHUB_COPILOT_PROMPT_MODE_EXTENSIONS: false
          GITHUB_HEAD_REF: ${{ github.head_ref }}
          GITHUB_MCP_SERVER_TOKEN: ${{ secrets.GH_AW_GITHUB_MCP_SERVER_TOKEN || secrets.GH_AW_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}
          GITHUB_REF_NAME: ${{ github.ref_name }}
          GITHUB_SERVER_URL: ${{ github.server_url }}
          GITHUB_STEP_SUMMARY: ${{ env.GH_AW_RUNTIME_ROOT }}/agent-step-summary.md
          GITHUB_WORKSPACE: ${{ github.workspace }}
          GIT_AUTHOR_EMAIL: github-actions[bot]@users.noreply.github.com
          GIT_AUTHOR_NAME: github-actions[bot]
          GIT_COMMITTER_EMAIL: github-actions[bot]@users.noreply.github.com
          GIT_COMMITTER_NAME: github-actions[bot]
          PLAYWRIGHT_BROWSERS_PATH: ${{ env.GH_AW_SETUP_ROOT }}/playwright-browsers
          RUNNER_TEMP: ${{ runner.temp }}
          TRACEPARENT: ${{ env.GITHUB_AW_OTEL_TRACE_ID != '' && env.GITHUB_AW_OTEL_PARENT_SPAN_ID != '' && format('00-{0}-{1}-01', env.GITHUB_AW_OTEL_TRACE_ID, env.GITHUB_AW_OTEL_PARENT_SPAN_ID) || '' }}
      - name: Log GitHub rate limits at agent end
        if: always()
        continue-on-error: true
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          github-token: ${{ secrets.GH_AW_GITHUB_MCP_SERVER_TOKEN || secrets.GH_AW_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { fetchAndLogRateLimit } = require(path.join(actionsDir, 'github_rate_limit_logger.cjs'));
            await fetchAndLogRateLimit(github, 'agent_end', true);
      - name: Detect agent errors
        if: always()
        id: detect-agent-errors
        continue-on-error: true
        env:
          GH_AW_AGENTIC_EXECUTION_OUTCOME: ${{ steps.agentic_execution.outcome }}
          GH_AW_ENGINE_STEP_TIMEOUT_MINUTES: ${{ fromJSON(vars.GH_AW_DEFAULT_TIMEOUT_MINUTES || '20') }}
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'detect_agent_errors.cjs'));
            await main();
      - name: Configure Git credentials
        env:
          GH_AW_GIT_REPOSITORY: ${{ github.repository }}
          GITHUB_SERVER_URL: ${{ github.server_url }}
          GITHUB_TOKEN: ${{ github.token }}
        run: bash "${GH_AW_SETUP_ROOT}/actions/configure_git_credentials.sh"
      - name: Copy Copilot session state files to logs
        if: always()
        continue-on-error: true
        run: bash "${GH_AW_SETUP_ROOT}/actions/copy_copilot_session_state.sh"
      - name: Stop MCP Gateway
        if: always()
        continue-on-error: true
        env:
          MCP_GATEWAY_PORT: ${{ steps.start-mcp-gateway.outputs.gateway-port }}
          MCP_GATEWAY_AGENT_ID: ${{ steps.start-mcp-gateway.outputs.gateway-agent-id }}
          GATEWAY_PID: ${{ steps.start-mcp-gateway.outputs.gateway-pid }}
        run: |
          bash "${GH_AW_SETUP_ROOT}/actions/stop_mcp_gateway.sh" "$GATEWAY_PID"
      - name: Redact secrets in logs
        id: redact_secrets
        if: always()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'redact_secrets.cjs'));
            await main();
        env:
          GH_AW_SECRET_NAMES: 'COPILOT_GITHUB_TOKEN,GH_AW_GITHUB_MCP_SERVER_TOKEN,GH_AW_GITHUB_TOKEN,GITHUB_TOKEN'
          SECRET_COPILOT_GITHUB_TOKEN: ${{ secrets.COPILOT_GITHUB_TOKEN }}
          SECRET_GH_AW_GITHUB_MCP_SERVER_TOKEN: ${{ secrets.GH_AW_GITHUB_MCP_SERVER_TOKEN }}
          SECRET_GH_AW_GITHUB_TOKEN: ${{ secrets.GH_AW_GITHUB_TOKEN }}
          SECRET_GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      - name: Validate recovery envelopes before upload
        id: validate_recovery_envelopes
        if: always() && steps.redact_secrets.outcome == 'success'
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_OBJECT_PACK_MAX_BYTES: ${{ vars.GH_AW_OBJECT_PACK_MAX_BYTES }}
          GH_AW_OBJECT_PACK_MAX_OBJECTS: ${{ vars.GH_AW_OBJECT_PACK_MAX_OBJECTS }}
          GH_AW_OBJECT_PACK_TIMEOUT_MS: ${{ vars.GH_AW_OBJECT_PACK_TIMEOUT_MS }}
          GH_AW_OBJECT_PACK_FETCH_DEPTHS: ${{ vars.GH_AW_OBJECT_PACK_FETCH_DEPTHS }}
          GH_AW_RECOVERY_ADDITIONAL_ROOTS: '[]'
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { main } = require(path.join(actionsDir, 'validate_recovery_envelopes.cjs'));
            main({ core, additionalRoots: JSON.parse(process.env.GH_AW_RECOVERY_ADDITIONAL_ROOTS) });
      - name: Append agent step summary
        if: always() && steps.redact_secrets.outcome == 'success'
        run: bash "${GH_AW_SETUP_ROOT}/actions/append_agent_step_summary.sh"
      - name: Copy Safe Outputs
        if: always()
        env:
          GH_AW_SAFE_OUTPUTS: ${{ steps.set-runtime-paths.outputs.GH_AW_SAFE_OUTPUTS }}
        run: |
          mkdir -p ${{ env.GH_AW_RUNTIME_ROOT }}
          cp "$GH_AW_SAFE_OUTPUTS" ${{ env.GH_AW_RUNTIME_ROOT }}/safeoutputs.jsonl 2>/dev/null || true
      - name: Ingest agent output
        id: collect_output
        if: always()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_SAFE_OUTPUTS: ${{ steps.set-runtime-paths.outputs.GH_AW_SAFE_OUTPUTS }}
          GH_AW_ALLOWED_DOMAINS: "archive.ubuntu.com,azure.archive.ubuntu.com,cdn.playwright.dev,crl.geotrust.com,crl.globalsign.com,crl.identrust.com,crl.sectigo.com,crl.thawte.com,crl.usertrust.com,crl.verisign.com,crl3.digicert.com,crl4.digicert.com,crls.ssl.com,json-schema.org,json.schemastore.org,keyserver.ubuntu.com,ocsp.digicert.com,ocsp.geotrust.com,ocsp.globalsign.com,ocsp.identrust.com,ocsp.sectigo.com,ocsp.ssl.com,ocsp.thawte.com,ocsp.usertrust.com,ocsp.verisign.com,playwright.download.prss.microsoft.com,s.symcb.com,s.symcd.com,security.ubuntu.com,ts-crl.ws.symantec.com,ts-ocsp.ws.symantec.com"
          GITHUB_SERVER_URL: ${{ github.server_url }}
          GITHUB_API_URL: ${{ github.api_url }}
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'collect_ndjson_output.cjs'));
            await main();
      - name: Parse agent logs for step summary
        if: always()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_AGENT_OUTPUT: ${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/agent/logs/
          GH_AW_SAFE_OUTPUTS: ${{ steps.set-runtime-paths.outputs.GH_AW_SAFE_OUTPUTS }}
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'parse_copilot_log.cjs'));
            await main();
      - name: Parse MCP Gateway logs for step summary
        if: always()
        id: parse-mcp-gateway
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'parse_mcp_gateway_log.cjs'));
            await main();
      - name: Print firewall logs
        if: always()
        continue-on-error: true
        env:
          AWF_LOGS_DIR: ${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/logs
        run: bash "${GH_AW_SETUP_ROOT}/actions/print_firewall_logs.sh" --rootless
      - name: Parse token usage for step summary
        if: always()
        id: parse-token-usage
        continue-on-error: true
        env:
          GH_AW_MODEL_ROUTING_ENABLED: ${{ needs.activation.outputs.model-routing == 'true' && 'true' || 'false' }}
          GH_AW_ENGINE_ID: "copilot"
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'parse_token_usage.cjs'));
            await main();
      - name: Print AWF reflect summary
        if: always()
        continue-on-error: true
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'awf_reflect_summary.cjs'));
            await main();
      - name: Generate observability summary
        if: always()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'generate_observability_summary.cjs'));
            await main(core);
      - name: Write agent output placeholder if missing
        if: always()
        run: |
          if [ ! -f ${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json ]; then
            echo '{"items":[]}' > ${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json
          fi
      - name: Emit OTLP job conclusion before artifacts
        if: always() && env.GH_AW_OTEL_METRICS == 'true'
        continue-on-error: true
        run: node "${GH_AW_SETUP_ROOT}/actions/action_conclusion_otlp.cjs"
        env:
          INPUT_JOB_NAME: ${{ github.job }}
          GH_AW_JOB_RESULT: ${{ job.status }}
          GH_AW_OTEL_CONCLUSION_PREUPLOAD: 'true'
      - name: Validate recovery envelopes before upload
        id: validate_final_recovery_envelopes
        if: always() && steps.redact_secrets.outcome == 'success'
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_OBJECT_PACK_MAX_BYTES: ${{ vars.GH_AW_OBJECT_PACK_MAX_BYTES }}
          GH_AW_OBJECT_PACK_MAX_OBJECTS: ${{ vars.GH_AW_OBJECT_PACK_MAX_OBJECTS }}
          GH_AW_OBJECT_PACK_TIMEOUT_MS: ${{ vars.GH_AW_OBJECT_PACK_TIMEOUT_MS }}
          GH_AW_OBJECT_PACK_FETCH_DEPTHS: ${{ vars.GH_AW_OBJECT_PACK_FETCH_DEPTHS }}
          GH_AW_RECOVERY_ADDITIONAL_ROOTS: '["${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/prompt.txt","${{ env.GH_AW_RUNTIME_ROOT }}/agent_execution.json","${{ env.GH_AW_RUNTIME_ROOT }}/agent_execution_exit_code.txt","${{ env.GH_AW_RUNTIME_ROOT }}/agent-session.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/agent-errors.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/user.txt","${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/system.txt","${{ env.GH_AW_RUNTIME_ROOT }}/skill_inventory.json","${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/agent/logs/","${{ env.GH_AW_RUNTIME_ROOT }}/redacted-urls.log","${{ env.GH_AW_RUNTIME_ROOT }}/mcp-logs/","${{ env.GH_AW_RUNTIME_ROOT }}/agent_usage.json","${{ env.GH_AW_RUNTIME_ROOT }}/agent/aw_info.json","${{ env.GH_AW_RUNTIME_ROOT }}/agent/awf-routing-outcome.json","${{ env.GH_AW_RUNTIME_ROOT }}/runtime/aw_info.json","${{ env.GH_AW_RUNTIME_ROOT }}/agent_usage.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/agent/model-endpoint-mismatch.json","${{ env.GH_AW_RUNTIME_ROOT }}/agent/model-resolution.json","${{ env.GH_AW_RUNTIME_ROOT }}/agent-stdio.log","${{ env.GH_AW_RUNTIME_ROOT }}/agent/harness_retry.json","${{ env.GH_AW_RUNTIME_ROOT }}/pre-agent-audit.txt","${{ env.GH_AW_RUNTIME_ROOT }}/github_rate_limits.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/otel.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/otlp-export-errors.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/safeoutputs.jsonl","${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json","${{ env.GH_AW_RUNTIME_ROOT }}/awf-config.json","${{ env.GH_AW_RUNTIME_ROOT }}/awf-resolved-config.json","${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/logs/","${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/audit/","${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/awf-reflect.json"]'
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { main } = require(path.join(actionsDir, 'validate_recovery_envelopes.cjs'));
            main({ core, additionalRoots: JSON.parse(process.env.GH_AW_RECOVERY_ADDITIONAL_ROOTS) });
      - name: Upload agent artifacts
        if: always() && steps.redact_secrets.outcome == 'success' && steps.validate_recovery_envelopes.outcome == 'success' && steps.validate_final_recovery_envelopes.outcome == 'success'
        continue-on-error: true
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: agent
          path: |
            ${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/prompt.txt
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent_execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent_execution_exit_code.txt
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent-session.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent-errors.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/user.txt
            ${{ env.GH_AW_RUNTIME_ROOT }}/aw-prompts/system.txt
            ${{ env.GH_AW_RUNTIME_ROOT }}/skill_inventory.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/agent/logs/
            ${{ env.GH_AW_RUNTIME_ROOT }}/redacted-urls.log
            ${{ env.GH_AW_RUNTIME_ROOT }}/mcp-logs/
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent_usage.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent/aw_info.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent/awf-routing-outcome.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/runtime/aw_info.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent/model-endpoint-mismatch.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent/model-resolution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent-stdio.log
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent/harness_retry.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/pre-agent-audit.txt
            ${{ env.GH_AW_RUNTIME_ROOT }}/github_rate_limits.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/otel.jsonl
            ${{ env.GH_AW_OTEL_METRICS == 'true' && '${{ env.GH_AW_RUNTIME_ROOT }}/otel-metrics.jsonl' || '' }}
            ${{ env.GH_AW_RUNTIME_ROOT }}/otlp-export-errors.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/safeoutputs.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/awf-config.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/awf-resolved-config.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/logs/
            ${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/audit/
            ${{ env.GH_AW_RUNTIME_ROOT }}/sandbox/firewall/awf-reflect.json
          if-no-files-found: ignore
          retention-days: ${{ vars.GH_AW_DEFAULT_ARTIFACT_RETENTION_DAYS || '0' }}

      - name: Clean isolated runtime directories
        if: ${{ always() && env.GH_AW_SETUP_ACTION_COMPLETE != 'true' }}
        shell: bash
        run: |
          set -euo pipefail
          if [[ -z "${GH_AW_RUNTIME_ROOT:-}" || -z "${GH_AW_SETUP_ROOT:-}" || -z "${GH_AW_RUNTIME_TOKEN:-}" ]]; then exit 0; fi
          if [[ ! "$GH_AW_RUNTIME_ROOT" =~ ^/tmp/gh-aw-run\.[A-Za-z0-9]+$ ]]; then echo "::warning::Invalid runtime cleanup root"; exit 0; fi
          if [[ -z "${RUNNER_TEMP:-}" ]]; then exit 0; fi
          setup_parent="$(cd -- "$RUNNER_TEMP" && pwd -P)" || exit 0
          if [[ "${GH_AW_SETUP_ROOT%/*}" != "$setup_parent" || ! "${GH_AW_SETUP_ROOT##*/}" =~ ^gh-aw-setup\.[A-Za-z0-9]{10}$ ]]; then echo "::warning::Invalid setup cleanup root"; exit 0; fi
          owner_hash="$(printf '%s' "$GH_AW_RUNTIME_TOKEN" | sha256sum | cut -d ' ' -f1)" || exit 0
          for kind in runtime setup; do
            if [[ "$kind" == runtime ]]; then root="$GH_AW_RUNTIME_ROOT"; identity="${GH_AW_RUNTIME_ID:-}"; else root="$GH_AW_SETUP_ROOT"; identity="${GH_AW_SETUP_ID:-}"; fi
            if [[ ! -e "$root" && ! -L "$root" ]]; then continue; fi
            if [[ -L "$root" || ! -d "$root" || "$(stat -c '%d:%i' "$root")" != "$identity" || "$(stat -c '%u' "$root")" != "$(id -u)" || "$(stat -c '%a' "$root")" != 700 ]]; then echo "::warning::Refusing unowned runtime cleanup"; continue; fi
            marker="$root/.gh-aw-runtime-owner"
            if [[ -L "$marker" || ! -f "$marker" || "$(cat -- "$marker")" != "$owner_hash" ]]; then echo "::warning::Refusing runtime cleanup without ownership"; continue; fi
            rm -rf -- "$root" || echo "::warning::Could not fully remove isolated $kind directory"
          done
  conclusion:
    name: conclusion
    needs:
      - activation
      - agent
      - safe_outputs
    if: >
      always() && (needs.agent.result != 'skipped' || needs.activation.result == 'failure' || needs.activation.outputs.lockdown_check_failed == 'true' ||
      needs.activation.outputs.oauth_token_check_failed == 'true' || needs.activation.outputs.stale_lock_file_failed == 'true' ||
      needs.activation.outputs.secret_verification_result == 'failed' || needs.activation.outputs.daily_ai_credits_exceeded == 'true' ||
      needs.activation.outputs.daily_ai_credits_guardrail_status == 'structural_error' || needs.activation.outputs.daily_ai_credits_guardrail_status == 'transient_error')
    runs-on: ubuntu-slim
    # Permissions for the conclusion job (workflow permissions default to none).
    permissions:
      actions: read # Read workflow runs and artifacts for workflow context.
      checks: read # Read check runs for workflow context.
      id-token: write # Request an OIDC token for authenticated services.
      issues: write # Create or update issues and comments.
      pull-requests: read # Read pull requests and review comments for workflow context.
    concurrency:
      group: "gh-aw-conclusion-playwright-cli-mode"
      cancel-in-progress: false
      queue: max
    env:
      GH_AW_JOB_DISPLAY_NAMES: "{\"activation\":\"activation\",\"agent\":\"agent\",\"conclusion\":\"conclusion\",\"safe_outputs\":\"safe_outputs\"}"
      GH_AW_JOB_RESULTS: "{\"activation\":{\"result\":\"${{ needs.activation.result }}\"},\"agent\":{\"result\":\"${{ needs.agent.result }}\"},\"safe_outputs\":{\"result\":\"${{ needs.safe_outputs.result }}\"}}"
      GH_AW_JOB_TIMING_ELIGIBLE: "{\"activation\":true,\"agent\":true,\"conclusion\":true,\"safe_outputs\":true}"
      GH_AW_RUNTIME_FEATURES: ${{ vars.GH_AW_RUNTIME_FEATURES }}
    steps:
      - name: Allocate isolated runtime directories
        id: gh-aw-runtime
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          GH_AW_RUNTIME_ROOT=""
          GH_AW_SETUP_ROOT=""
          trap 'status=$?; if [[ -n "$GH_AW_SETUP_ROOT" ]]; then rm -rf -- "$GH_AW_SETUP_ROOT"; fi; if [[ -n "$GH_AW_RUNTIME_ROOT" ]]; then rm -rf -- "$GH_AW_RUNTIME_ROOT"; fi; exit "$status"' EXIT
          GH_AW_RUNTIME_ROOT="$(mktemp -d /tmp/gh-aw-run.XXXXXXXXXX)"
          setup_parent="$(cd -- "${RUNNER_TEMP:?}" && pwd -P)"
          GH_AW_SETUP_ROOT="$(mktemp -d "$setup_parent/gh-aw-setup.XXXXXXXXXX")"
          GH_AW_RESOURCE_SUFFIX="${GH_AW_RUNTIME_ROOT##*/gh-aw-run.}"
          GH_AW_RUNTIME_TOKEN="$(openssl rand -hex 32)"
          printf '::add-mask::%s\n' "$GH_AW_RUNTIME_TOKEN"
          owner_hash="$(printf '%s' "$GH_AW_RUNTIME_TOKEN" | sha256sum | cut -d ' ' -f1)"
          printf '%s' "$owner_hash" > "$GH_AW_RUNTIME_ROOT/.gh-aw-runtime-owner"
          printf '%s' "$owner_hash" > "$GH_AW_SETUP_ROOT/.gh-aw-runtime-owner"
          case "$GH_AW_SETUP_ROOT" in *$'\n'*|*$'\r'*) echo "Invalid setup root" >&2; exit 1 ;; esac
          printf 'GH_AW_RUNTIME_ROOT=%s\nGH_AW_SETUP_ROOT=%s\nGH_AW_RESOURCE_SUFFIX=%s\nGH_AW_RUNTIME_TOKEN=%s\n' "$GH_AW_RUNTIME_ROOT" "$GH_AW_SETUP_ROOT" "$GH_AW_RESOURCE_SUFFIX" "$GH_AW_RUNTIME_TOKEN" >> "$GITHUB_ENV"
          printf 'GH_AW_RUNTIME_ID=%s\nGH_AW_SETUP_ID=%s\n' "$(stat -c '%d:%i' "$GH_AW_RUNTIME_ROOT")" "$(stat -c '%d:%i' "$GH_AW_SETUP_ROOT")" >> "$GITHUB_ENV"
          trap - EXIT
      - name: Checkout actions folder
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: github/gh-aw
          sparse-checkout: |
            actions
          fetch-depth: 1
          clean: false
          persist-credentials: false
      - name: Setup Scripts
        id: setup
        uses: ./actions/setup
        with:
          destination: ${{ env.GH_AW_SETUP_ROOT }}/actions
          job-name: ${{ github.job }}
          trace-id: ${{ needs.activation.outputs.setup-trace-id }}
          parent-span-id: ${{ needs.activation.outputs.setup-parent-span-id || needs.activation.outputs.setup-span-id }}
        env:
          GH_AW_SETUP_WORKFLOW_NAME: "Test Playwright CLI Mode"
          GH_AW_CURRENT_WORKFLOW_REF: ${{ github.repository }}/.github/workflows/playwright-cli-mode.lock.yml@${{ github.ref }}
          GH_AW_INFO_VERSION: "COPILOT_VERSION"
          GH_AW_INFO_AWF_VERSION: "vAWF_VERSION"
          GH_AW_INFO_ENGINE_ID: "copilot"
          GH_AW_SETUP_AW_CONTEXT: ${{ inputs.aw_context }}
      - name: Download agent output artifact
        id: download-agent-output
        continue-on-error: true
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: "{agent,agent-output-fallback}"
          merge-multiple: true
          path: ${{ env.GH_AW_RUNTIME_ROOT }}/
      - name: Setup agent output environment variable
        id: setup-agent-output-env
        if: steps.download-agent-output.outcome == 'success'
        run: |
          mkdir -p ${{ env.GH_AW_RUNTIME_ROOT }}/
          find "${{ env.GH_AW_RUNTIME_ROOT }}/" -type f -print
          if [ -f "${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json" ]; then
            echo "GH_AW_AGENT_OUTPUT=${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json" >> "$GITHUB_OUTPUT"
          fi
      - name: Download workflow metadata
        if: always()
        continue-on-error: true
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: info
          path: ${{ env.GH_AW_RUNTIME_ROOT }}/
      - name: Restore runtime model metadata
        if: always()
        run: |
          if [ -f ${{ env.GH_AW_RUNTIME_ROOT }}/runtime/aw_info.json ]; then cp ${{ env.GH_AW_RUNTIME_ROOT }}/runtime/aw_info.json ${{ env.GH_AW_RUNTIME_ROOT }}/aw_info.json; fi
      - name: Download Safe Outputs Items Manifest
        id: download-safe-outputs-manifest
        if: always()
        continue-on-error: true
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: safe-outputs-items
          merge-multiple: true
          path: ${{ env.GH_AW_RUNTIME_ROOT }}/
      - name: Handle agent failure
        id: handle_agent_failure
        if: always()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_AGENT_OUTPUT: ${{ steps.setup-agent-output-env.outputs.GH_AW_AGENT_OUTPUT }}
          GH_AW_WORKFLOW_NAME: "Test Playwright CLI Mode"
          GH_AW_RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          GH_AW_AGENT_CONCLUSION: ${{ needs.agent.result }}
          GH_AW_ACTIVATION_RESULT: ${{ needs.activation.result }}
          GH_AW_WORKFLOW_ID: "playwright-cli-mode"
          GH_AW_ENGINE_MODEL: ${{ needs.agent.outputs.model }}
          GH_AW_ENGINE_MODEL_EFFORT: ${{ needs.agent.outputs.model_effort }}
          GH_AW_MODEL_ROUTING_STATUS: ${{ needs.agent.outputs.model_routing_status }}
          GH_AW_ACTION_FAILURE_ISSUE_EXPIRES_HOURS: "12"
          GH_AW_ENGINE_ID: "copilot"
          GH_AW_SECRET_VERIFICATION_RESULT: ${{ needs.activation.outputs.secret_verification_result }}
          GH_AW_ENGINE_SECRET_FAILURE_MESSAGE: "**Alternative**: If your organization has a Copilot subscription, you can avoid the need for a personal access token by adding a top-level `permissions` block to your workflow file. This enables Copilot inference through the org using the built-in GitHub Actions token.\n\n```yaml\npermissions:\n  copilot-requests: write\n```\n\nSee: https://github.github.com/gh-aw/reference/engines/#github-copilot-default"
          GH_AW_CHECKOUT_PR_SUCCESS: ${{ needs.agent.outputs.checkout_pr_success }}
          GH_AW_CHECKOUT_PR_INVALIDATED: ${{ needs.agent.outputs.checkout_pr_invalidated }}
          GH_AW_AI_CREDITS_RATE_LIMIT_ERROR: ${{ needs.agent.outputs.ai_credits_rate_limit_error || 'false' }}
          GH_AW_UNKNOWN_MODEL_AI_CREDITS: ${{ needs.agent.outputs.unknown_model_ai_credits || 'false' }}
          GH_AW_AIC: ${{ needs.agent.outputs.aic }}
          GH_AW_MAX_AI_CREDITS: ${{ vars.GH_AW_DEFAULT_MAX_AI_CREDITS || '1000' }}
          GH_AW_DEFAULT_CHECKOUT_USES_TRIGGER_REF: "true"
          GH_AW_INFERENCE_ACCESS_ERROR: ${{ needs.agent.outputs.inference_access_error }}
          GH_AW_MCP_POLICY_ERROR: ${{ needs.agent.outputs.mcp_policy_error }}
          GH_AW_AGENTIC_ENGINE_TIMEOUT: ${{ needs.agent.outputs.agentic_engine_timeout }}
          GH_AW_MODEL_NOT_SUPPORTED_ERROR: ${{ needs.agent.outputs.model_not_supported_error }}
          GH_AW_MODEL_ENDPOINT_MISMATCH_ERROR: ${{ needs.agent.outputs.model_endpoint_mismatch_error }}
          GH_AW_HTTP_400_RESPONSE_ERROR: ${{ needs.agent.outputs.http_400_response_error }}
          GH_AW_MAX_CACHE_MISSES_EXCEEDED: ${{ needs.agent.outputs.max_cache_misses_exceeded }}
          GH_AW_MISSING_MODEL_PRICING_ERROR: ${{ needs.agent.outputs.missing_model_pricing_error }}
          GH_AW_MISSING_MODEL_PRICING_MODEL_NAME: ${{ needs.agent.outputs.missing_model_pricing_model_name }}
          GH_AW_SHELL_EXPANSION_GUARD_REJECTED: ${{ needs.agent.outputs.shell_expansion_guard_rejected }}
          GH_AW_ENGINE_API_HOSTS: "api.enterprise.githubcopilot.com,api.githubcopilot.com,api.business.githubcopilot.com,api.individual.githubcopilot.com"
          GH_AW_LOCKDOWN_CHECK_FAILED: ${{ needs.activation.outputs.lockdown_check_failed }}
          GH_AW_OAUTH_TOKEN_CHECK_FAILED: ${{ needs.activation.outputs.oauth_token_check_failed }}
          GH_AW_STALE_LOCK_FILE_FAILED: ${{ needs.activation.outputs.stale_lock_file_failed }}
          GH_AW_DAILY_AI_CREDITS_EXCEEDED: ${{ needs.activation.outputs.daily_ai_credits_exceeded }}
          GH_AW_DAILY_AI_CREDITS_GUARDRAIL_STATUS: ${{ needs.activation.outputs.daily_ai_credits_guardrail_status }}
          GH_AW_DAILY_AI_CREDITS_GUARDRAIL_ERROR: ${{ needs.activation.outputs.daily_ai_credits_guardrail_error }}
          GH_AW_DAILY_AI_CREDITS_TOTAL: ${{ needs.activation.outputs.daily_ai_credits_total }}
          GH_AW_DAILY_AI_CREDITS_ESTIMATED: ${{ needs.activation.outputs.daily_ai_credits_estimated }}
          GH_AW_DAILY_AI_CREDITS_THRESHOLD: ${{ needs.activation.outputs.daily_ai_credits_threshold }}
          GH_AW_DAILY_AI_CREDITS_CONTINUE_ON_ERROR: "false"
          GH_AW_GROUP_REPORTS: "false"
          GH_AW_FAILURE_REPORT_AS_ISSUE: "true"
          GH_AW_MISSING_TOOL_REPORT_AS_FAILURE: "true"
          GH_AW_MISSING_DATA_REPORT_AS_FAILURE: "true"
          GH_AW_TIMEOUT_MINUTES: "${{ fromJSON(vars.GH_AW_DEFAULT_TIMEOUT_MINUTES || '20') }}"
        with:
          github-token: ${{ secrets.GH_AW_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'handle_agent_failure.cjs'));
            await main();
      - name: Report failed jobs
        id: report_failed_jobs
        if: always()
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_AGENT_OUTPUT: ${{ steps.setup-agent-output-env.outputs.GH_AW_AGENT_OUTPUT }}
          GH_AW_WORKFLOW_NAME: "Test Playwright CLI Mode"
          GH_AW_RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          GH_AW_REPORT_FAILED_JOBS: "true"
        with:
          github-token: ${{ secrets.GH_AW_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'report_failed_jobs.cjs'));
            await main();
      - name: Collect usage artifact files
        if: always()
        continue-on-error: true
        run: bash "${GH_AW_SETUP_ROOT}/actions/collect_usage_artifact_files.sh"
      - name: Generate usage activity summary and unified session
        if: always()
        continue-on-error: true
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_GRADER_MANIFEST_0: '{"version":2,"graders":[]}'
          GH_AW_GRADER_MANIFEST_CHUNKS: '1'
          GH_AW_JOB_DURATIONS: ${{ steps.report_failed_jobs.outputs.job_durations }}
          GH_AW_DAILY_AI_CREDITS_GUARDRAIL_STATUS: ${{ needs.activation.outputs.daily_ai_credits_guardrail_status }}
          GH_AW_DAILY_AI_CREDITS_EXCEEDED: ${{ needs.activation.outputs.daily_ai_credits_exceeded }}
          GH_AW_DAILY_AI_CREDITS_TOTAL: ${{ needs.activation.outputs.daily_ai_credits_total }}
          GH_AW_DAILY_AI_CREDITS_ESTIMATED: ${{ needs.activation.outputs.daily_ai_credits_estimated }}
          GH_AW_DAILY_AI_CREDITS_THRESHOLD: ${{ needs.activation.outputs.daily_ai_credits_threshold }}
        with:
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit);
            const { main } = require(path.join(actionsDir, 'generate_usage_artifacts.cjs'));
            await main();
      - name: Upload usage artifact
        id: upload-usage-artifact
        if: always()
        continue-on-error: true
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: usage
          path: |
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/aw_session.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/aw_info.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/aw-info.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent_usage.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/graders/grader_manifest.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/graders/grader_results.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/github_rate_limits.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/token_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/model-routing.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/harness_retry.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/durable-session.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/token_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/harness_retry.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/detection_result.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals/token_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals/execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals/evals_status.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/experiment/state.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/experiment/state.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/experiment/assignments.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/activity/summary.json
          if-no-files-found: ignore
          retention-days: ${{ vars.GH_AW_DEFAULT_ARTIFACT_RETENTION_DAYS || '0' }}
      - name: Wait before retrying usage artifact upload
        if: always() && steps.upload-usage-artifact.outcome == 'failure'
        run: sleep 10
      - name: Retry upload usage artifact
        id: upload-usage-artifact-retry
        if: always() && steps.upload-usage-artifact.outcome == 'failure'
        continue-on-error: true
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: usage
          path: |
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/aw_session.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/aw_info.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/aw-info.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent_usage.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/graders/grader_manifest.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/graders/grader_results.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/github_rate_limits.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/token_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/model-routing.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/harness_retry.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/agent/durable-session.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/token_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/harness_retry.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/detection/detection_result.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals/token_usage.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals/execution.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/evals/evals_status.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/experiment/state.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/experiment/state.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/experiment/assignments.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/usage/activity/summary.json
          if-no-files-found: ignore
          overwrite: true
          retention-days: ${{ vars.GH_AW_DEFAULT_ARTIFACT_RETENTION_DAYS || '0' }}

      - name: Clean isolated runtime directories
        if: ${{ always() && env.GH_AW_SETUP_ACTION_COMPLETE != 'true' }}
        shell: bash
        run: |
          set -euo pipefail
          if [[ -z "${GH_AW_RUNTIME_ROOT:-}" || -z "${GH_AW_SETUP_ROOT:-}" || -z "${GH_AW_RUNTIME_TOKEN:-}" ]]; then exit 0; fi
          if [[ ! "$GH_AW_RUNTIME_ROOT" =~ ^/tmp/gh-aw-run\.[A-Za-z0-9]+$ ]]; then echo "::warning::Invalid runtime cleanup root"; exit 0; fi
          if [[ -z "${RUNNER_TEMP:-}" ]]; then exit 0; fi
          setup_parent="$(cd -- "$RUNNER_TEMP" && pwd -P)" || exit 0
          if [[ "${GH_AW_SETUP_ROOT%/*}" != "$setup_parent" || ! "${GH_AW_SETUP_ROOT##*/}" =~ ^gh-aw-setup\.[A-Za-z0-9]{10}$ ]]; then echo "::warning::Invalid setup cleanup root"; exit 0; fi
          owner_hash="$(printf '%s' "$GH_AW_RUNTIME_TOKEN" | sha256sum | cut -d ' ' -f1)" || exit 0
          for kind in runtime setup; do
            if [[ "$kind" == runtime ]]; then root="$GH_AW_RUNTIME_ROOT"; identity="${GH_AW_RUNTIME_ID:-}"; else root="$GH_AW_SETUP_ROOT"; identity="${GH_AW_SETUP_ID:-}"; fi
            if [[ ! -e "$root" && ! -L "$root" ]]; then continue; fi
            if [[ -L "$root" || ! -d "$root" || "$(stat -c '%d:%i' "$root")" != "$identity" || "$(stat -c '%u' "$root")" != "$(id -u)" || "$(stat -c '%a' "$root")" != 700 ]]; then echo "::warning::Refusing unowned runtime cleanup"; continue; fi
            marker="$root/.gh-aw-runtime-owner"
            if [[ -L "$marker" || ! -f "$marker" || "$(cat -- "$marker")" != "$owner_hash" ]]; then echo "::warning::Refusing runtime cleanup without ownership"; continue; fi
            rm -rf -- "$root" || echo "::warning::Could not fully remove isolated $kind directory"
          done
  safe_outputs:
    name: safe_outputs
    needs:
      - activation
      - agent
    if: (!cancelled()) && needs.agent.result != 'skipped'
    runs-on: ubuntu-slim
    # Permissions for the safe_outputs job (workflow permissions default to none).
    permissions:
      issues: write # Create or update issues and comments.
    timeout-minutes: 15
    env:
      GH_AW_AGENT_AIC: ${{ needs.agent.outputs.aic }}
      GH_AW_AIC: ${{ needs.agent.outputs.aic }}
      GH_AW_AMBIENT_CONTEXT: ${{ needs.agent.outputs.ambient_context }}
      GH_AW_CALLER_WORKFLOW_ID: "${{ github.repository }}/playwright-cli-mode"
      GH_AW_ENGINE_ID: "copilot"
      GH_AW_ENGINE_MODEL: ${{ needs.agent.outputs.model }}
      GH_AW_ENGINE_MODEL_EFFORT: ${{ needs.agent.outputs.model_effort }}
      GH_AW_MODEL_ROUTING_STATUS: ${{ needs.agent.outputs.model_routing_status }}
      GH_AW_OBJECT_PACK_FETCH_DEPTHS: ${{ vars.GH_AW_OBJECT_PACK_FETCH_DEPTHS }}
      GH_AW_OBJECT_PACK_MAX_BYTES: ${{ vars.GH_AW_OBJECT_PACK_MAX_BYTES }}
      GH_AW_OBJECT_PACK_MAX_OBJECTS: ${{ vars.GH_AW_OBJECT_PACK_MAX_OBJECTS }}
      GH_AW_OBJECT_PACK_TIMEOUT_MS: ${{ vars.GH_AW_OBJECT_PACK_TIMEOUT_MS }}
      GH_AW_RUNTIME_FEATURES: ${{ vars.GH_AW_RUNTIME_FEATURES }}
      GH_AW_WORKFLOW_ID: "playwright-cli-mode"
      GH_AW_WORKFLOW_NAME: "Test Playwright CLI Mode"
    outputs:
      code_push_failure_count: ${{ steps.process_safe_outputs.outputs.code_push_failure_count }}
      code_push_failure_errors: ${{ steps.process_safe_outputs.outputs.code_push_failure_errors }}
      create_discussion_error_count: ${{ steps.process_safe_outputs.outputs.create_discussion_error_count }}
      create_discussion_errors: ${{ steps.process_safe_outputs.outputs.create_discussion_errors }}
      created_issue_number: ${{ steps.process_safe_outputs.outputs.created_issue_number }}
      created_issue_url: ${{ steps.process_safe_outputs.outputs.created_issue_url }}
      process_safe_outputs_items_applied: ${{ steps.process_safe_outputs.outputs.items_applied }}
      process_safe_outputs_items_cancelled: ${{ steps.process_safe_outputs.outputs.items_cancelled }}
      process_safe_outputs_items_deferred: ${{ steps.process_safe_outputs.outputs.items_deferred }}
      process_safe_outputs_items_failed: ${{ steps.process_safe_outputs.outputs.items_failed }}
      process_safe_outputs_items_skipped: ${{ steps.process_safe_outputs.outputs.items_skipped }}
      process_safe_outputs_items_succeeded: ${{ steps.process_safe_outputs.outputs.items_succeeded }}
      process_safe_outputs_items_warnings: ${{ steps.process_safe_outputs.outputs.items_warnings }}
      process_safe_outputs_processed_count: ${{ steps.process_safe_outputs.outputs.processed_count }}
      process_safe_outputs_status: ${{ steps.process_safe_outputs.outputs.status }}
    steps:
      - name: Allocate isolated runtime directories
        id: gh-aw-runtime
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          GH_AW_RUNTIME_ROOT=""
          GH_AW_SETUP_ROOT=""
          trap 'status=$?; if [[ -n "$GH_AW_SETUP_ROOT" ]]; then rm -rf -- "$GH_AW_SETUP_ROOT"; fi; if [[ -n "$GH_AW_RUNTIME_ROOT" ]]; then rm -rf -- "$GH_AW_RUNTIME_ROOT"; fi; exit "$status"' EXIT
          GH_AW_RUNTIME_ROOT="$(mktemp -d /tmp/gh-aw-run.XXXXXXXXXX)"
          setup_parent="$(cd -- "${RUNNER_TEMP:?}" && pwd -P)"
          GH_AW_SETUP_ROOT="$(mktemp -d "$setup_parent/gh-aw-setup.XXXXXXXXXX")"
          GH_AW_RESOURCE_SUFFIX="${GH_AW_RUNTIME_ROOT##*/gh-aw-run.}"
          GH_AW_RUNTIME_TOKEN="$(openssl rand -hex 32)"
          printf '::add-mask::%s\n' "$GH_AW_RUNTIME_TOKEN"
          owner_hash="$(printf '%s' "$GH_AW_RUNTIME_TOKEN" | sha256sum | cut -d ' ' -f1)"
          printf '%s' "$owner_hash" > "$GH_AW_RUNTIME_ROOT/.gh-aw-runtime-owner"
          printf '%s' "$owner_hash" > "$GH_AW_SETUP_ROOT/.gh-aw-runtime-owner"
          case "$GH_AW_SETUP_ROOT" in *$'\n'*|*$'\r'*) echo "Invalid setup root" >&2; exit 1 ;; esac
          printf 'GH_AW_RUNTIME_ROOT=%s\nGH_AW_SETUP_ROOT=%s\nGH_AW_RESOURCE_SUFFIX=%s\nGH_AW_RUNTIME_TOKEN=%s\n' "$GH_AW_RUNTIME_ROOT" "$GH_AW_SETUP_ROOT" "$GH_AW_RESOURCE_SUFFIX" "$GH_AW_RUNTIME_TOKEN" >> "$GITHUB_ENV"
          printf 'GH_AW_RUNTIME_ID=%s\nGH_AW_SETUP_ID=%s\n' "$(stat -c '%d:%i' "$GH_AW_RUNTIME_ROOT")" "$(stat -c '%d:%i' "$GH_AW_SETUP_ROOT")" >> "$GITHUB_ENV"
          trap - EXIT
      - name: Checkout actions folder
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: github/gh-aw
          sparse-checkout: |
            actions
          fetch-depth: 1
          clean: false
          persist-credentials: false
      - name: Setup Scripts
        id: setup
        uses: ./actions/setup
        with:
          destination: ${{ env.GH_AW_SETUP_ROOT }}/actions
          job-name: ${{ github.job }}
          trace-id: ${{ needs.activation.outputs.setup-trace-id }}
          parent-span-id: ${{ needs.activation.outputs.setup-parent-span-id || needs.activation.outputs.setup-span-id }}
        env:
          GH_AW_SETUP_WORKFLOW_NAME: "Test Playwright CLI Mode"
          GH_AW_CURRENT_WORKFLOW_REF: ${{ github.repository }}/.github/workflows/playwright-cli-mode.lock.yml@${{ github.ref }}
          GH_AW_INFO_VERSION: "COPILOT_VERSION"
          GH_AW_INFO_AWF_VERSION: "vAWF_VERSION"
          GH_AW_INFO_ENGINE_ID: "copilot"
          GH_AW_SETUP_AW_CONTEXT: ${{ inputs.aw_context }}
      - name: Mask OTLP telemetry headers
        run: bash "${GH_AW_SETUP_ROOT}/actions/mask_otlp_headers.sh"
      - name: Download agent output artifact
        id: download-agent-output
        continue-on-error: true
        uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: "{agent,agent-output-fallback}"
          merge-multiple: true
          path: ${{ env.GH_AW_RUNTIME_ROOT }}/
      - name: Setup agent output environment variable
        id: setup-agent-output-env
        if: steps.download-agent-output.outcome == 'success'
        run: |
          mkdir -p ${{ env.GH_AW_RUNTIME_ROOT }}/
          find "${{ env.GH_AW_RUNTIME_ROOT }}/" -type f -print
          if [ -f "${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json" ]; then
            echo "GH_AW_AGENT_OUTPUT=${{ env.GH_AW_RUNTIME_ROOT }}/agent_output.json" >> "$GITHUB_OUTPUT"
          fi
      - name: Configure GH_HOST for enterprise compatibility
        id: ghes-host-config
        shell: bash
        run: | # zizmor: ignore[github-env] - GITHUB_SERVER_URL is set by GitHub Actions, not user input.
          # Derive GH_HOST from GITHUB_SERVER_URL so the gh CLI targets the correct
          # GitHub instance (GHES/GHEC). On github.com this is a harmless no-op.
          GH_HOST="${GITHUB_SERVER_URL#https://}"
          GH_HOST="${GH_HOST#http://}"
          echo "GH_HOST=${GH_HOST}" >> "$GITHUB_ENV"
      - name: Process Safe Outputs
        id: process_safe_outputs
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        env:
          GH_AW_JOB_CHECK_RUN_ID: ${{ job.check_run_id }}
          GH_AW_AGENT_OUTPUT: ${{ steps.setup-agent-output-env.outputs.GH_AW_AGENT_OUTPUT }}
          GH_AW_COMMENT_ID: ${{ needs.activation.outputs.comment_id }}
          GH_AW_MENTIONS_GITHUB_TOKEN: ${{ github.token }}
          GH_AW_ALLOWED_DOMAINS: "archive.ubuntu.com,azure.archive.ubuntu.com,cdn.playwright.dev,crl.geotrust.com,crl.globalsign.com,crl.identrust.com,crl.sectigo.com,crl.thawte.com,crl.usertrust.com,crl.verisign.com,crl3.digicert.com,crl4.digicert.com,crls.ssl.com,json-schema.org,json.schemastore.org,keyserver.ubuntu.com,ocsp.digicert.com,ocsp.geotrust.com,ocsp.globalsign.com,ocsp.identrust.com,ocsp.sectigo.com,ocsp.ssl.com,ocsp.thawte.com,ocsp.usertrust.com,ocsp.verisign.com,playwright.download.prss.microsoft.com,s.symcb.com,s.symcd.com,security.ubuntu.com,ts-crl.ws.symantec.com,ts-ocsp.ws.symantec.com"
          GITHUB_SERVER_URL: ${{ github.server_url }}
          GITHUB_API_URL: ${{ github.api_url }}
          GH_AW_SAFE_OUTPUTS_HANDLER_CONFIG: "{\"create_issue\":{\"labels\":[\"playwright-cli-mode\"],\"max\":1,\"max_issue_artifact_size\":1048576,\"max_issue_artifacts\":10,\"title_prefix\":\"[playwright-cli-mode]\"}}"
          GH_AW_GITHUB_TOKEN_SOURCE: ${{ secrets.GH_AW_GITHUB_TOKEN != '' && 'pat' || 'github_actions' }}
        with:
          github-token: ${{ secrets.GH_AW_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}
          script: |
            const path = require('path');
            const actionsDir = path.join(process.env.GH_AW_SETUP_ROOT, 'actions');
            const { setupGlobals } = require(path.join(actionsDir, 'setup_globals.cjs'));
            setupGlobals(core, github, context, exec, io, getOctokit, process.env.GH_AW_GITHUB_TOKEN_SOURCE);
            const { main } = require(path.join(actionsDir, 'process_safe_outputs.cjs'));
            await main();
      - name: Upload Safe Outputs Items
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: safe-outputs-items
          path: |
            ${{ env.GH_AW_RUNTIME_ROOT }}/safe-output-items.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/safe-output-executions.jsonl
            ${{ env.GH_AW_RUNTIME_ROOT }}/temporary-id-map.json
            ${{ env.GH_AW_RUNTIME_ROOT }}/safe-output-errors.json
          if-no-files-found: ignore
          retention-days: ${{ vars.GH_AW_DEFAULT_ARTIFACT_RETENTION_DAYS || '0' }}

      - name: Clean isolated runtime directories
        if: ${{ always() && env.GH_AW_SETUP_ACTION_COMPLETE != 'true' }}
        shell: bash
        run: |
          set -euo pipefail
          if [[ -z "${GH_AW_RUNTIME_ROOT:-}" || -z "${GH_AW_SETUP_ROOT:-}" || -z "${GH_AW_RUNTIME_TOKEN:-}" ]]; then exit 0; fi
          if [[ ! "$GH_AW_RUNTIME_ROOT" =~ ^/tmp/gh-aw-run\.[A-Za-z0-9]+$ ]]; then echo "::warning::Invalid runtime cleanup root"; exit 0; fi
          if [[ -z "${RUNNER_TEMP:-}" ]]; then exit 0; fi
          setup_parent="$(cd -- "$RUNNER_TEMP" && pwd -P)" || exit 0
          if [[ "${GH_AW_SETUP_ROOT%/*}" != "$setup_parent" || ! "${GH_AW_SETUP_ROOT##*/}" =~ ^gh-aw-setup\.[A-Za-z0-9]{10}$ ]]; then echo "::warning::Invalid setup cleanup root"; exit 0; fi
          owner_hash="$(printf '%s' "$GH_AW_RUNTIME_TOKEN" | sha256sum | cut -d ' ' -f1)" || exit 0
          for kind in runtime setup; do
            if [[ "$kind" == runtime ]]; then root="$GH_AW_RUNTIME_ROOT"; identity="${GH_AW_RUNTIME_ID:-}"; else root="$GH_AW_SETUP_ROOT"; identity="${GH_AW_SETUP_ID:-}"; fi
            if [[ ! -e "$root" && ! -L "$root" ]]; then continue; fi
            if [[ -L "$root" || ! -d "$root" || "$(stat -c '%d:%i' "$root")" != "$identity" || "$(stat -c '%u' "$root")" != "$(id -u)" || "$(stat -c '%a' "$root")" != 700 ]]; then echo "::warning::Refusing unowned runtime cleanup"; continue; fi
            marker="$root/.gh-aw-runtime-owner"
            if [[ -L "$marker" || ! -f "$marker" || "$(cat -- "$marker")" != "$owner_hash" ]]; then echo "::warning::Refusing runtime cleanup without ownership"; continue; fi
            rm -rf -- "$root" || echo "::warning::Could not fully remove isolated $kind directory"
          done
