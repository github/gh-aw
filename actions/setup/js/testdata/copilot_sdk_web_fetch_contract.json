{
  "serverArgs": ["--disable-builtin-mcps", "--no-ask-user", "--allow-tool", "web_fetch", "--deny-tool", "workflow"],
  "toolConfig": {
    "version": 1,
    "capabilities": {
      "bash": false,
      "edit": false,
      "webFetch": true,
      "webSearch": false,
      "dynamicWorkflows": false,
      "mcp": false,
      "cliProxy": false
    },
    "permissions": {
      "allowedTools": ["read", "web_fetch"]
    },
    "explicitlyDisabledTools": ["bash", "cli-proxy", "edit", "github"]
  }
}
