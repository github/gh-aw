# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:lts-alpine
FROM ${NODE_IMAGE}

ARG NODE_IMAGE
ARG NODE_IMAGE_DIGEST=""
ARG NODE_IMAGE_UPDATED_AT=""
ARG DOCKERFILE_HASH=""
ARG NPM_VERSION=11.19.0

# Intentional: upgrade all packages to pick up security fixes; downstream digest pins the result.
# After upgrading npm, patch its bundled dependencies to meet minimum safe versions.
# Install into a temp prefix (avoids npm's own private package.json) then replace the package
# directories in npm's bundled node_modules: brace-expansion >= 5.0.11 (GHSA-qhr7-859c-m2p7),
# ip-address >= 10.3.1 (GHSA-mwp4-54f8-5fhr), tar >= 7.5.22, and undici >= 6.29.1
# (GHSA-xjj6-f33q-929c). Each replaced package is loaded by absolute path to verify the patch:
# the globally installed npm tree is not on Node's default resolution path, so a bare
# require("<pkg>") would always fail with MODULE_NOT_FOUND and break the build.
RUN apk upgrade --no-cache \
    && apk add --no-cache git "brotli-libs>=1.2.1-r0" \
    && apk info -v | sort \
    && npm install --global "npm@${NPM_VERSION}" \
    && tmpdir=$(mktemp -d) \
    && npm --prefix "$tmpdir" install --no-save "tar@^7.5.22" "brace-expansion@^5.0.11" "ip-address@^10.3.1" "undici@^6.29.1" \
    && npm_modules="$(npm root -g)/npm/node_modules" \
    && for pkg in brace-expansion ip-address tar undici; do \
         rm -rf "$npm_modules/$pkg" || exit 1; \
         cp -r "$tmpdir/node_modules/$pkg" "$npm_modules/$pkg" || exit 1; \
         node -e 'const dir = process.argv[1]; require(dir); console.log(dir + " -> " + require(dir + "/package.json").version)' "$npm_modules/$pkg" || exit 1; \
       done \
    && rm -rf "$tmpdir" \
    && npm cache clean --force

LABEL org.opencontainers.image.source="https://github.com/github/gh-aw" \
      org.opencontainers.image.description="Node LTS Alpine with git for the local safe-outputs MCP runtime" \
      org.opencontainers.image.base.name="${NODE_IMAGE}" \
      org.opencontainers.image.base.digest="${NODE_IMAGE_DIGEST}" \
      io.github.gh-aw.safe-outputs.node.updated-at="${NODE_IMAGE_UPDATED_AT}" \
      io.github.gh-aw.safe-outputs.npm.version="${NPM_VERSION}" \
      io.github.gh-aw.safe-outputs.dockerfile-hash="${DOCKERFILE_HASH}"

ENTRYPOINT ["sh", "-lc", "node \"${GITHUB_WORKSPACE:-$PWD}/actions/setup/js/safe_outputs_mcp_server.cjs\""]
