    { "name": "grants-paused", "operations": 256, "ledger_bytes": 100, "ledger_limit": 1000, "grants_paused": true, "requested": 128, "expected": 0 },
    { "name": "zero-and-paused", "operations": 3, "ledger_bytes": 1000, "ledger_limit": 1000, "grants_paused": true, "requested": 0, "expected": 0 },
